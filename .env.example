# LuckyBlox environment configuration (example).
# Copy to .env for local runs, or set these in the Render dashboard.
# Nothing here is required locally — the defaults keep the desktop workflow.

# --- Public port -------------------------------------------------------------
# Render injects PORT automatically. Set a value only for local/Docker runs.
PORT=3002

# --- Network binding ---------------------------------------------------------
# Bind on every interface so the container is reachable from the internet.
HOST=0.0.0.0

# --- Internal bridge (Express app) -------------------------------------------
LUCKYBLOX_BRIDGE_HOST=127.0.0.1
LUCKYBLOX_BRIDGE_PORT=3001

# --- Game servers ------------------------------------------------------------
LUCKYBLOX_GAME_HOST=0.0.0.0
LUCKYBLOX_GAME_PORT=53640

# --- Public routing ----------------------------------------------------------
# On Render these are auto-detected from RENDER_EXTERNAL_URL /
# RENDER_EXTERNAL_HOSTNAME. Override only for a custom domain.
# PUBLIC_URL=https://luckyblox-server.onrender.com
# PUBLIC_HOST=luckyblox-server.onrender.com
# PUBLIC_PROTOCOL=https

# --- Secrets / tooling -------------------------------------------------------
# LUCKBLOX_SECRET=change-me-in-production
# PHP_BIN=php
# NODE_BIN=node
