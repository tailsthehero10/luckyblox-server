# LuckyBlox environment configuration (example).
# Copy to .env for local runs, or set these in the Render dashboard.
# Nothing here is required locally — the defaults keep the desktop workflow.

# --- Public port -------------------------------------------------------------
# Render injects PORT automatically. Set a value only for local/Docker runs.
PORT=3002

# --- Network binding ---------------------------------------------------------
# Bind on every interface so the container is reachable from the internet.
HOST=0.0.0.0

# --- Internal bridge (Express app) -------------------------------------------
LUCKYBLOX_BRIDGE_HOST=127.0.0.1
LUCKYBLOX_BRIDGE_PORT=3001

# --- Game servers ------------------------------------------------------------
LUCKYBLOX_GAME_HOST=0.0.0.0
LUCKYBLOX_GAME_PORT=53640

# --- Public routing ----------------------------------------------------------
# On Render these are auto-detected from RENDER_EXTERNAL_URL /
# RENDER_EXTERNAL_HOSTNAME. Override only for a custom domain.
# PUBLIC_URL=https://luckyblox-server.onrender.com
# PUBLIC_HOST=luckyblox-server.onrender.com
# PUBLIC_PROTOCOL=https

# --- Live preview mode -------------------------------------------------------
# "off" (the default) serves the real site and all client endpoints. Set to "on"
# only to show the placeholder page while the build is unfinished.
LUCKYBLOX_PREVIEW_MODE=off
LUCKYBLOX_PREVIEW_STAGE=In development

# --- Secrets / tooling -------------------------------------------------------
# LUCKBLOX_SECRET=change-me-in-production
# PHP_BIN=php
# NODE_BIN=node
# --- Owner account + persistence ---------------------------------------------
# The owner password is hashed and applied to the owner account at boot, so it
# survives redeploys and is never committed. Set it on the host (Render
# dashboard -> Environment).
# LUCKYBLOX_OWNER_ID=1
# LUCKYBLOX_OWNER_USERNAME=tailsthehero10
# LUCKYBLOX_OWNER_PASSWORD=
# Point this at a persistent volume so accounts are not wiped on redeploy.
# REQUIRES A PAID DISK - if you have no budget, use LUCKYBLOX_SYNC below instead.
# LUCKYBLOX_DATA_DIR=/var/data

# --- FREE persistence (no disk needed) ---------------------------------------
# A host with no persistent disk wipes the filesystem on every deploy, losing
# accounts/games. To keep them for free, mirror the data files to a free store.
# See server/remoteStore.js. With none of this set, nothing changes.
#
# Backend A - GitHub repo (free; the data repo is PRIVATE because it holds
# password hashes; create a fine-grained token with Contents: Read+Write):
# LUCKYBLOX_SYNC=github
# LUCKYBLOX_SYNC_TOKEN=github_pat_xxx
# The repo defaults to tailsthehero10/Luckyblox-Storage-1; override if needed:
# LUCKYBLOX_SYNC_REPO=tailsthehero10/Luckyblox-Storage-1
# LUCKYBLOX_SYNC_BRANCH=main
# LUCKYBLOX_SYNC_PATH=data
#
# Backend B - any HTTP JSON blob store (Upstash / JSONBin / your own worker):
# LUCKYBLOX_SYNC=http
# LUCKYBLOX_SYNC_URL=https://api.jsonbin.io/v3/b/xxxxxxxx
# LUCKYBLOX_SYNC_TOKEN=optional-bearer-token
#
# Backend C - a LOCAL git clone of the storage repo. No token, no network, no cost:
# the server writes straight into a sibling checkout and commits there with git.
# Use this when the server runs on the same machine as the clone. Push the clone
# (git -C <dir> push) when you want the copy off the machine.
# Defaults to <release>/../Luckyblox-Storage-1 when LUCKYBLOX_SYNC_DIR is unset.
# LUCKYBLOX_SYNC=local
# LUCKYBLOX_SYNC_DIR=E:\LuckyBloxLauncher\NEW LKL\Release\Luckyblox-Storage-1
#
# Content folders (place files, maps, settings) are NOT synced by default -
# only the JSON index is. Set this to also mirror them (can be large):
# LUCKYBLOX_SYNC_CONTENT=0
