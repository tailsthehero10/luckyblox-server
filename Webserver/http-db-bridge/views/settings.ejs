<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/refresh-2021.css" />
  <link rel="stylesheet" href="/css/roblox-ui.css" />
  <link rel="stylesheet" href="/css/lb-select.css" />
  <link rel="stylesheet" href="/css/settings.css" />
</head>
<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'account' }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'account' }) %>

      <div class="lb-main">
    <!--
      A real settings WINDOW: the left list switches which panel is shown, one at
      a time (the old version was four stacked cards with anchor links).

      Avatar-only controls (rig R6/R15, gender, body colours, scales) deliberately
      live on the Avatar page - see /avatar. Settings points there instead of
      duplicating them, so there is exactly one place to change an avatar.
    -->
    <div class="settings-window">
      <%
        // The four sections the SERVER knows about, so the nav can never link to a
        // path that has no route. Aliases (security, password) are filtered out of
        // the nav - they are accepted URLs, not separate tabs.
        var navSections = (typeof settingsSections !== 'undefined' && settingsSections)
          ? settingsSections.filter(function (s) { return !s.aliasOf; })
          : [
            { slug: 'profile', label: 'Profile' },
            { slug: 'appearance', label: 'Appearance' },
            { slug: 'privacy', label: 'Privacy' },
            { slug: 'account', label: 'Account' },
          ];
        var currentSection = (typeof activeSection !== 'undefined' && activeSection)
          ? activeSection : 'profile';
      %>
      <%# Real PATHS, not `#hash` links.

          The hash form was the bug: `href="#account"` never reaches the server, so
          /settings/account 404'd, a refresh always landed back on Profile, the
          browser Back button did nothing, and a shared link opened the wrong tab.
          These resolve to /settings/<section>, which the server routes.

          data-panel stays, because the in-page script still switches instantly
          once the page is loaded - it just writes a real path now. %>
      <aside class="settings-sidebar" role="tablist" aria-label="Settings sections">
        <div class="settings-sidebar-title">Settings</div>
        <% navSections.forEach(function (s) { %>
        <a href="/settings/<%= s.slug %>"
           class="settings-nav-link<%= s.slug === currentSection ? ' is-active' : '' %>"
           role="tab"
           aria-selected="<%= s.slug === currentSection ? 'true' : 'false' %>"
           data-panel="<%= s.slug %>"><%= s.label %></a>
        <% }); %>
      </aside>

      <main class="settings-main">
        <div class="settings-head">
          <h1>Settings</h1>
          <p class="settings-sub">Manage your LuckyBlox account, profile and appearance.</p>
        </div>

        <div class="settings-status" id="settingsStatus" role="status" aria-live="polite" hidden></div>

        <form id="settingsForm">
          <!-- Profile -->
          <%# `hidden` is set from the SERVER's activeSection, not hardcoded to
              Profile. A direct visit to /settings/privacy has to render the Privacy
              panel on first paint - if the server always marks Profile visible, the
              right URL still shows the wrong panel until JavaScript runs, and shows
              it forever if JavaScript fails. %>
          <section class="settings-panel" id="panel-profile" role="tabpanel"
                   <%= currentSection === 'profile' ? '' : 'hidden' %>>
            <div class="roblox-panel">
              <div class="roblox-panel-header">
                <img class="ch-ico ch-ico-sm" src="/icons/profile.svg" alt="" /> Profile
              </div>
              <div class="roblox-panel-body">
                <div class="settings-row">
                  <label class="settings-label" for="username">Username</label>
                  <div class="settings-field">
                    <input id="username" type="text" value="<%= user.username %>" disabled />
                    <div class="settings-help">Your username is permanent and is how others find you.</div>
                  </div>
                </div>

                <div class="settings-row">
                  <label class="settings-label" for="setDisplayName">Display name</label>
                  <div class="settings-field">
                    <input id="setDisplayName" name="displayName" type="text" maxlength="35"
                           value="<%= user.displayName || user.username %>" placeholder="Display name" />
                    <div class="settings-help">Shown across LuckyBlox. Defaults to your username.</div>
                  </div>
                </div>

                <div class="settings-row">
                  <label class="settings-label" for="setBio">About</label>
                  <div class="settings-field">
                    <textarea id="setBio" name="bio" maxlength="500" rows="3" placeholder="Tell people about yourself"><%= user.bio || '' %></textarea>
                  </div>
                </div>

                <div class="settings-row">
                  <label class="settings-label" for="setEmail">Email</label>
                  <div class="settings-field">
                    <input id="setEmail" name="email" type="email" maxlength="120"
                           value="<%= user.email || '' %>" placeholder="you@example.com" />
                    <div class="settings-help">Used for account recovery only.</div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Appearance -->
          <section class="settings-panel" id="panel-appearance" role="tabpanel"
                   <%= currentSection === 'appearance' ? '' : 'hidden' %>>
            <div class="roblox-panel">
              <div class="roblox-panel-header">
                <img class="ch-ico ch-ico-sm" src="/icons/palette.svg" alt="" /> Appearance
              </div>
              <div class="roblox-panel-body">
                <div class="settings-row">
                  <label class="settings-label" for="setTheme">Theme</label>
                  <div class="settings-field">
                    <select class="lb-select" id="setTheme" name="theme">
                      <option value="light" <%= (user.theme || 'light') === 'light' ? 'selected' : '' %>>Light</option>
                      <option value="dark" <%= user.theme === 'dark' ? 'selected' : '' %>>Dark</option>
                    </select>
                    <div class="settings-help">Applies to your profile and settings pages.</div>
                  </div>
                </div>

                <!-- Avatar controls are NOT duplicated here. The Avatar page owns
                     rig, body colours, scales and the outfit. -->
                <div class="settings-row">
                  <span class="settings-label">Avatar</span>
                  <div class="settings-field">
                    <div class="settings-pointer">
                      <img class="ch-ico ch-ico-sm" src="/icons/avatar.svg" alt="" />
                      <span>Your character, rig and outfit are managed on the
                        <a href="/avatar?userId=<%= user.userId %>">Avatar page</a>.</span>
                    </div>
                    <div class="settings-help">
                      Current rig: <strong><%= (user.avatar && user.avatar.playerAvatarType) || 'R15' %></strong>
                      &middot; wearing <%= Array.isArray(user.currentlyWearing) ? user.currentlyWearing.length : 0 %> item(s).
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Privacy -->
          <section class="settings-panel" id="panel-privacy" role="tabpanel"
                   <%= currentSection === 'privacy' ? '' : 'hidden' %>>
            <div class="roblox-panel">
              <div class="roblox-panel-header">
                <img class="ch-ico ch-ico-sm" src="/icons/lock.svg" alt="" /> Privacy
              </div>
              <div class="roblox-panel-body">
                <div class="settings-row">
                  <label class="settings-label" for="setAboutMe">Who can see my activity</label>
                  <div class="settings-field">
                    <select class="lb-select" id="setAboutMe" name="aboutMe">
                      <option value="everyone" <%= (user.aboutMe || 'everyone') === 'everyone' ? 'selected' : '' %>>Everyone</option>
                      <option value="friends" <%= user.aboutMe === 'friends' ? 'selected' : '' %>>Friends</option>
                      <option value="nobody" <%= user.aboutMe === 'nobody' ? 'selected' : '' %>>Nobody</option>
                    </select>
                    <div class="settings-help">Controls who can see your recent experiences and creations.</div>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- Account -->
          <section class="settings-panel" id="panel-account" role="tabpanel"
                   <%= currentSection === 'account' ? '' : 'hidden' %>>
            <div class="roblox-panel">
              <div class="roblox-panel-header">
                <img class="ch-ico ch-ico-sm" src="/icons/settings.svg" alt="" /> Account
              </div>
              <div class="roblox-panel-body">
                <div class="settings-summary">
                  <div class="settings-summary-item"><span>User ID</span><strong><%= user.userId %></strong></div>
                  <div class="settings-summary-item"><span>Membership</span><strong><%= user.membershipStatus || user.membership || 'None' %></strong></div>
                  <div class="settings-summary-item"><span>Joined</span><strong><%= (user.joinDate || '').slice(0, 10) %></strong></div>
                  <div class="settings-summary-item"><span>Robux</span><strong><%= (currency && currency.robux) || user.robux || 0 %></strong></div>
                </div>
                <div class="settings-actions">
                  <a class="settings-btn secondary" href="/logout">
                    <img class="ch-ico" src="/icons/back.svg" alt="" /> Sign out
                  </a>
                </div>
              </div>
            </div>
          </section>

          <div class="settings-actions">
            <button type="submit" class="settings-btn primary" id="settingsSave">Save changes</button>
            <a class="settings-btn secondary" href="/profile?userId=<%= user.userId %>">
              <img class="ch-ico" src="/icons/profile.svg" alt="" /> View profile
            </a>
          </div>
        </form>
      </main>
    </div>
  </div>
  </div>
  </div>

  <%# The closing tags above balance everything opened at the top:

        lb-page         (16)  .lb-shell (19)  .lb-main (22)  .settings-window (31)
        settings-main   (44, closed by </main>)

      Four divs open, so four </div> are needed. There were only three, and the
      browser silently supplied the fourth when it reached </body> - which is why
      nothing errored and the page still LOOKED right while the DOM was one level
      shallower than the markup intended. That class of bug (an unclosed element
      re-nesting every later panel) is the one the project notes call a "glitch".

      One closer per line, in the reverse order they were opened, so the pairing is
      readable by eye. %>

  <%# The shared page scripts (loading.js + legacy-nav.js + lb-select.js). This page
      used to ship <script src="/lb-select.js"> by hand and nothing else, so
      LBLoading and the legacy image spinner were undefined here while every other
      page had them - the loader markup had no code behind it. Included ABOVE the
      inline script below, which reads window.LBLoading. %>
  <%- include('partials/scripts') %>
  <script>
    (function () {
      'use strict';

      // --- Theme: apply the saved theme immediately, site-wide via a body class.
      var root = document.documentElement;
      // `<%- %>` (unescaped) is REQUIRED here. With `<%= %>` EJS HTML-escapes the
      // quotes, so the browser received `var savedTheme = &#34;light&#34;;` - a syntax
      // error that killed this whole IIFE. showPanel was never defined and no
      // click handler was attached, so the tabs did nothing (the URL hash still
      // changed, because that is the anchor's own default behaviour and it made
      // the control LOOK wired).
      //
      // The value is JSON.stringify'd, which escapes quotes and backslashes for a
      // JS string context, and this is the page's own stored theme - so emitting
      // it raw is safe as well as necessary.
      var savedTheme = <%- JSON.stringify(user.theme || 'light') %>;
      function applyTheme(theme) {
        root.classList.toggle('theme-dark', theme === 'dark');
        document.body.classList.toggle('theme-dark', theme === 'dark');
      }
      applyTheme(savedTheme);

      // --- The section list SWITCHES the visible panel (one window at a time),
      // which is what a settings window does.
      var links = document.querySelectorAll('.settings-nav-link');
      var panels = document.querySelectorAll('.settings-panel');

      // The base path, from the server, so this is not hardcoded here.
      var BASE = <%- JSON.stringify(typeof basePath !== 'undefined' && basePath ? basePath : '/settings') %>;

      /**
       * Show one panel and put the section in the URL as a REAL PATH.
       *
       * This used to write `'#' + key`. A hash never reaches the server, so:
       *   - /settings/account had no route and 404'd;
       *   - refresh always came back to Profile;
       *   - Back did nothing (replaceState adds no history entry);
       *   - a shared link opened the wrong tab.
       *
       * `history.pushState` with a real path fixes all four: Back walks the
       * sections, a refresh requests the right URL, and the server now renders the
       * matching panel (see the activeSection local).
       */
      function showPanel(key, push) {
        panels.forEach(function (panel) {
          panel.hidden = panel.id !== ('panel-' + key);
        });
        links.forEach(function (l) {
          var on = l.getAttribute('data-panel') === key;
          l.classList.toggle('is-active', on);
          l.setAttribute('aria-selected', on ? 'true' : 'false');
        });

        var url = BASE + '/' + key;
        if (window.location.pathname !== url) {
          // pushState for a deliberate click (so Back returns to the previous
          // section); replaceState for the initial sync (so the first paint does
          // not add a bogus history entry).
          var method = push ? 'pushState' : 'replaceState';
          if (window.history && window.history[method]) {
            window.history[method]({ section: key }, '', url);
          }
        }
      }

      links.forEach(function (link) {
        link.addEventListener('click', function (e) {
          // A real navigation would reload the page for each tab. Intercept it and
          // switch in place, then push a REAL path so Back, refresh and sharing
          // all still work - the anchor's href is the fallback for no-JS.
          e.preventDefault();
          showPanel(link.getAttribute('data-panel'), true);
        });
      });

      // The browser's Back/Forward buttons move between sections without a reload,
      // so the panel has to follow the URL. Without this, Back changed the address
      // bar and left the wrong panel on screen.
      window.addEventListener('popstate', function () {
        var path = String(window.location.pathname || '');
        var slug = path.indexOf(BASE + '/') === 0 ? path.slice((BASE + '/').length) : 'profile';
        showPanel(isKnown(slug) ? slug : 'profile', false);
      });

      function isKnown(slug) {
        return Array.prototype.some.call(links, function (l) {
          return l.getAttribute('data-panel') === slug;
        });
      }

      /**
       * Open the section the URL asks for.
       *
       * The path is the source of truth (/settings/privacy). A legacy `#hash` on an
       * old bookmark is honoured too, so a link saved before this change still
       * works, and is then rewritten to the real path.
       *
       * The initial call uses replaceState, NOT pushState: the server already
       * rendered the right panel, so pushing here would add a duplicate history
       * entry identical to the current one - the user would press Back and appear
       * to stay put.
       */
      (function initialPanel() {
        var path = String(window.location.pathname || '');
        var fromPath = path.indexOf(BASE + '/') === 0 ? path.slice((BASE + '/').length) : '';
        var fromHash = String(window.location.hash || '').replace('#', '');

        var wanted = isKnown(fromPath) ? fromPath : (isKnown(fromHash) ? fromHash : 'profile');
        showPanel(wanted, false);
      }());

      var status = document.getElementById('settingsStatus');
      var saveBtn = document.getElementById('settingsSave');
      var form = document.getElementById('settingsForm');

      function showStatus(message, isError) {
        status.hidden = false;
        status.textContent = message;
        status.classList.toggle('is-error', !!isError);
        status.classList.toggle('is-ok', !isError);
      }

      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        var payload = {
          displayName: document.getElementById('setDisplayName').value,
          bio: document.getElementById('setBio').value,
          email: document.getElementById('setEmail').value,
          theme: document.getElementById('setTheme').value,
          aboutMe: document.getElementById('setAboutMe').value,
        };

        try {
          var response = await fetch('/api/settings', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload),
          });
          var data = await response.json();
          if (!response.ok || !data.ok) {
            throw new Error((data && data.message) || 'Could not save your settings.');
          }
          applyTheme(data.user.theme || 'light');
          showStatus('Your settings have been saved.', false);
        } catch (error) {
          showStatus(error.message || 'Could not save your settings.', true);
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save changes';
        }
      });

      // Live preview when the theme dropdown changes, before saving.
      var themeSelect = document.getElementById('setTheme');
      if (themeSelect) {
        themeSelect.addEventListener('change', function () { applyTheme(themeSelect.value); });
      }
    }());
  </script>
</body>
</html>
