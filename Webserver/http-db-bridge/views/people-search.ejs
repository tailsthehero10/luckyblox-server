<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/refresh-2021.css" />
  <link rel="stylesheet" href="/css/roblox-ui.css" />
</head>
<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'profile' }) %>
    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'profile' }) %>
      <main class="lb-main">
        <section class="lb-panel">
          <div class="lb-panel-header"><span>People</span></div>
          <div class="lb-panel-body">
            <form class="lb-search-form" method="GET" action="/search">
              <input type="hidden" name="scope" value="people" />
              <input class="lb-search-input" type="search" name="q" value="<%= keyword %>"
                     placeholder="Search by username or display name" aria-label="Search people" />
              <button class="lb-btn lb-btn-primary" type="submit">Search</button>
            </form>
            <% if (keyword) { %>
              <p class="lb-faint"><%= totalResults %> result<%= totalResults === 1 ? '' : 's' %> for &ldquo;<%= keyword %>&rdquo;</p>
            <% } else { %>
              <p class="lb-faint">Search accounts by username or display name.</p>
            <% } %>
          </div>
        </section>

        <% if (people.length) { %>
          <section class="lb-panel">
            <div class="lb-panel-body">
              <div class="lb-asset-list">
                <% people.forEach(function (person) { %>
                  <a class="lb-asset-item" href="/users/<%= person.userId %>/profile">
                    <div class="lb-asset-icon" aria-hidden="true"><%- lbAvatarFigure(person, 40) %></div>
                    <div>
                      <div class="lb-asset-name"><%= person.displayName || person.username %></div>
                      <div class="lb-asset-type">@<%= person.username %> &middot; ID <%= person.userId %></div>
                    </div>
                    <span class="lb-asset-tag">View profile</span>
                  </a>
                <% }); %>
              </div>
              <% if (totalResults > people.length) { %>
                <p class="lb-faint">Showing the first <%= people.length %> matches. Refine your search to see more.</p>
              <% } %>
            </div>
          </section>
        <% } else if (keyword) { %>
          <section class="lb-panel">
            <div class="lb-panel-body">
              <p class="lb-muted">No people matched &ldquo;<%= keyword %>&rdquo;. Check the spelling or try another name.</p>
            </div>
          </section>
        <% } %>
      </main>
    </div>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
