<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/roblox.css" />
</head>
<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'account' }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'account' }) %>

      <main class="lb-main">
    <section class="roblox-profile-hero">
      <div class="roblox-avatar-poster">
        <div class="roblox-avatar-big"><%= user.username.slice(0, 1).toUpperCase() %></div>
      </div>
      <div>
        <div class="roblox-eyebrow">Account</div>
        <div class="roblox-profile-title">
          <%= user.username %>
          <% if (typeof adminBadge !== 'undefined' && adminBadge && adminBadge.hasImage) { %>
            <img src="<%= adminBadge.imageUrl %>" alt="Admin" title="Admin" style="height:20px; vertical-align:middle; margin-left:8px;" />
          <% } %>
        </div>
        <div class="roblox-meta-row">
          <span class="roblox-meta-pill">Membership: <%= user.membershipStatus || user.membership || 'None' %></span>
          <span class="roblox-meta-pill">Role: <%= (typeof isAdmin !== 'undefined' && isAdmin) ? 'Admin' : 'Creator' %></span>
          <span class="roblox-meta-pill">Places: <%= (publishedGames && publishedGames.length) || 0 %></span>
        </div>
      </div>
    </section>

    <section class="roblox-content-grid">
      <div class="roblox-panel">
        <div class="roblox-panel-header">Wallet</div>
        <div class="roblox-panel-body">
          <div class="roblox-stat-list">
            <span>Robux</span><strong>R$ <%= (currency && currency.robux) || user.robux || 0 %></strong>
            <span>Tickets</span><strong><%= (currency && currency.tickets) || 0 %></strong>
            <span>Coins</span><strong><%= (currency && currency.coins) || 0 %></strong>
          </div>
        </div>
      </div>

      <div class="roblox-panel">
        <div class="roblox-panel-header">Your places</div>
        <div class="roblox-panel-body">
          <% if (publishedGames && publishedGames.length) { %>
            <div class="roblox-asset-list">
              <% publishedGames.forEach((place) => { %>
                <a class="roblox-asset-item" href="/game?placeId=<%= place.placeId %>">
                  <div class="roblox-asset-icon"><%= (place.name || 'G').slice(0, 1).toUpperCase() %></div>
                  <div>
                    <div class="roblox-asset-name"><%= place.name %></div>
                    <div class="roblox-asset-type"><%= place.genre || 'Experience' %></div>
                  </div>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <div class="roblox-muted">You have not published a place yet.</div>
          <% } %>
        </div>
      </div>
    </section>
      </main>
    </div>
  </div>

  <%- include('partials/scripts') %>
</body>
</html>
