<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/refresh-2021.css" />
  <link rel="stylesheet" href="/css/dev.css" />
  <link rel="stylesheet" href="/css/develop.css" />
</head>
<body>
<%
  // Which game the Studio nav should open.
  //
  // EVERY Studio page used to hardcode /dev/game/1818/settings, so clicking
  // Settings while editing any other game opened 1818 instead - the settings
  // you asked for appeared not to load, and a save then wrote to the wrong
  // place. This resolves the id from whatever the view actually has.
  var studioPlaceId = (typeof place !== "undefined" && place && place.placeId)
    ? Number(place.placeId)
    : ((typeof places !== "undefined" && Array.isArray(places) && places.length)
      ? Number(places[0].placeId || places[0].universeId || 1818)
      : 1818);
%>
  <header class="roblox-topbar">
    <div class="roblox-brand">
      <span class="roblox-brand-mark">R</span>
      <span>LuckyBlox Studio</span>
    </div>
    <nav class="roblox-nav" aria-label="Main navigation">
      <div class="roblox-nav-links">
        <a href="/dev">Home</a>
        <a href="/dev/game/<%- studioPlaceId %>/settings">Game</a>
        <a href="/dev/assets">Assets</a>
        <a href="/dev/docs" class="active">API</a>
        <div class="roblox-more-pages">
          <button class="roblox-more-pages-btn" type="button">More pages &#9662;</button>
          <div class="roblox-more-pages-dropdown">
            <a href="/dev/create">Create Game</a>
            <a href="/dev/docs/games">Game Engine API</a>
            <a href="/dev/docs/places">Place API</a>
            <a href="/dev/docs/users">User API</a>
            <a href="/dev/docs/auth">Auth API</a>
          </div>
        </div>
      </div>
    </nav>
    <div class="roblox-right">
      <span class="ch-robux"><img class="ch-ico" src="/icons/robux.svg" alt="Robux" /> <%= (currency && currency.robux) || user.robux || 0 %></span>
      <span class="roblox-icon-button" title="Account settings"><img class="ch-ico" src="/icons/settings.svg" alt="" /></span>
      <span class="roblox-icon-button" title="Notifications"><img class="ch-ico" src="/icons/notifications.svg" alt="" /></span>
      <span class="roblox-icon-button" title="Profile"><img class="ch-ico" src="/icons/profile.svg" alt="" /></span>
      <a class="dev-btn secondary" href="/logout" style="height:32px;padding:0 10px;font-size:12px;display:inline-flex;align-items:center;line-height:1;">Sign Out</a>
    </div>
  </header>

  <div class="dev-shell">
    <aside class="dev-sidebar">
      <div class="dev-sidebar-brand">Studio</div>
      <a href="/dev"><span class="dev-sidebar-icon">&#8962;</span> Home</a>
      <a href="/dev/create"><span class="dev-sidebar-icon"><img class="ch-ico" src="/icons/plus.svg" alt="" /></span> Create</a>
      <a href="/dev/game/<%- studioPlaceId %>/settings"><span class="dev-sidebar-icon"><img class="ch-ico" src="/icons/settings.svg" alt="" /></span> Settings</a>
      <a href="/dev/assets"><span class="dev-sidebar-icon"><img class="ch-ico" src="/icons/assets.svg" alt="" /></span> Assets</a>
      <a href="/dev/docs"><span class="dev-sidebar-icon">&#8505;</span> API Docs</a>
      <a href="/dev/docs/games" class="active"><span class="dev-sidebar-icon">&#9654;</span> Game Engine</a>
    </aside>

    <main class="dev-main">
      <div class="dev-header">
        <div>
          <h1>Game Engine API</h1>
          <div class="dev-header-subtitle">Engine classes and members from the selected client build</div>
        </div>
      </div>

      <% if (engineApi) { %>
        <section class="dev-api-section" aria-labelledby="engine-api-source">
          <h2 id="engine-api-source"><%= engineApi.clientName %> · <%= engineApi.engineVersion %></h2>
          <p>
            Source: <code><%= engineApi.sourceFile %></code> from the selected local client.
            This bundled reflection metadata documents class names, member names, categories,
            and available summaries; it is not a complete API dump and does not include every
            runtime signature or security annotation.
            <a href="https://robloxapi.github.io/ref/updates/2021.html" target="_blank" rel="noopener noreferrer">2021 API update archive</a>
          </p>
          <p><strong><%= engineApi.classCount %></strong> classes · <strong><%= engineApi.memberCount %></strong> documented members</p>
        </section>

        <div class="dev-api-section">
          <label for="engine-api-search"><strong>Search classes and members</strong></label>
          <input id="engine-api-search" type="search" placeholder="e.g. Workspace, FindPartOnRay, CFrame" autocomplete="off" />
          <label for="engine-api-category"><strong>Category</strong></label>
          <select id="engine-api-category">
            <option value="">All categories</option>
            <% engineApi.categories.forEach(function(category) { %>
              <option value="<%= category %>"><%= category %></option>
            <% }); %>
          </select>
          <p id="engine-api-result-count" role="status" aria-live="polite"><%= engineApi.classCount %> classes</p>
        </div>

        <div id="engine-api-classes">
          <% engineApi.classes.forEach(function(apiClass) { %>
            <details class="dev-api-section engine-api-class" data-category="<%= apiClass.category %>" data-search="<%= [apiClass.name, apiClass.summary, apiClass.category, ...apiClass.members.map(function(member) { return member.name + ' ' + member.summary + ' ' + member.kind; })].join(' ').toLowerCase() %>">
              <summary>
                <strong><%= apiClass.name %></strong>
                <span class="engine-api-category"><%= apiClass.category %></span>
              </summary>
              <% if (apiClass.summary) { %><p><%= apiClass.summary %></p><% } %>
              <% if (apiClass.members.length) { %>
                <ul class="engine-api-member-list">
                  <% apiClass.members.forEach(function(member) { %>
                    <li>
                      <code><%= member.name %></code>
                      <span class="engine-api-member-kind"><%= member.kind %></span>
                      <% if (member.summary) { %><p><%= member.summary %></p><% } %>
                    </li>
                  <% }); %>
                </ul>
              <% } else { %>
                <p>No member descriptions are included for this class in the bundled metadata.</p>
              <% } %>
            </details>
          <% }); %>
          <p id="engine-api-no-results" hidden>No matching classes or members.</p>
        </div>
      <% } else { %>
        <div class="dev-api-section">
          <h2>Engine metadata unavailable</h2>
          <p>The selected client does not include <code>shared/ReflectionMetadata.xml</code>, so this server cannot display a matching engine reference. Select a client build that ships its reflection metadata.</p>
        </div>
      <% } %>
    </main>
  </div>
<%- include('../../partials/scripts') %>
<% if (engineApi) { %>
<script>
  (function () {
    var search = document.getElementById('engine-api-search');
    var category = document.getElementById('engine-api-category');
    var cards = Array.prototype.slice.call(document.querySelectorAll('.engine-api-class'));
    var count = document.getElementById('engine-api-result-count');
    var empty = document.getElementById('engine-api-no-results');

    function filterClasses() {
      var query = search.value.trim().toLowerCase();
      var selectedCategory = category.value;
      var visibleCount = 0;
      cards.forEach(function (card) {
        var visible = (!query || card.getAttribute('data-search').indexOf(query) !== -1)
          && (!selectedCategory || card.getAttribute('data-category') === selectedCategory);
        card.hidden = !visible;
        if (visible) visibleCount += 1;
      });
      count.textContent = visibleCount + (visibleCount === 1 ? ' class' : ' classes');
      empty.hidden = visibleCount !== 0;
    }

    search.addEventListener('input', filterClasses);
    category.addEventListener('change', filterClasses);
  }());
</script>
<% } %>
<style>
  #engine-api-search,
  #engine-api-category {
    display: block;
    width: 100%;
    max-width: 560px;
    margin: 8px 0 16px;
    padding: 10px 12px;
    border: 1px solid #b8c2cc;
    border-radius: 4px;
    background: #fff;
    color: #202a35;
  }
  .engine-api-class { margin: 8px 0; }
  .engine-api-class > summary { cursor: pointer; }
  .engine-api-category,
  .engine-api-member-kind { margin-left: 8px; color: #687784; font-size: 0.9em; }
  .engine-api-member-list { padding-left: 22px; }
  .engine-api-member-list li { margin: 10px 0; }
  .engine-api-member-list p { margin: 4px 0; }
</style>
</body>
</html>
