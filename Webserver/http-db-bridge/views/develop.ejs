<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/develop.css" />
</head>

<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'create' }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'create' }) %>

      <div class="lb-main">

    <main class="ch-page">
      <section class="ch-hero">
        <div class="ch-avatar">
          <% if (typeof profileAvatar !== 'undefined' && profileAvatar && profileAvatar.fullBodyUrl) { %>
            <img src="<%= profileAvatar.fullBodyUrl %>" alt="<%= user.username %>" />
          <% } else { %>
            <%= String(user.username || 'L').slice(0, 1).toUpperCase() %>
          <% } %>
        </div>
        <div class="ch-hero-main">
          <div class="ch-eyebrow">Creator Hub</div>
          <h1><%= user.username %>'s Creations</h1>
          <div class="ch-hero-meta">
            <span class="ch-chip"><img class="ch-ico ch-ico-sm" src="/icons/studio.svg" alt="" /> <%= isOwner ? 'Owner' : 'Creator' %></span>
            <span class="ch-chip"><img class="ch-ico ch-ico-sm" src="/icons/games.svg" alt="" /> <%= stats.places %> experiences</span>
            <span class="ch-chip"><img class="ch-ico ch-ico-sm" src="/icons/assets.svg" alt="" /> <%= stats.assets %> assets</span>
            <span class="ch-chip"><img class="ch-ico ch-ico-sm" src="/icons/chart.svg" alt="" /> <%= stats.visits %> visits</span>
          </div>
        </div>
        <div class="ch-hero-actions">
          <a class="ch-btn ch-btn-primary" href="/dev/create"><img class="ch-ico" src="/icons/plus.svg" alt="" /> New Experience</a>
          <a class="ch-btn ch-btn-ghost" href="/studio?userId=<%= user.userId %>"><img class="ch-ico" src="/icons/upload.svg" alt="" /> Open Studio</a>
        </div>
      </section>

      <% if (!signedIn) { %>
        <div class="dev-notice info" style="margin-top:16px;">
          You are browsing as a guest. <a href="/signin?redirect=/develop">Sign in</a> to create experiences and manage your assets.
        </div>
      <% } %>

      <section class="ch-stats">
        <div class="ch-stat">
          <div class="ch-stat-ico"><img class="ch-ico" src="/icons/games.svg" alt="" /></div>
          <div>
            <div class="ch-stat-value"><%= stats.places %></div>
            <div class="ch-stat-label">Experiences</div>
          </div>
        </div>
        <div class="ch-stat">
          <div class="ch-stat-ico"><img class="ch-ico" src="/icons/profile.svg" alt="" /></div>
          <div>
            <div class="ch-stat-value" id="statPlayers"><%= stats.playersOnline %></div>
            <div class="ch-stat-label">Players online</div>
          </div>
        </div>
        <div class="ch-stat">
          <div class="ch-stat-ico"><img class="ch-ico" src="/icons/studio.svg" alt="" /></div>
          <div>
            <div class="ch-stat-value" id="statServers"><%= stats.liveServers %></div>
            <div class="ch-stat-label">Live servers</div>
          </div>
        </div>
        <div class="ch-stat">
          <div class="ch-stat-ico"><img class="ch-ico" src="/icons/assets.svg" alt="" /></div>
          <div>
            <div class="ch-stat-value"><%= stats.assets %></div>
            <div class="ch-stat-label">Assets</div>
          </div>
        </div>
        <div class="ch-stat">
          <div class="ch-stat-ico"><img class="ch-ico" src="/icons/chart.svg" alt="" /></div>
          <div>
            <div class="ch-stat-value"><%= stats.visits %></div>
            <div class="ch-stat-label">Total visits</div>
          </div>
        </div>
      </section>

      <section class="ch-grid">
        <div>
          <div class="ch-panel">
            <div class="ch-panel-head">
              <span class="ch-title"><img class="ch-ico" src="/icons/games.svg" alt="" /> Your experiences</span>
              <a class="ch-btn ch-btn-blue ch-btn-sm" href="/dev/create"><img class="ch-ico ch-ico-sm" src="/icons/plus.svg" alt="" /> Create</a>
            </div>
            <div class="ch-panel-body">
              <% if (places.length) { %>
                <% places.forEach((place) => { %>
                  <div class="ch-game">
                    <div class="ch-game-thumb"><%= String(place.name).slice(0, 1).toUpperCase() %></div>
                    <div class="ch-game-info">
                      <div class="ch-game-name"><%= place.name %></div>
                      <div class="ch-game-desc"><%= place.description || 'No description yet.' %></div>
                      <div class="ch-game-meta">
                        <span class="ch-badge <%= place.visibility === 'Public' ? 'ch-badge-public' : (place.visibility === 'Friends' ? 'ch-badge-friends' : 'ch-badge-private') %>">
                          <%= place.visibility || 'Private' %>
                        </span>
                        <span class="ch-badge ch-badge-type">Place <%= place.placeId %></span>
                        <span class="ch-badge ch-badge-type"><%= place.genre %></span>
                        <span class="ch-badge ch-badge-type"><%= place.playing %> playing</span>
                        <span class="ch-badge ch-badge-type"><%= place.serverCount %> server<%= place.serverCount === 1 ? '' : 's' %></span>
                      </div>
                      <div class="ch-game-meta" style="margin-top:6px;">
                        <span class="ch-badge ch-badge-type">Created <%= place.createdAt ? new Date(place.createdAt).toLocaleDateString() : '—' %></span>
                        <span class="ch-badge ch-badge-type">Updated <%= place.updatedAt ? new Date(place.updatedAt).toLocaleDateString() : '—' %></span>
                        <span class="ch-badge ch-badge-type"><%= place.hasMap ? 'Map ready' : 'No map file' %></span>
                      </div>
                    </div>
                    <div class="ch-hero-actions">
                      <a class="ch-btn ch-btn-light ch-btn-sm" href="/dev/game/<%= place.placeId %>/settings"><img class="ch-ico ch-ico-sm" src="/icons/settings.svg" alt="" /> Manage</a>
                      <a class="ch-btn ch-btn-blue ch-btn-sm" href="/game/<%= place.placeId %>"><img class="ch-ico ch-ico-sm" src="/icons/play.svg" alt="" /> Play</a>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <div class="ch-empty">
                  You have not created an experience yet.
                  <a href="/dev/create">Create your first one</a> or publish from Studio.
                </div>
              <% } %>
            </div>
          </div>

          <div class="ch-panel">
            <div class="ch-panel-head">
              <span class="ch-title"><img class="ch-ico" src="/icons/assets.svg" alt="" /> Recently updated</span>
            </div>
            <div class="ch-panel-body">
              <% if (typeof recent !== 'undefined' && recent && recent.length) { %>
                <div class="ch-recent">
                  <% recent.forEach((r) => { %>
                    <a class="ch-recent-item" href="/dev/game/<%= r.placeId %>/settings">
                      <div class="ch-recent-name"><%= r.name %></div>
                      <div class="ch-recent-date"><%= r.updatedAt ? new Date(r.updatedAt).toLocaleDateString() : 'Unknown' %></div>
                    </a>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="ch-empty">No recent activity yet.</div>
              <% } %>
            </div>
          </div>
        </div>

        <aside>
          <div class="ch-panel">
            <div class="ch-panel-head"><span class="ch-title"><img class="ch-ico" src="/icons/sparkle.svg" alt="" /> Quick actions</span></div>
            <div class="ch-panel-body">
              <a class="ch-action" href="/dev/create">
                <div class="ch-action-ico"><img class="ch-ico" src="/icons/plus.svg" alt="" /></div>
                <div>
                  <div class="ch-action-name">New Experience</div>
                  <div class="ch-action-sub">Start a new place</div>
                </div>
              </a>
              <a class="ch-action" href="#" id="launchStudioBtn">
                <div class="ch-action-ico"><img class="ch-ico" src="/icons/hammer.svg" alt="" /></div>
                <div>
                  <div class="ch-action-name">Open Studio 2022M</div>
                  <div class="ch-action-sub"><%= studioReady ? 'Launch the desktop app' : 'Not installed on this host' %></div>
                </div>
              </a>
              <a class="ch-action" href="/dev/assets">
                <div class="ch-action-ico"><img class="ch-ico" src="/icons/upload.svg" alt="" /></div>
                <div>
                  <div class="ch-action-name">Upload assets</div>
                  <div class="ch-action-sub">Images, audio, meshes</div>
                </div>
              </a>
              <a class="ch-action" href="/avatar?userId=<%= user.userId %>">
                <div class="ch-action-ico"><img class="ch-ico" src="/icons/palette.svg" alt="" /></div>
                <div>
                  <div class="ch-action-name">Customize avatar</div>
                  <div class="ch-action-sub">Outfit and appearance</div>
                </div>
              </a>
              <a class="ch-action" href="/dev/docs">
                <div class="ch-action-ico"><img class="ch-ico" src="/icons/code.svg" alt="" /></div>
                <div>
                  <div class="ch-action-name">Creator docs</div>
                  <div class="ch-action-sub">Engine and API reference</div>
                </div>
              </a>
            </div>
          </div>

          <div class="ch-panel">
            <div class="ch-panel-head"><span class="ch-title"><img class="ch-ico" src="/icons/studio.svg" alt="" /> Studio 2022M</span>
              <span class="ch-badge <%= studioReady ? 'ch-badge-public' : 'ch-badge-private' %>"><%= studioReady ? 'Ready' : 'Not installed' %></span>
            </div>
            <div class="ch-panel-body">
              <div class="ch-muted" style="font-size:0.85rem;line-height:1.6;">
                Studio connects to <strong><%= studioBaseUrl %></strong> and authenticates as <strong><%= user.username %></strong>.
                The game server listens on <strong><%= studioHost %>:<%= studioPort %></strong>.
              </div>
              <div class="ch-hero-actions" style="margin-top:12px;">
                <button class="ch-btn ch-btn-blue ch-btn-sm" type="button" id="launchStudioBtn2"><img class="ch-ico ch-ico-sm" src="/icons/studio.svg" alt="" /> Launch Studio</button>
                <a class="ch-btn ch-btn-light ch-btn-sm" href="/studio?userId=<%= user.userId %>"><img class="ch-ico ch-ico-sm" src="/icons/code.svg" alt="" /> Web tools</a>
              </div>
              <div class="ch-muted" id="studioStatus" style="font-size:0.78rem;margin-top:10px;" hidden></div>
            </div>
          </div>

          <div class="ch-panel">
            <div class="ch-panel-head"><span class="ch-title"><img class="ch-ico" src="/icons/profile.svg" alt="" /> Live servers</span>
              <span class="ch-badge ch-badge-type" id="liveServerCount"><%= stats.liveServers %></span>
            </div>
            <div class="ch-panel-body">
              <div id="liveServerList">
                <% if (liveServers && liveServers.length) { %>
                  <% liveServers.forEach((s) => { %>
                    <div class="ch-action">
                      <div class="ch-action-ico"><img class="ch-ico" src="/icons/studio.svg" alt="" /></div>
                      <div>
                        <div class="ch-action-name">Place <%= s.placeId %></div>
                        <div class="ch-action-sub"><%= s.playing %>/<%= s.maxPlayers %> players · port <%= s.port %> · <%= s.status %></div>
                      </div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="ch-empty">No games running right now.</div>
                <% } %>
              </div>
            </div>
          </div>

          <% if (typeof adminBadge !== 'undefined' && adminBadge) { %>
            <div class="ch-panel">
              <div class="ch-panel-head"><span class="ch-title"><img class="ch-ico" src="/icons/shield.svg" alt="" /> Admin</span></div>
              <div class="ch-panel-body">
                <div class="ch-muted" style="font-size:0.85rem;">You have owner access to this deployment.</div>
                <a class="ch-btn ch-btn-light ch-btn-sm" style="margin-top:10px;" href="/dev/docs">View API docs</a>
              </div>
            </div>
          <% } %>
        </aside>
      </section>
    </main>
    </div>
  </div>
  <script src="/legacy-nav.js"></script>
  <script>
    (function () {
      'use strict';

      // --- Launch Studio 2022M -------------------------------------------------
      // Asks the server to spawn RobloxStudioBeta.exe with this user's one-time
      // auth handshake. The server reports whether the desktop app is installed.
      var statusEl = document.getElementById('studioStatus');

      function showStudioStatus(message, isError) {
        if (!statusEl) return;
        statusEl.hidden = false;
        statusEl.textContent = message;
        statusEl.style.color = isError ? '#c0392b' : '#008a4a';
      }

      async function launchStudio() {
        showStudioStatus('Starting LuckyBlox Studio...', false);
        try {
          var response = await fetch('/api/studio/launch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({})
          });
          var data = await response.json();
          if (!response.ok || !data.ok) {
            showStudioStatus((data && data.message) || 'Could not start Studio.', true);
            return;
          }
          if (data.launched) {
            showStudioStatus('LuckyBlox Studio is opening. Sign in when it asks.', false);
          } else {
            showStudioStatus(data.message || 'Studio is not installed on this machine.', true);
          }
        } catch (error) {
          showStudioStatus('Could not reach the server to start Studio.', true);
        }
      }

      var b1 = document.getElementById('launchStudioBtn');
      var b2 = document.getElementById('launchStudioBtn2');
      if (b1) b1.addEventListener('click', function (e) { e.preventDefault(); launchStudio(); });
      if (b2) b2.addEventListener('click', launchStudio);

      // --- Live server / player counts ---------------------------------------
      // Polls the real orchestrator state so the dashboard is dynamic, not a
      // snapshot frozen at page render.
      var playersEl = document.getElementById('statPlayers');
      var serversEl = document.getElementById('statServers');
      var countEl = document.getElementById('liveServerCount');
      var listEl = document.getElementById('liveServerList');

      async function refreshLive() {
        try {
          var r = await fetch('/api/develop/live', { headers: { Accept: 'application/json' } });
          if (!r.ok) return;
          var d = await r.json();
          if (!d || !d.ok) return;
          if (playersEl) playersEl.textContent = d.playersOnline;
          if (serversEl) serversEl.textContent = d.serverCount;
          if (countEl) countEl.textContent = d.serverCount;
          if (listEl) {
            if (d.servers && d.servers.length) {
              listEl.innerHTML = d.servers.map(function (s) {
                return '<div class="ch-action"><div class="ch-action-ico"><img class="ch-ico" src="/icons/studio.svg" alt="" /></div>' +
                  '<div><div class="ch-action-name">Place ' + s.placeId + '</div>' +
                  '<div class="ch-action-sub">' + s.playing + '/' + s.maxPlayers + ' players · port ' + s.port + ' · ' + s.status + '</div></div></div>';
              }).join('');
            } else {
              listEl.innerHTML = '<div class="ch-empty">No games running right now.</div>';
            }
          }
        } catch (error) { /* keep the server-rendered values */ }
      }

      refreshLive();
      setInterval(refreshLive, 15000);
    }());
  </script>
  </body>
</html>