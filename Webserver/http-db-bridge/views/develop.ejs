<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
</head>

<body>
  <div class="roblox-page">
    <header class="roblox-topbar">
      <div class="roblox-brand">
        <img src="/site-icon/luckyblox.png" alt="LuckyBlox" style="height:28px; width:auto;" />
        <span>LuckyBlox</span>
      </div>

      <nav class="roblox-nav">
        <div class="roblox-nav-links">
          <a href="/">Home</a>
          <a href="/games">Games</a>
          <a href="/develop">Create</a>
          <div class="roblox-more-pages">
            <button class="roblox-more-pages-btn" type="button">More pages &#9662;</button>
            <div class="roblox-more-pages-dropdown">
              <a href="/profile?userId=<%= user.userId %>">Profile</a>
              <a href="/avatar?userId=<%= user.userId %>">Avatar</a>
              <a href="/studio?userId=<%= user.userId %>">Studio</a>
              <a href="/account?userId=<%= user.userId %>">Account</a>
            </div>
          </div>
        </div>
      </nav>

      <div class="roblox-right">
        <span class="roblox-robux">
          <%= user.robux || 0 %>
        </span>
        <span class="roblox-icon-button">⚙</span>
        <span class="roblox-icon-button">🔔</span>
      </div>
    </header>

    <section class="roblox-hero">
      <div class="roblox-avatar-poster">
        <div class="roblox-avatar-big"><%= String(user.username || 'L').slice(0,1).toUpperCase() %></div>
      </div>

      <div>
        <div class="roblox-eyebrow">Creator Hub</div>
        <div class="roblox-title-block">
          <h1>
            <%= user.username %>
          </h1>
          <span class="roblox-meta-pill">
            <%= isOwner ? 'Owner' : 'Creator' %>
          </span>
        </div>

        <div class="roblox-meta-row">
          <span class="roblox-meta-pill">ID: <%= user.userId %></span>
          <span class="roblox-meta-pill">Experiences: <%= stats.places %></span>
          <span class="roblox-meta-pill">Assets: <%= stats.assets %></span>
          <span class="roblox-meta-pill">Visits: <%= stats.visits %></span>
        </div>

        <% if (!signedIn) { %>
          <div class="roblox-description">
            You are browsing as a guest.
            <a href="/signin?redirect=/develop">Sign in</a>
            to publish experiences and manage your places.
          </div>
          <% } %>
      </div>
    </section>

    <section class="roblox-content-grid">
      <div class="roblox-panel">
        <div class="roblox-panel-header">Your experiences</div>
        <div class="roblox-panel-body">
          <% if (places.length) { %>
            <div class="roblox-asset-list">
              <% places.forEach((place)=> { %>
                <div class="roblox-asset-item">
                  <div class="roblox-asset-icon"><%= String(place.name).slice(0,1).toUpperCase() %></div>
                  <div>
                    <div class="roblox-asset-name"><%= place.name %></div>
                    <div class="roblox-asset-type">Place ID <%= place.placeId %></div>
                  </div>
                  <div class="roblox-asset-tag"><%= place.visibility || 'Private' %></div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="roblox-description">You have not created an experience yet. Publish one from Studio to see it here.</div>
          <% } %>
        </div>
      </div>

      <aside class="roblox-side-stack">
        <div class="roblox-panel">
          <div class="roblox-panel-header">Quick actions</div>
          <div class="roblox-panel-body">
            <div class="roblox-asset-list">
              <a class="roblox-asset-item" href="/studio?userId=<%= user.userId %>">
                <div class="roblox-asset-icon">S</div>
                <div>
                  <div class="roblox-asset-name">Open Studio</div>
                  <div class="roblox-asset-type">Build and edit places</div>
                </div>
                <div class="roblox-asset-tag">Open</div>
              </a>
              <a class="roblox-asset-item" href="/games">
                <div class="roblox-asset-icon">G</div>
                <div>
                  <div class="roblox-asset-name">Browse games</div>
                  <div class="roblox-asset-type">Play published experiences</div>
                </div>
                <div class="roblox-asset-tag">Open</div>
              </a>
              <a class="roblox-asset-item" href="/avatar?userId=<%= user.userId %>">
                <div class="roblox-asset-icon">A</div>
                <div>
                  <div class="roblox-asset-name">Customize avatar</div>
                  <div class="roblox-asset-type">Outfit and appearance</div>
                </div>
                <div class="roblox-asset-tag">Open</div>
              </a>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <section class="roblox-content-grid" style="margin-top: 20px;">
      <div class="roblox-panel" style="grid-column: 1 / -1;">
        <div class="roblox-panel-header">Published assets</div>
        <div class="roblox-panel-body">
          <% if (assets.length) { %>
            <div class="roblox-asset-list">
              <% assets.forEach((asset)=> { %>
                <div class="roblox-asset-item">
                  <div class="roblox-asset-icon"><%= String(asset.name).slice(0,1).toUpperCase() %></div>
                  <div>
                    <div class="roblox-asset-name"><%= asset.name %></div>
                    <div class="roblox-asset-type"><%= asset.assetType %> · <%= asset.creatorName %></div>
                  </div>
                  <div class="roblox-asset-tag">R$ <%= asset.price %></div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="roblox-description">No assets published yet.</div>
          <% } %>
        </div>
      </div>
    </section>
  </div>
  <script src="/legacy-nav.js"></script>
</body>

</html>