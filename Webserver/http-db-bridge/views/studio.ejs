<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/develop.css" />
  <style>
    body { margin: 0; background: #101214; color: #f3f4f5; font-family: "Gotham SSm", Arimo, Arial, sans-serif; }
    .studio-shell { max-width: 1200px; margin: 0 auto; padding: 28px; }
    .studio-topbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; }
    .studio-brand { font-size: 28px; font-weight: 700; }
    .studio-actions { display:flex; gap:12px; }
    .studio-button { background:#1f9d55; color:white; border:none; padding:10px 18px; border-radius:8px; cursor:pointer; }
    .studio-button.secondary { background:#2b2d31; }
    .studio-panel { background:#171a1d; border:1px solid #292d31; border-radius:12px; padding:18px; margin-bottom:18px; }
    .studio-grid { display:grid; grid-template-columns: 1.3fr 0.7fr; gap:18px; }
    .studio-list { display:flex; flex-direction:column; gap:12px; }
    .studio-place { padding:12px; border-radius:10px; background:#1d2125; border:1px solid #2a2e33; }
    .studio-place h3 { margin:0 0 6px; }
    .studio-place p { margin:0; color:#c9ced4; }
    .muted { color:#b6bcc6; }
    .status-chip { display:inline-block; margin-top:8px; padding:4px 8px; border-radius:999px; background:#1d3b2b; color:#9ce6b1; font-size:12px; }
    .settings-form { display:flex; flex-direction:column; gap:10px; }
    .settings-form label { display:flex; flex-direction:column; gap:6px; color:#dfe5eb; font-size:13px; }
    .settings-form input, .settings-form textarea, .settings-form select { width:100%; border-radius:8px; border:1px solid #353b41; background:#0f1215; color:#f3f5f7; padding:9px 10px; box-sizing:border-box; }
    .settings-form textarea { min-height:80px; resize:vertical; }
    .settings-actions { display:flex; gap:10px; margin-top:8px; }
  </style>
</head>
<body class="lb-studio">
  <div class="roblox-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'create' }) %>

    <%- include('partials/creator-rail', { user: user, activeNav: 'studio', studioReady: studioReady }) %>

  <div class="studio-shell">
    <div class="studio-topbar">
      <div class="studio-brand"><img class="ch-ico ch-ico-lg" src="/icons/studio.svg" alt="" style="margin-right:8px;vertical-align:middle;" /> LuckyBlox Studio</div>
      <div class="studio-actions">
        <button class="studio-button" id="savePlaceBtn"><img class="ch-ico ch-ico-sm" src="/icons/download.svg" alt="" style="margin-right:6px;vertical-align:middle;" /> Save</button>
        <button class="studio-button secondary" id="publishPlaceBtn"><img class="ch-ico ch-ico-sm" src="/icons/upload.svg" alt="" style="margin-right:6px;vertical-align:middle;" /> Publish</button>
        <a class="studio-button secondary" href="/develop?userId=<%= user.userId %>" style="text-decoration:none;"><img class="ch-ico ch-ico-sm" src="/icons/develop.svg" alt="" style="margin-right:6px;vertical-align:middle;" /> Creator Hub</a>
      </div>
    </div>

    <div class="studio-grid">
      <div class="studio-panel">
        <h2 style="margin-top:0;"><img class="ch-ico" src="/icons/assets.svg" alt="" style="margin-right:8px;vertical-align:middle;" /> Places</h2>
        <div class="studio-list">
          <% if (places.length) { %>
            <% places.forEach((place) => { %>
              <div class="studio-place">
                <h3><%= place.name %></h3>
                <p><%= place.description %></p>
                <div class="status-chip">Place ID: <%= place.placeId %></div>
                <div style="margin-top:8px;display:flex;gap:8px;">
                  <button type="button" class="studio-button secondary open-place-btn" data-place-id="<%= place.placeId %>" data-place-name="<%= place.name %>"><img class="ch-ico ch-ico-sm" src="/icons/edit.svg" alt="" style="margin-right:6px;vertical-align:middle;" /> Open</button>
                  <a class="studio-button secondary" href="/game/<%= place.placeId %>" style="text-decoration:none;"><img class="ch-ico ch-ico-sm" src="/icons/play.svg" alt="" style="margin-right:6px;vertical-align:middle;" /> Playtest</a>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="muted">No places yet. Publish one to start editing.</div>
          <% } %>
        </div>
      </div>

      <div class="studio-panel">
        <h2 style="margin-top:0;"><img class="ch-ico" src="/icons/profile.svg" alt="" style="margin-right:8px;vertical-align:middle;" /> Account</h2>
        <div class="muted">User: <%= user.username %></div>
        <div class="muted">Membership: <%= user.membershipStatus || user.membership || 'None' %></div>
        <div class="muted">Role: <%= (typeof isAdmin !== 'undefined' && isAdmin) ? 'Admin' : 'Creator' %></div>
        <div class="muted" style="display:flex;align-items:center;gap:6px;">Robux: <img class="ch-ico ch-ico-sm ch-ico--ink" src="/icons/robux-outline.svg" alt="Robux" /> <%= (currency && currency.robux) || user.robux || 0 %></div>
        <div class="muted" style="margin-top:10px;"><strong>Studio 2022M</strong> connects to:</div>
        <div class="status-chip"><%= typeof studioHost !== 'undefined' ? studioHost : 'localhost' %>:<%= typeof studioPort !== 'undefined' ? studioPort : '53640' %></div>
        <div style="margin-top:16px;">
          <button class="studio-button secondary" id="refreshStudioBtn"><img class="ch-ico ch-ico-sm" src="/icons/settings.svg" alt="" style="margin-right:6px;vertical-align:middle;" /> Refresh account</button>
        </div>
      </div>
    </div>

    <div class="studio-panel" style="margin-top:18px;">
      <h2 style="margin-top:0;"><img class="ch-ico" src="/icons/settings.svg" alt="" style="margin-right:8px;vertical-align:middle;" /> Game Settings</h2>
      <form id="gameSettingsForm" class="settings-form">
        <label>
          Name
          <input id="settingsName" name="name" type="text" value="LuckyBlox Arena" />
        </label>
        <label>
          Description
          <textarea id="settingsDescription" name="description">Local Studio place</textarea>
        </label>
        <label>
          Visibility
          <select id="settingsVisibility" name="visibility">
            <option value="Public">Public</option>
            <option value="Friends">Friends</option>
            <option value="Private">Private</option>
          </select>
        </label>
        <label>
          Genre
          <input id="settingsGenre" name="genre" type="text" value="Adventure" />
        </label>
        <label>
          Max Players
          <input id="settingsMaxPlayers" name="maxPlayers" type="number" min="1" max="100" value="20" />
        </label>
        <div class="settings-actions">
          <button type="submit" class="studio-button"><img class="ch-ico ch-ico-sm" src="/icons/download.svg" alt="" style="margin-right:6px;vertical-align:middle;" /> Apply settings</button>
          <button type="button" class="studio-button secondary" id="loadSettingsBtn"><img class="ch-ico ch-ico-sm" src="/icons/settings.svg" alt="" style="margin-right:6px;vertical-align:middle;" /> Reload</button>
        </div>
      </form>
    </div>
  </div>
  </div>

  <script>
    // Track the place the user is working on: it changes when they open a place.
    let placeId = <%= (places && places[0] && places[0].placeId) || 1818 %>;
    let placeName = <%= JSON.stringify((places && places[0] && places[0].name) || 'LuckyBlox Place') %>;
    const currentUserId = <%= Number(user.userId) || 1 %>;
    const currentUserName = <%= JSON.stringify(user.username || 'Creator') %>;

    async function callApi(path, payload) {
      const response = await fetch(path, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      return response.json();
    }

    async function loadGameSettings() {
      const response = await fetch(`/api/places/${placeId}/settings`);
      const data = await response.json();
      if (!data.ok || !data.settings) return;

      const settings = data.settings;
      document.getElementById('settingsName').value = settings.name || 'LuckyBlox Arena';
      document.getElementById('settingsDescription').value = settings.description || 'Local Studio place';
      document.getElementById('settingsVisibility').value = settings.visibility || 'Public';
      document.getElementById('settingsGenre').value = settings.genre || 'Adventure';
      document.getElementById('settingsMaxPlayers').value = settings.maxPlayers || 20;
    }

    // Opening a place makes it the active one and loads its real settings.
    document.querySelectorAll('.open-place-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        placeId = Number(btn.getAttribute('data-place-id')) || placeId;
        placeName = btn.getAttribute('data-place-name') || placeName;
        loadGameSettings();
        const target = document.getElementById('gameSettingsForm');
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    document.getElementById('savePlaceBtn').addEventListener('click', async () => {
      const data = await callApi('/api/save-place', {
        name: placeName,
        placeId,
        description: document.getElementById('settingsDescription').value || 'Saved from local Studio workflow.',
        author: currentUserName,
        authorId: currentUserId,
        version: 1,
        data: { mode: 'save', savedAt: new Date().toISOString() }
      });
      alert(data.ok ? 'Saved successfully.' : 'Save failed.');
    });

    document.getElementById('publishPlaceBtn').addEventListener('click', async () => {
      const data = await callApi('/api/publish-place', {
        name: document.getElementById('settingsName').value || placeName,
        placeId,
        description: document.getElementById('settingsDescription').value || 'Published from local Studio workflow.',
        visibility: document.getElementById('settingsVisibility').value,
        author: currentUserName,
        authorId: currentUserId,
        version: 1,
        data: { mode: 'publish', publishedAt: new Date().toISOString() }
      });
      alert(data.ok ? 'Published successfully.' : 'Publish failed.');
    });

    document.getElementById('refreshStudioBtn').addEventListener('click', async () => {
      const response = await fetch(`/api/account/info?userId=${currentUserId}`);
      const data = await response.json();
      alert(data.ok ? 'Account refreshed successfully.' : 'Account refresh failed.');
    });

    document.getElementById('loadSettingsBtn').addEventListener('click', loadGameSettings);

    document.getElementById('gameSettingsForm').addEventListener('submit', async (event) => {
      event.preventDefault();
      const payload = {
        name: document.getElementById('settingsName').value,
        description: document.getElementById('settingsDescription').value,
        visibility: document.getElementById('settingsVisibility').value,
        genre: document.getElementById('settingsGenre').value,
        maxPlayers: Number(document.getElementById('settingsMaxPlayers').value || 20),
      };

      const data = await callApi(`/api/places/${placeId}/settings`, payload);
      alert(data.ok ? 'Game settings saved.' : 'Game settings failed to save.');
      loadGameSettings();
    });

    loadGameSettings();
  </script>
  <%- include('partials/scripts') %>
</body>
</html>
