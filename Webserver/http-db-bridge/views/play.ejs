<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/roblox.css" />
</head>
<body>
  <div class="roblox-page">
    <header class="roblox-topbar">
      <a class="roblox-brand" href="/" aria-label="LuckyBlox home">
        <img class="roblox-brand-mark" src="/site-icon/luckyblox.png" alt="LuckyBlox" />
        <span>LuckyBlox</span>
      </a>

      <nav class="roblox-nav" aria-label="Main navigation">
        <div class="roblox-nav-links">
          <a href="/">Home</a>
          <a href="/games">Games</a>
          <div class="roblox-more-pages">
            <button class="roblox-more-pages-btn" type="button">More pages &#9662;</button>
            <div class="roblox-more-pages-dropdown">
              <a href="/profile?userId=<%= userId %>">Profile</a>
              <a href="/avatar?userId=<%= userId %>">Avatar</a>
              <a href="/game?placeId=<%= placeId %>">Game</a>
              <a href="/studio">Studio</a>
              <a href="/settings">Settings</a>
              <a href="/account">Account</a>
            </div>
          </div>
        </div>
      </nav>

      <div class="roblox-right">
        <span class="roblox-robux"><%= user.robux || 0 %></span>
        <a class="roblox-icon-button" href="/account" title="Account settings" aria-label="Account settings"><img class="ch-ico" src="/icons/settings.svg" alt="" /></a>
        <a class="roblox-icon-button" href="/friends" title="Friends" aria-label="Friends"><img class="ch-ico" src="/icons/friends.svg" alt="" /></a>
        <a class="roblox-icon-button" href="/profile?userId=<%= user.userId %>" title="Profile" aria-label="Profile"><img class="ch-ico" src="/icons/profile.svg" alt="" /></a>
      </div>
    </header>

    <section class="roblox-hero">
      <div class="roblox-game-icon" style="background-image: url('<%= gameName ? 'https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=240&q=80' : '' %>');"></div>

      <div>
        <div class="roblox-eyebrow">Play</div>
        <div class="roblox-title-block">
          <h1><%= gameName %></h1>
          <button class="roblox-play-button" type="button" id="playNowBtn"
                  data-place-id="<%= placeId %>"
                  data-server-port="<%= serverPort %>"
                  data-job-id="<%= jobId %>"
                  data-ticket="<%= ticket %>">Play now</button>
        </div>

        <div class="roblox-meta-row">
          <span class="roblox-meta-pill">Place ID: <%= placeId %></span>
          <span class="roblox-meta-pill">Job: <%= jobId %></span>
        </div>

        <div class="roblox-description">Launch this experience on your local device.</div>
      </div>
    </section>

    <!-- Client install state, filled by the launch probe below. -->
    <p class="roblox-description" id="clientStatusLine"></p>
  </div>

  <%# Above the inline handler, which calls window.LBLoading. %>
  <%- include('partials/scripts') %>
  <script>
    // The Play button finds the installed LuckyBlox client and launches it
    // automatically. If the client is missing, it offers the custom installer
    // instead of doing nothing.
    (function () {
      var btn = document.getElementById('playNowBtn');
      var statusLine = document.getElementById('clientStatusLine');
      if (!btn) return;

      function say(message) {
        if (statusLine) statusLine.textContent = message;
      }

      btn.addEventListener('click', async function () {
        var placeId = Number(btn.getAttribute('data-place-id')) || 1818;
        var loading = window.LBLoading;

        // The launch is a two-step server call (build the ticket, then start the
        // client), so the big page spinner plus the status line is the honest
        // indicator. The button also gets its own in-button spinner.
        if (loading) loading.show('Starting LuckyBlox\u2026');
        if (loading) loading.button(btn, true);
        say('Checking for the LuckyBlox client\u2026');

        try {
          var res = await fetch('/api/client/launch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({ placeId: placeId })
          });
          var data = await res.json();

          if (res.status === 401 || (data && data.error === 'sign-in-required')) {
            window.location.href = '/signin?redirect=' + encodeURIComponent(window.location.pathname + window.location.search);
            return;
          }

          if (data && data.ok && data.started) {
            say('LuckyBlox is starting. The client is connecting to your local server\u2026');
            return;
          }

          // Not installed - offer the installer.
          if (data && data.client && data.client.downloadUrl) {
            say('The LuckyBlox client is not installed.');
            if (window.confirm('The LuckyBlox client is not installed.\n\nDownload it now?')) {
              window.location.href = data.client.downloadUrl;
            }
            return;
          }

          say((data && (data.details || data.message)) || 'The LuckyBlox client is not installed on this device.');
        } catch (error) {
          say('Could not reach the server to launch the client.');
        } finally {
          // Covers every path above, including the sign-in redirect and the
          // throw, so the veil is never left up over a live page.
          if (loading) loading.hideAll();
          if (loading) loading.button(btn, false);
        }
      });
    }());
  </script>
</body>
</html>
