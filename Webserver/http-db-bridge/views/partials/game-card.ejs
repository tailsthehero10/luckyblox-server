<%#
  Game card - the real 2013 Roblox game tile.

  Structure taken from the 2013 web source in this repo:
    Web-2013 CCS+JS\2013CSS\CSS\Pages\Games\Games.css

  Tag names below are written without angle brackets on purpose: a literal tag
  inside a comment defeats structural checks and makes the real nesting
  impossible to read by eye. Read "div.game-item" as a div with that class.

    div.game-item                        (192x144)
      a.game-item-image                  (192x108 thumbnail)
        img                              (the artwork)
      a.game-name                        (the title, 190x17, ellipsised)
      div.game-thumbs-up-down
        span.vote-percentage-label       88%
        span.player-count                1.1K playing

  The real tile carries ONLY the name, the vote percentage and the playing count.
  No genre, no developer line - adding those is what made the cards read as
  "not Roblox".

  The Play control is an ICON ONLY (the real card had no "Play" text label). It is
  a span, not a button, because the whole card is already a link and a button
  inside a link is invalid HTML that swallows the click. The delegated handler on
  the page turns a click on it into an in-page launch.

  The artwork is a real img layered over the placeholder sibling, so a 404 reveals
  the placeholder instead of an empty box, and the shared spinner can cover it.

  Expects: cardGame { placeId, title, icon, votePercentage, playing }, and
  optionally `showPlaying` (default true) so a caller can drop the player count.
%>
<%
var gc = (typeof cardGame !== 'undefined' && cardGame) ? cardGame : {};
var gcPlaceId = Number(gc.placeId || gc.universeId || 1818);
var gcTitle = String(gc.title || gc.name || ('Experience ' + gcPlaceId));
var gcIcon = (typeof gc.icon === 'string' && /^\/|^https?:\/\//.test(gc.icon)) ? gc.icon : '/gameplaceholder/card.png';
var gcVote = (gc.votePercentage != null) ? Number(gc.votePercentage) : null;
if (!Number.isFinite(gcVote)) gcVote = null;
var gcPlaying = Number(gc.playing != null ? gc.playing : gc.playerCount) || 0;
var gcShowPlaying = (typeof showPlaying !== 'undefined') ? !!showPlaying : true;
var gcSlug = gcTitle.replace(/[^a-zA-Z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 60);
var gcHref = '/games/' + gcPlaceId + (gcSlug ? '/' + gcSlug : '');
// The client era this game runs on.
//
// It is deliberately NOT a visible line on the tile. The real 2013 card carries
// only the name, the vote percentage and the playing count - a visible year row
// is exactly the "extra metadata" that made these cards read as not-Roblox. The
// year is exposed as the card's title/tooltip instead, so it is present and
// machine-readable without changing the authentic tile.
var gcYear = (gc.clientYear != null && Number(gc.clientYear)) ? String(Number(gc.clientYear)) : '';
var gcTitleAttr = gcYear ? (gcTitle + ' (' + gcYear + ')') : gcTitle;
// `abbreviateCount` is the shared helper (res.locals), so every page abbreviates
// counts the same way. The fallback keeps a caller that renders this partial
// outside a normal request (e.g. a test) from throwing.
var gcPlayingText = (typeof abbreviateCount === 'function') ? abbreviateCount(gcPlaying) : String(gcPlaying);
%>
<div class="game-item" id="game-<%= gcPlaceId %>"<% if (gcYear) { %> data-client-year="<%= gcYear %>"<% } %>>
  <a class="game-item-image lb-loading-block is-loading" href="<%= gcHref %>"
     style="--lb-loader-size:28px;" title="<%= gcTitleAttr %>">
    <img src="<%= gcIcon %>" alt="<%= gcTitle %>" loading="lazy"
         onload="this.parentNode.classList.remove('is-loading');"
         onerror="this.parentNode.classList.remove('is-loading');this.style.display='none';" />
    <span class="lb-game-card-play" role="button" tabindex="-1"
          aria-label="Play <%= gcTitle %>"
          data-launch-place-id="<%= gcPlaceId %>"
          data-launch-from-card="1">
      <img class="ch-ico" src="/icons/play.svg" alt="" />
    </span>
  </a>
  <a class="game-name" href="<%= gcHref %>" title="<%= gcTitleAttr %>"><%= gcTitle %></a>
  <div class="game-thumbs-up-down">
<% if (gcVote !== null) { %>
    <span class="vote-percentage-label"><%= gcVote %>%</span>
<% } %>
<% if (gcShowPlaying) { %>
    <span class="player-count" title="<%= gcPlaying %>"><%= gcPlayingText %> playing</span>
<% } %>
  </div>
</div>