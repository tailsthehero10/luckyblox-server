<%#
  Games carousel section - the real 2013 Discover row.

  Structure taken from the 2013 web source in this repo:
    Web-2013 CCS+JS\2013CSS\CSS\Pages\Games\Games.css

  Tag names below are written without angle brackets on purpose: a literal tag
  inside a comment defeats structural checks and makes the real nesting
  impossible to read by eye.

    div.games-list-container
      div.games-list-header              h2  (the row title)
      a.see-all-button                        "See All"
      div.games-list
        div.games-list-row                    (the horizontal scroller)
          div.games-list-column               (202px, holds one tile)
            div.game-item
              a.game-item-image                 (192x108)
              a.game-name                       (the title)
              div.game-thumbs-up-down           (vote % + playing)

  A row renders nothing at all when it has no games, rather than leaving an empty
  frame with a title - an empty carousel is what made the page look broken.

  Expects: section { key, title, seeAllHref }, games (array).
%>
<%
var sec = (typeof section !== 'undefined' && section) ? section : {};
var secGames = Array.isArray(games) ? games : [];
var secTitle = String(sec.title || '');
var secKey = String(sec.key || '');
var secHref = sec.seeAllHref || ('/games?sort=' + encodeURIComponent(secKey));
%>
<% if (secGames.length && secTitle) { %>
<div class="games-list-container" id="games-list-<%= secKey %>">
  <div class="games-list-header">
    <h2><%= secTitle %></h2>
  </div>
  <a class="see-all-button" href="<%= secHref %>">See All</a>

  <div class="games-list">
    <div class="games-list-row">
<% secGames.forEach(function (g) { %>
      <div class="games-list-column">
        <%- include('game-card', { cardGame: g }) %>
      </div>
<% }); %>
    </div>
  </div>
</div>
<% } %>