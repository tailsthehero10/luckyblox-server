<!--
  Games carousel section - the real 2021 Discover row.

  Structure taken from D:\DownLoads\Discover - Roblox.html:

    <div class="games-list-container is-windows">
      <a href=".../discover#/sortName/<key>">
        <div class="container-header games-filter-changer">
          <h3><title></h3>
          <span class="see-all-button games-filter-changer btn-min-width btn-secondary-xs
                       btn-more see-all-link-icon">See All </span>
        </div>
      </a>
      <div class="horizontal-scroller games-list">
        <div class="clearfix horizontal-scroll-window">
          <div class="horizontally-scrollable" style="left: 0px;">
            <ul class="hlist games game-cards game-tile-list">
              <li class="list-item game-card game-tile"> ... </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

  A row renders nothing at all when it has no games, rather than leaving an empty
  frame with a title - an empty carousel is what made the page look broken.

  Expects: section { key, title, seeAllHref }, games (array).
-->
<% var sec=(typeof section !=='undefined' && section) ? section : {}; var secGames=Array.isArray(games) ? games : [];
  var secTitle=String(sec.title || '' ); var secKey=String(sec.key || '' ); var secHref=sec.seeAllHref || ('/games?sort=' + encodeURIComponent(secKey));
%>
<% if (secGames.length && secTitle) { %>
<div class="games-list-container is-windows">
  <a href="<%= secHref %>">
    <div class="container-header games-filter-changer">
      <h3><%= secTitle %></h3>
      <span class="see-all-button games-filter-changer btn-min-width btn-secondary-xs btn-more see-all-link-icon">See All </span>
    </div>
  </a>
  <div class="horizontal-scroller games-list">
    <div class="clearfix horizontal-scroll-window">
      <div class="horizontally-scrollable" style="left: 0px;">
        <ul class="hlist games game-cards game-tile-list">
<% secGames.forEach(function (g) { %>
          <%- include(' game-card', { cardGame: g }) %>
  <% }); %>
    </ul>
    </div>
    </div>
    </div>
    </div>
    <% } %>