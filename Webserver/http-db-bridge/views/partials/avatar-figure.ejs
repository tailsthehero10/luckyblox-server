<%
  // Compact user chips use a real saved headshot or neutral icon. Full previews
  // use the supplied RBXM viewer instead of a drawn stand-in.
  var figSize = (typeof size !== 'undefined' && size) ? Number(size) : 240;
  if (!Number.isFinite(figSize) || figSize <= 0) figSize = 240;
  var figUserObj = (typeof user !== 'undefined' && user) ? user : {};
  var figAvatarObj = figUserObj.avatar && typeof figUserObj.avatar === 'object' ? figUserObj.avatar : {};
  var figImageUrl = String(figUserObj.headshotUrl || figAvatarObj.headshotUrl || '');
  if (!/^https?:\/\//i.test(figImageUrl)
      && !(figImageUrl.charAt(0) === '/' && figImageUrl.charAt(1) !== '/')) figImageUrl = '';
-%>
<div class="lb-avatar-figure lb-avatar-figure--square"
     style="font-size:<%= Math.round((figSize / 10) * 1000) / 1000 %>px;"
     role="img" aria-label="<%= figUserObj.displayName || figUserObj.username || 'User' %> profile picture">
  <img class="lb-user-avatar-placeholder ch-ico" src="/icons/avatar.svg" alt="" aria-hidden="true" />
  <% if (figImageUrl) { %>
    <img class="lb-user-avatar-image" src="<%= figImageUrl %>" alt="" loading="lazy"
         onerror="this.onerror=null;this.remove();" />
  <% } %>
</div>
