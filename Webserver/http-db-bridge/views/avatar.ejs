<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/roblox.css" />
</head>
<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'avatar' }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'avatar' }) %>

      <main class="lb-main">

    <section class="roblox-layout">
      <div class="roblox-panel">
        <div class="roblox-panel-header">Avatar customization</div>
        <div class="roblox-panel-body">
          <div class="roblox-avatar-stage">
            <div class="roblox-avatar-render lb-loading-block is-loading">
              <%# The real avatar, in order of fidelity: the wearer's Roblox full-body
                  render, then the locally drawn figure in their own body colours.
                  The letter tile is only a last resort for an account with no
                  colours at all - it is never the primary render. %>
              <% if (avatar && avatar.fullBodyUrl) { %>
                <img class="lb-avatar-render-img" src="<%= avatar.fullBodyUrl %>"
                  alt="<%= user.username %>'s avatar" width="352" height="352"
                  onerror="this.style.display='none';" />
              <% } else { %>
                <%- lbAvatarFigure(user, 352) %>
              <% } %>
              <div style="font-weight:700; font-size:1.1rem; margin-top: 12px;"><%= user.username %></div>
              <div style="color: var(--rbx-muted);">Currently wearing <%= Array.isArray(wearing) ? wearing.length : 0 %> items</div>
            </div>
          </div>

          <div class="roblox-button-row" style="margin-top: 18px;">
            <button class="roblox-primary-button" id="save-wear" type="button">Save outfit</button>
            <button class="roblox-secondary-button" id="randomize-wear" type="button">Randomize</button>
          </div>
        </div>
      </div>

      <%# "Currently Wearing" - one row per equipped item with its real name, its
          price (or Offsale) and a red X to unequip it, the way the 2021 page
          listed the outfit. Every row is a real item from the account. %>
      <div class="roblox-panel">
        <div class="roblox-panel-header">Currently Wearing</div>
        <div class="roblox-panel-body">
          <% if (wearing && wearing.length) { %>
            <div class="lb-wearing-list">
              <% wearing.forEach(function (item) { %>
                <div class="lb-wearing-row">
                  <div class="lb-wearing-thumb">
                    <% if (item.thumbnailUrl) { %>
                      <img src="<%= item.thumbnailUrl %>" alt="<%= item.name %>" loading="lazy"
                        onerror="this.style.display='none';" />
                    <% } else { %>
                      <span><%= String(item.name || '?').slice(0, 1).toUpperCase() %></span>
                    <% } %>
                  </div>
                  <div class="lb-wearing-info">
                    <div class="lb-wearing-name"><%= item.name %></div>
                    <div class="lb-wearing-type"><%= item.assetType %></div>
                  </div>
                  <button type="button" class="lb-wearing-remove" data-unequip="<%= item.id %>"
                    title="Unequip <%= item.name %>" aria-label="Unequip <%= item.name %>">X</button>
                </div>
              <% }); %>
            </div>
            <div class="lb-faint" style="margin-top:8px;">Click the red X to unequip items.</div>
          <% } else { %>
            <div class="lb-muted">This account is not wearing anything yet. Pick items below and save your outfit.</div>
          <% } %>
        </div>
      </div>

      <div class="roblox-panel">
        <div class="roblox-panel-header">Inventory</div>
        <div class="roblox-panel-body">
          <div class="roblox-asset-grid">
            <% const wearingList = Array.isArray(user.currentlyWearing) ? user.currentlyWearing : []; %>
            <% assets.forEach((asset) => { %>
              <% const isSelected = wearingList.includes(String(asset.id)); %>
              <div class="roblox-asset-card <%= isSelected ? 'selected' : '' %>" data-asset-id="<%= asset.id %>">
                <div class="roblox-asset-preview"><%= asset.name.slice(0, 1).toUpperCase() %></div>
                <div class="roblox-asset-name"><%= asset.name %></div>
                <div class="roblox-asset-type"><%= asset.assetType %> · ID <%= asset.id %></div>
                <button class="roblox-secondary-button" type="button" data-select-asset="<%= asset.id %>"><%= isSelected ? 'Selected' : 'Select' %></button>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    </section>
      </main>
    </div>
  </div>

  <script>
    const userId = '<%= user.userId %>';
    const selected = new Set(<%- JSON.stringify(wearingList || []) %>);

    document.addEventListener('click', async (event) => {
      // Unequip: the red X on a "Currently Wearing" row. Drop the item from the
      // selected set and save the same way the Save outfit button does, so the
      // equipped list and Settings/ stay in sync.
      const unequipButton = event.target.closest('[data-unequip]');
      if (unequipButton) {
        const assetId = String(unequipButton.getAttribute('data-unequip'));
        selected.delete(assetId);

        const response = await fetch('/api/avatar/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ assetIds: Array.from(selected) })
        });

        const payload = await response.json().catch(() => ({}));
        if (payload.ok) {
          window.location.reload();
        } else {
          alert((payload && payload.message) || 'Could not unequip that item. Sign in and try again.');
        }
        return;
      }

      const assetButton = event.target.closest('[data-select-asset]');
      if (assetButton) {
        const assetId = String(assetButton.getAttribute('data-select-asset'));
        if (selected.has(assetId)) {
          selected.delete(assetId);
        } else {
          selected.add(assetId);
        }

        assetButton.textContent = selected.has(assetId) ? 'Selected' : 'Select';
        const card = assetButton.closest('.roblox-asset-card');
        if (card) {
          card.classList.toggle('selected', selected.has(assetId));
        }
        return;
      }

      if (event.target.id === 'save-wear') {
        // Save through /api/avatar/save so the equipped list is written together
        // with the rest of the avatar and mirrored into Settings/ for the clients.
        const response = await fetch('/api/avatar/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ assetIds: Array.from(selected) })
        });

        const payload = await response.json().catch(() => ({}));
        if (payload.ok) {
          window.location.reload();
        } else {
          alert((payload && payload.message) || 'Could not save your avatar. Sign in and try again.');
        }
      }

      if (event.target.id === 'randomize-wear') {
        const items = Array.from(document.querySelectorAll('[data-select-asset]'));
        const randomCount = Math.min(3, items.length);
        selected.clear();

        for (let i = 0; i < randomCount; i += 1) {
          const item = items[Math.floor(Math.random() * items.length)];
          if (!item) continue;
          const assetId = String(item.getAttribute('data-select-asset'));
          selected.add(assetId);
          const card = item.closest('.roblox-asset-card');
          if (card) card.classList.add('selected');
          item.textContent = 'Selected';
        }
      }
    });
  </script>
  <script src="/legacy-nav.js"></script>
</body>
</html>
