<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
</head>

<body>
  <div class="roblox-page">
    <header class="roblox-topbar">
      <div class="roblox-brand">
        <img src="/site-icon/luckyblox.png" alt="LuckyBlox" style="height:28px; width:auto;" />
        <span>LuckyBlox</span>
      </div>
    </header>

    <section class="roblox-hero">
      <div class="roblox-game-icon"
        style="background-image: url('/site-icon/luckyblox.png'); background-size: contain; background-repeat: no-repeat; background-position: center;">
      </div>

      <div>
        <div class="roblox-eyebrow">Live preview</div>
        <div class="roblox-title-block">
          <h1>The server is running.</h1>
        </div>

        <div class="roblox-meta-row">
          <span class="roblox-meta-pill" id="statusState">Checking…</span>
          <span class="roblox-meta-pill">Stage: <%= stage %></span>
          <span class="roblox-meta-pill" id="statusPlayers">Players: –</span>
          <span class="roblox-meta-pill" id="statusGames">Experiences: –</span>
        </div>

        <div class="roblox-description">
          LuckyBlox is being built in the open. This is a live, read-only preview of
          the running server &mdash; it shows that the site is up without revealing
          the features still in progress. Public access opens when the build is finished.
        </div>
      </div>
    </section>

    <section class="roblox-content-grid">
      <div class="roblox-panel" style="grid-column: 1 / -1;">
        <div class="roblox-panel-header">In development</div>
        <div class="roblox-panel-body">
          <div class="roblox-asset-list">
            <% teasers.forEach((item)=> { %>
              <div class="roblox-asset-item">
                <div class="roblox-asset-icon">
                  <%= item.slice(0,1).toUpperCase() %>
                </div>
                <div>
                  <div class="roblox-asset-name">
                    <%= item %>
                  </div>
                  <div class="roblox-asset-type">In progress</div>
                </div>
                <div class="roblox-asset-tag">Soon</div>
              </div>
              <% }) %>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script>
    // Poll the real status endpoint. If it fails we show "offline" —
    // nothing here fabricates a number.
    (function () {
      var stateEl = document.getElementById('statusState');
      var playersEl = document.getElementById('statusPlayers');
      var gamesEl = document.getElementById('statusGames');

      function refresh() {
        fetch('/api/preview-status', { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('bad status')); })
          .then(function (data) {
            stateEl.textContent = data.ok ? 'Online' : 'Degraded';
            playersEl.textContent = 'Players: ' + (typeof data.players === 'number' ? data.players : '–');
            gamesEl.textContent = 'Experiences: ' + (typeof data.games === 'number' ? data.games : '–');
          })
          .catch(function () {
            stateEl.textContent = 'Offline';
          });
      }

      refresh();
      setInterval(refresh, 15000);
    })();
  </script>
</body>

</html>