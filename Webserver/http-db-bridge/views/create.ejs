<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/refresh-2021.css" />
  <link rel="stylesheet" href="/css/roblox-ui.css" />
</head>
  <body>
    <div class="lb-page">
      <%- include('partials/header', { user: user, currency: currency, activeNav: 'create' }) %>

        <div class="lb-shell">
          <%- include('partials/creator-rail', { user: user, activeNav: 'create', studioReady: studioReady }) %>

            <main class="lb-main">
              <!-- Hero -->
              <section class="lb-section">
                <div class="lb-panel-body lb-create-hero">
                  <h1 class="lb-create-hero-title">Create on LuckyBlox</h1>
                  <p class="lb-create-hero-sub">Build experiences, manage places, and publish your work.</p>
                  <div class="lb-action-row">
                    <a class="lb-btn lb-btn-primary" href="/dev/create">Create an experience</a>
                    <a class="lb-btn lb-btn-secondary" href="/develop">Manage experiences</a>
                  </div>
                </div>
              </section>

              <div class="lb-content-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
                <section class="lb-panel">
                  <div class="lb-panel-header"><span>Your experiences</span></div>
                  <div class="lb-panel-body">
                    View your places, update their details, and check the servers currently running them.
                    <div class="lb-action-row" style="margin-top:12px;">
                      <a class="lb-btn lb-btn-secondary" href="/develop">Open My Experiences</a>
                    </div>
                  </div>
                </section>

                <section class="lb-panel">
                  <div class="lb-panel-header"><span>Creator resources</span></div>
                  <div class="lb-panel-body">
                    Upload supported assets and browse the LuckyBlox creator API references.
                    <div class="lb-action-row" style="margin-top:12px;">
                      <a class="lb-btn lb-btn-secondary" href="/dev/assets">Manage assets</a>
                      <a class="lb-btn lb-btn-secondary" href="/dev/docs">Creator docs</a>
                    </div>
                  </div>
                </section>
              </div>

              <!-- Studio status: real host/port from the live runtime, never hardcoded. -->
              <section class="lb-section">
                <div class="lb-panel">
                  <div class="lb-panel-header"><span>LuckyBlox Studio</span></div>
                  <div class="lb-panel-body">
                    <% if (studioReady) { %>
                      <div>
                        Studio is available to launch from this server at
                        <strong>
                          <%= studioHost %>:<%= studioPort %>
                        </strong>.
                      </div>
                      <% } else { %>
                        <div class="lb-muted">
                          Studio is not installed on this server. You can still manage experiences and supported
                          assets from the web tools.
                        </div>
                        <% } %>
                  </div>
                </div>
              </section>

              <section class="lb-section">
                <div class="lb-panel">
                  <div class="lb-panel-header"><span>Need help getting started?</span></div>
                  <div class="lb-panel-body">
                    Open the docs for the APIs and tools available on this LuckyBlox server.
                    <div class="lb-action-row" style="margin-top:12px;">
                      <a class="lb-btn lb-btn-secondary" href="/dev/docs">Browse creator docs</a>
                    </div>
                  </div>
                </div>
              </section>
            </main>
        </div>
    </div>
    <%- include('partials/scripts') %>
    <script>
      // The Creator rail's Studio button opens the desktop Studio app through the
      // same endpoint /develop uses, so both creation surfaces behave identically.
      (function () {
        var btn = document.getElementById('railLaunchStudioBtn');
        if (!btn) return;
        btn.addEventListener('click', async function () {
          try {
            var res = await fetch('/api/studio/launch', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({})
            });
            var data = await res.json();
            if (!res.ok || !data.ok || !data.launched) {
              alert((data && data.message) || 'LuckyBlox Studio is not installed on this machine.');
            }
          } catch (error) {
            alert('Could not reach the server to start Studio.');
          }
        });
      }());
    </script>
  </body>

</html>
