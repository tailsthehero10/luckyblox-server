<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
</head>
<%#
  Friends list. The 2021 page grouped the list by presence with an underlined
  tab bar (Friends / Following / Followers), then one row per friend carrying
  the avatar, the username, the membership and a live presence dot.
%>
<%
  var friendList = Array.isArray(friends) ? friends : [];
  var onlineCount = friendList.filter(function (f) { return f && f.online; }).length;
%>
<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'friends' }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'friends' }) %>

      <main class="lb-main">
        <div class="lb-sort-row">
          <div>
            <h1>Friends</h1>
            <div class="lb-faint">
              <%= friendList.length %> friend<%= friendList.length === 1 ? '' : 's' %>
              &middot; <%= onlineCount %> online
            </div>
          </div>
        </div>

        <section class="lb-panel">
          <div class="lb-panel-header">
            <span>All Friends</span>
            <span class="lb-faint"><%= onlineCount %> online</span>
          </div>
          <div class="lb-panel-body">
            <% if (friendList.length) { %>
              <div class="lb-asset-list">
                <% friendList.forEach(function (friend) { %>
                  <a class="lb-asset-item" href="<%= friend.profileUrl || ('/users/' + friend.userId + '/profile') %>">
                    <div class="lb-asset-icon"><%= String(friend.username || 'F').slice(0, 1).toUpperCase() %></div>
                    <div>
                      <div class="lb-asset-name"><%= friend.username %></div>
                      <div class="lb-asset-type"><%= friend.membership %> &middot; <%= friend.status %></div>
                    </div>
                    <div class="lb-asset-tag">
                      <span class="lb-presence">
                        <span class="lb-presence-dot lb-presence-<%= friend.online ? 'online' : (friend.status === 'away' ? 'away' : 'offline') %>"></span>
                        <%= friend.online ? 'Online' : (friend.status === 'away' ? 'Away' : 'Offline') %>
                      </span>
                    </div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="lb-muted">No friends yet. Add people from their profile page.</div>
            <% } %>
          </div>
        </section>
      </main>
    </div>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>