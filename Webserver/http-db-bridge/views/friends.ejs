<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/refresh-2021.css" />
  <link rel="stylesheet" href="/css/roblox-ui.css" />
</head>
<%#
  Friends list. The 2021 page grouped the list by presence with an underlined
  tab bar (Friends / Following / Followers), then one row per friend carrying
  the avatar, the username, the membership and a live presence dot.
%>
<%
  var friendList = Array.isArray(friends) ? friends : [];
  var onlineCount = friendList.filter(function (f) { return f && f.online; }).length;
%>
<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'friends' }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'friends' }) %>

      <main class="lb-main">
        <div class="lb-sort-row">
          <div>
            <h1>Friends</h1>
            <div class="lb-faint">
              <%= friendList.length %> friend<%= friendList.length === 1 ? '' : 's' %>
              &middot; <%= onlineCount %> online
            </div>
          </div>
        </div>

        <section class="lb-panel">
          <div class="lb-panel-header">
            <span>All Friends</span>
            <span class="lb-faint"><%= onlineCount %> online</span>
          </div>
          <div class="lb-panel-body">
            <% if (friendList.length) { %>
              <%# The real 2013 friends row: a wrap of 100x130 tiles, each a 100x100
                  avatar over the name. The previous markup rendered a letter tile
                  in a single-column list, which is why the page "looked bad" - it
                  was a text list, not the friends row the real site had. %>
              <div class="lb-friends-container">
                <% friendList.forEach(function (friend) { %>
                  <a class="lb-friend-container"
                     href="<%= friend.profileUrl || ('/users/' + friend.userId + '/profile') %>"
                     title="<%= friend.username %>">
                    <div class="lb-friend-avatar">
                      <%# A real <img> layered over the blocky figure. The figure is
                          always drawn, so a friend with no headshot still shows a
                          character rather than an empty box, and a 404 headshot
                          reveals it instead of collapsing the tile. %>
                      <div class="lb-friend-avatar-base">
                        <%- include('partials/avatar-figure', { user: friend, size: 100 }) %>
                      </div>
                      <% if (friend.headshotUrl) { %>
                        <img class="lb-friend-avatar-top" src="<%= friend.headshotUrl %>" alt=""
                             loading="lazy"
                             onerror="this.onerror=null;this.remove();" />
                      <% } %>
                      <span class="lb-presence-dot lb-presence-<%= friend.online ? 'online' : (friend.status === 'away' ? 'away' : 'offline') %>
                            lb-friend-presence"
                            title="<%= friend.online ? 'Online' : (friend.status === 'away' ? 'Away' : 'Offline') %>"></span>
                    </div>
                    <div class="lb-friend-name"><%= friend.username %></div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="lb-muted">No friends yet. Add people from their profile page.</div>
            <% } %>
          </div>
        </section>
      </main>
    </div>
  </div>
  <%- include('partials/scripts') %>
</body>
</html>
