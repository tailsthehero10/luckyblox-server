<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
</head>
<%#
  Game (experience) page, rebuilt against the real 2021 page:
  https://web.archive.org/web/20210206175524/https://www.roblox.com/games/1818/Classic-Crossroads

  The 2021 layout was a two-column body:

    LEFT   the game CARD (1:1) with the green Play button over it, then the
           About / Store / Servers underline tabs. Under About: the full stat
           grid (Playing, Visits, Favorites, Created, Updated, Genre).
    RIGHT  the game icon, the title, "By <creator>", the Playing / Favorites /
           Visits stats, the like/dislike bar with its percentage, the Favorite
           button, the Server Size and Genre rows, then the Description section.

  The left column is a square card, not a wide banner. Game artwork on LuckyBlox
  is the square Card_512x512 icon, so the frame is 1:1 and the art is fitted
  inside it (object-fit: contain). The placeholder art that ships in the repo is
  NOT actually 512x512 - Card_512x512/*.png is 236x236 and Big_/* is 596x335 - so
  a 16:9 frame used to letterbox the square icon into grey bars.

  There is deliberately ONE Play button on this page (the one overlaid on the
  card). An earlier revision had a second, smaller Play button in the right
  column; the real page has only the one.

  Every number is real: games.json, places.json, or the live orchestrator.
%>
<%
  var g = game || {};
  var tabs = [
    { key: 'about',   label: 'About' },
    { key: 'store',   label: 'Store' },
    { key: 'servers', label: 'Servers' }
  ];
  var currentTab = (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'about';
  var iconUrl = (typeof gameIcon !== 'undefined' && gameIcon) ? gameIcon : '/gameplaceholder/card.png';
  // There is deliberately NO separate wide thumbnail. The page's card artwork is
  // the square game icon (game.icon), layered over /gameplaceholder/card.png by
  // the markup below. A `thumbUrl` used to default to the WIDE
  // '/gameplaceholder/big.png' here, which is how every experience ended up
  // showing the same 596x335 banner in a card that is meant to be square.
  var serverList = (typeof servers !== 'undefined' && servers) ? servers : [];
  var votePct = (typeof likesPercent !== 'undefined' && likesPercent) ? likesPercent : 0;
  var voteTotal = (Number(likes) || 0) + (Number(dislikes) || 0);
%>
<body>
  <div class="lb-page">
    <%- include('partials/header', {
      user: user,
      currency: currency,
      activeNav: 'games'
    }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'games' }) %>

      <main class="lb-main">
        <div class="lb-game-hero">
          <!-- Left: the thumbnail with the Play button over it -->
          <div>
            <!--
              The thumbnail is the page's heaviest asset, so it is wrapped in a
              loading block: the big spinner covers it until the real artwork
              arrives. lb-loader-md is set here (rather than the 28px default)
              because the thumbnail is large and a small glyph over it reads as
              noise.
            -->
            <div class="lb-game-thumb lb-loading-block is-loading" id="gameThumbBlock" style="--lb-loader-size:64px;">
              <!--
                The card art, layered like the home hero: the game's own artwork on
                top of the placeholder. If the game's art 404s it hides itself and
                the placeholder under it is revealed, instead of leaving the square
                frame as an empty grey box.
              -->
              <% if (game.icon && /^\/|^https?:\/\//.test(game.icon)) { %>
                <img class="roblox-game-thumb-img roblox-game-thumb-top" src="<%= game.icon %>"
                     alt="<%= g.title %> card"
                     id="gameThumb"
                     onerror="this.style.display='none';var b=document.getElementById('gameThumbBlock');if(b)b.classList.remove('is-loading');" />
              <% } %>
              <img class="roblox-game-thumb-img roblox-game-thumb-base" src="/gameplaceholder/card.png"
                   alt="<%= g.title %>" id="gameThumbFallback" />
              <button class="lb-btn lb-btn-primary roblox-play-button" type="button"
                      id="playBtn" data-launch-place-id="<%= placeId %>">
                <img class="ch-ico" src="/icons/play.svg" alt="" /> Play
              </button>
            </div>

            <!-- About / Store / Servers underline tabs -->
            <div class="lb-tabs" style="margin-top:16px;">
              <ul class="lb-tabs-inner" role="tablist">
                <% tabs.forEach(function (t) { %>
                  <li>
                    <a class="lb-tab <%= currentTab === t.key ? 'is-active' : '' %>" role="tab"
                       href="/game/<%= placeId %>?tab=<%= t.key %>"><%= t.label %></a>
                  </li>
                <% }); %>
              </ul>
            </div>

            <% if (currentTab === 'about') { %>
              <section class="lb-panel">
                <div class="lb-panel-header"><span>About</span></div>
                <div class="lb-panel-body">
                  <%# The description lives in its own section in the right column,
                      exactly where the 2021 page put it, so it is not repeated
                      here. This tab carries the full game-stat grid instead. %>
                  <div class="lb-game-stats">
                    <!--
                      "Playing" is the one figure on this page that changes while
                      the page is open, so it is wrapped in a loading overlay: the
                      spinner covers the number during a refresh instead of the
                      number silently changing under the reader's eye.
                    -->
                    <div class="lb-game-stat lb-loading-overlay" id="playingStat" style="--lb-loader-size:28px;">
                      <span class="lb-game-stat-value" data-playing-value><%= abbreviateCount(playing) %></span>
                      <span class="lb-game-stat-label">Playing</span>
                    </div>
                    <div class="lb-game-stat">
                      <span class="lb-game-stat-value"><%= abbreviateCount(visits) %></span>
                      <span class="lb-game-stat-label">Visits</span>
                    </div>
                    <div class="lb-game-stat">
                      <span class="lb-game-stat-value"><%= abbreviateCount(favorites) %></span>
                      <span class="lb-game-stat-label">Favorites</span>
                    </div>
                    <div class="lb-game-stat">
                      <span class="lb-game-stat-value"><%= formatGameDate(createdAt) %></span>
                      <span class="lb-game-stat-label">Created</span>
                    </div>
                    <div class="lb-game-stat">
                      <span class="lb-game-stat-value"><%= formatGameDate(updatedAt) %></span>
                      <span class="lb-game-stat-label">Updated</span>
                    </div>
                    <div class="lb-game-stat">
                      <span class="lb-game-stat-value"><%= genre %></span>
                      <span class="lb-game-stat-label">Genre</span>
                    </div>
                  </div>

                  <div class="lb-game-meta-list" style="margin-top:14px;">
                    <div class="lb-game-meta-row"><span>Place ID</span><strong><%= placeId %></strong></div>
                    <div class="lb-game-meta-row"><span>Creator</span><strong><%= creatorName %></strong></div>
                    <div class="lb-game-meta-row"><span>Active servers</span><strong><%= serverCount %></strong></div>
                  </div>

                  <% if (Array.isArray(g.tags) && g.tags.length) { %>
                    <div class="lb-meta-row" style="margin-top:12px;">
                      <% g.tags.forEach(function (tag) { %>
                        <span class="lb-pill"><%= tag %></span>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </section>

            <% } else if (currentTab === 'store') { %>
              <section class="lb-panel">
                <div class="lb-panel-header"><span>Store</span></div>
                <div class="lb-panel-body">
                  <%# Only real, owned assets are listed. The account has no
                      game-pass model in the data files, so this says so
                      instead of showing invented passes at invented prices. %>
                  <div class="lb-muted">This experience does not offer any passes or items for sale yet.</div>
                </div>
              </section>

            <% } else { %>
              <section class="lb-panel">
                <div class="lb-panel-header">
                  <span>Servers</span>
                  <span class="lb-faint"><%= serverCount %> active</span>
                </div>
                <div class="lb-panel-body">
                  <% if (serverList.length) { %>
                    <div class="lb-asset-list">
                      <% serverList.forEach(function (srv) { %>
                        <div class="lb-asset-item">
                          <div class="lb-asset-icon"><%= srv.playing %></div>
                          <div>
                            <div class="lb-asset-name"><%= srv.playing %> of <%= srv.maxPlayers %> players</div>
                            <div class="lb-asset-type"><%= srv.status || 'running' %> &middot; port <%= srv.port %></div>
                          </div>
                          <div class="lb-asset-tag"><%= (srv.jobId || '').slice(0, 8) %></div>
                        </div>
                      <% }); %>
                    </div>
                  <% } else { %>
                    <div class="lb-muted">No servers are running for this experience right now. Be the first to play.</div>
                  <% } %>
                </div>
              </section>
            <% } %>
          </div>

          <!-- Right: icon, title, byline, votes, favourite, server size, genre,
               description - the order the real 2021 page used. -->
          <div class="lb-game-info">
            <div class="lb-game-head">
              <div class="lb-game-icon" style="background-image:url('<%= iconUrl %>');" aria-label="Game icon"></div>
              <div>
                <h1 class="lb-game-title"><%= g.title %></h1>
                <div class="lb-game-byline">By <strong><%= creatorName %></strong></div>
              </div>
            </div>

            <div class="lb-game-stats">
              <div class="lb-game-stat">
                <span class="lb-game-stat-value"><%= abbreviateCount(playing) %></span>
                <span class="lb-game-stat-label">Playing</span>
              </div>
              <div class="lb-game-stat">
                <span class="lb-game-stat-value"><%= abbreviateCount(favorites) %></span>
                <span class="lb-game-stat-label">Favorites</span>
              </div>
              <div class="lb-game-stat">
                <span class="lb-game-stat-value"><%= abbreviateCount(visits) %></span>
                <span class="lb-game-stat-label">Visits</span>
              </div>
            </div>

            <!-- Voting: the 2021 like bar with the thumb buttons and the
                 percentage, then the separate Favorite action. -->
            <div class="lb-vote-block">
              <button class="lb-vote-btn" type="button" title="Vote up" aria-label="Vote up">
                <img class="ch-ico" src="/icons/like.svg" alt="" />
              </button>
              <div class="lb-vote-bar-wrap">
                <div class="lb-bar"><div class="lb-bar-fill" style="width:<%= votePct %>%;"></div></div>
                <div class="lb-vote-pct"><%= votePct %>%</div>
              </div>
              <button class="lb-vote-btn" type="button" title="Vote down" aria-label="Vote down">
                <img class="ch-ico lb-ico-flip" src="/icons/like.svg" alt="" />
              </button>
            </div>
            <% if (voteTotal > 0) { %>
              <div class="lb-faint">
                <%= likes %> like<%= likes === 1 ? '' : 's' %> &middot; <%= dislikes %> dislike<%= dislikes === 1 ? '' : 's' %>
              </div>
            <% } %>

            <div class="lb-action-row">
              <button class="lb-btn lb-btn-secondary lb-fav-btn" type="button" id="favBtn">
                <img class="ch-ico" src="/icons/star.svg" alt="" /> Favorite
              </button>
            </div>

            <!--
              There is deliberately NO second Play button here.

              The real 2021 game page had exactly ONE: the green button overlaid
              on the thumbnail (see .lb-game-thumb above). This column carried the
              Favorite action only. A duplicate Play button here meant two
              controls doing the same thing at different sizes, which is not what
              the reference page looked like.
            -->

            <!-- Server Size and Genre, exactly the two rows the real page used. -->
            <section class="lb-panel">
              <div class="lb-panel-body">
                <div class="lb-game-meta-list">
                  <div class="lb-game-meta-row"><span>Server Size</span><strong><%= maxPlayers %></strong></div>
                  <div class="lb-game-meta-row"><span>Genre</span><strong><%= genre %></strong></div>
                </div>
              </div>
            </section>

            <section class="lb-panel">
              <div class="lb-panel-header"><span>Description</span></div>
              <div class="lb-panel-body">
                <div class="lb-description"><%= g.description || 'No description has been provided for this experience.' %></div>
              </div>
            </section>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%
  /* The game page is the one page that fetches its own live data after paint
     (the running server list and the player count), so it needs the shared
     loading UI. Loaded here rather than globally so a page that never waits on
     the server pays nothing for it. */
  %>
  <%- include('partials/scripts') %>
  <script>
    (function () {
      var loading = window.LBLoading;

      // --- Thumbnail ---------------------------------------------------------
      // The block is server-rendered with .is-loading so the spinner is already up
      // during the image request; drop it when the artwork settles.
      //
      // The game's own art and the placeholder under it are separate elements, and
      // a game may have neither as far as JS is concerned, so this waits on every
      // image in the block rather than on one hardcoded id - otherwise a game with
      // no icon of its own would spin forever, because the element the old code
      // looked for was never rendered.
      var thumbBlock = document.getElementById('gameThumbBlock');
      if (thumbBlock) {
        var thumbImages = thumbBlock.querySelectorAll('img');
        var clearThumb = function () { thumbBlock.classList.remove('is-loading'); };
        var remaining = thumbImages.length;

        if (remaining === 0) {
          clearThumb();
        } else {
          thumbImages.forEach(function (img) {
            var settle = function () {
              remaining -= 1;
              if (remaining <= 0) clearThumb();
            };
            // A cached image has already finished, so it will never fire load.
            if (img.complete) {
              settle();
              return;
            }
            img.addEventListener('load', settle, { once: true });
            img.addEventListener('error', settle, { once: true });
          });
        }
      }

      // --- Live player count -------------------------------------------------
      // /api/servers is the authoritative number for THIS place. The server-
      // rendered figure can be stale by the time the page is read, and the page
      // used to never refresh it at all - so "3 Playing" stayed 3 forever.
      var playingStat = document.getElementById('playingStat');
      var playingValue = document.querySelector('[data-playing-value]');
      var placeId = <%= Number(placeId) || 1818 %>;

      function abbreviate(n) {
        var value = Number(n) || 0;
        if (value >= 1000000) return (Math.round(value / 100000) / 10) + 'M';
        if (value >= 1000) return (Math.round(value / 100) / 10) + 'K';
        return String(value);
      }

      function refreshPlaying() {
        if (!playingValue || document.hidden) return;

        if (loading && playingStat) loading.block(playingStat);
        fetch('/api/servers?placeId=' + encodeURIComponent(placeId), {
          headers: { Accept: 'application/json' },
        })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (data) {
            if (!data || !Array.isArray(data.servers)) return;
            var total = data.servers.reduce(function (sum, s) {
              return sum + (Number(s.playing) || 0);
            }, 0);
            playingValue.textContent = abbreviate(total);
          })
          .catch(function () { /* leave the last known figure in place */ })
          .finally(function () {
            if (loading && playingStat) loading.blockOff(playingStat);
          });
      }

      // Refresh once shortly after load, then on an interval while the tab is
      // visible. The 30s period matches how often the orchestrator's figures
      // can meaningfully change without hammering the endpoint.
      window.setTimeout(refreshPlaying, 1200);
      window.setInterval(refreshPlaying, 30000);
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) refreshPlaying();
      });
    }());
  </script>
  <script>
    // Favorite is a local toggle: the data files have no favourites model, so the
    // button reflects the click instead of pretending a server round-trip.
    (function () {
      var fav = document.getElementById('favBtn');
      if (!fav) return;
      fav.addEventListener('click', function () {
        fav.classList.toggle('is-on');
        fav.lastChild.textContent = fav.classList.contains('is-on') ? ' Favorited' : ' Favorite';
      });
    }());
  </script>
  <script>
    // Launch through the same endpoint and delegated handler the rest of the
    // site uses. The old inline handler posted to /v1/launch-client, which does
    // not exist on this server, and hardcoded placeId '2022M' regardless of the
    // game being viewed.
    document.addEventListener('click', async (event) => {
      const trigger = event.target.closest('[data-launch-place-id]');
      if (!trigger) return;

      const loading = window.LBLoading;

      // The launch call starts the client AND the match the ticket belongs to,
      // which takes a moment. During it the whole page is waiting, so the big
      // spinner comes up with a status line instead of the button appearing to
      // do nothing until the client window finally opens.
      if (loading) loading.show('Starting LuckyBlox\u2026');
      if (loading) loading.button(trigger, true);

      try {
        const placeId = Number(trigger.getAttribute('data-launch-place-id')) || 1818;
        const response = await fetch('/api/launch-game', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ placeId })
        });

        const data = await response.json();

        // Playing needs an account: send guests to sign in, then back here.
        if (response.status === 401 || (data && data.error === 'sign-in-required')) {
          if (loading) loading.hideAll();
          const next = encodeURIComponent(window.location.pathname + window.location.search);
          window.location.href = '/signin?redirect=' + next;
          return;
        }

        if (!response.ok || !data || !data.ok || !data.ticket) {
          if (loading) loading.hideAll();
          alert((data && data.message) || 'Unable to generate a launch ticket.');
          return;
        }

        // The local client was launched automatically when it is installed.
        if (data.nativeLaunch && data.nativeLaunch.status === 'launched') {
          // Leave the veil up briefly: the client is still connecting to the
          // game server, so dropping it instantly reads as "nothing happened".
          if (loading) loading.hideAll();
          return;
        }

        // Not installed: offer the custom installer, then the browser hand-off.
        if (data.client && !data.client.installed && data.client.downloadUrl) {
          if (loading) loading.hideAll();
          var goDownload = window.confirm(
            'The LuckyBlox client is not installed.\n\nDownload it now?'
          );
          if (goDownload) {
            window.location.href = data.client.downloadUrl;
            return;
          }
        }

        // Fall back to the play page, which still offers the browser hand-off.
        if (data.playUrl) {
          window.location.href = data.playUrl;
        } else if (data.launchURI) {
          window.location.href = data.launchURI;
        } else if (loading) {
          loading.hideAll();
        }
      } catch (error) {
        if (loading) loading.hideAll();
        alert('LuckyBlox failed to launch.');
      } finally {
        if (loading) loading.button(trigger, false);
      }
    });
  </script>
</body>
</html>
