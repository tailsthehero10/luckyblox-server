<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/roblox.css" />
</head>
<body>
    <div class="roblox-page">
    <header class="roblox-topbar">
      <div class="roblox-brand">
        <img class="roblox-brand-mark" src="/site-icon/luckyblox.png" alt="LuckyBlox" />
        <span>LuckyBlox</span>
      </div>

      <nav class="roblox-nav" aria-label="Main navigation">
        <div class="roblox-nav-links">
          <a href="/">Home</a>
          <a href="/games">Games</a>
        </div>
      </nav>

      <div class="roblox-right">
        <span class="roblox-robux"><%= (user && (user.robux || 0)) || 0 %></span>
        <a class="roblox-icon-button" href="/account" title="Account settings" aria-label="Account settings">&#9881;</a>
        <a class="roblox-icon-button" href="/friends" title="Friends" aria-label="Friends">&#128101;</a>
        <a class="roblox-icon-button" href="/profile?userId=<%= user.userId %>" title="Profile" aria-label="Profile">@</a>
      </div>
    </header>

    <section class="roblox-hero">
        <div class="roblox-game-icon" aria-label="Game icon"></div>
        <div>
            <div class="roblox-eyebrow">Experience</div>
            <div class="roblox-title-block">
                <h1><%= game.title %></h1>
                <button class="roblox-play-button" type="button" data-launch-place-id="<%= placeId %>">Play</button>
            </div>
            <div class="roblox-meta-row">
                <span class="roblox-meta-pill">Developer: <%= game.developer %></span>
                <span class="roblox-meta-pill">Players: <%= game.playerCount %></span>
                <span class="roblox-meta-pill">Genre: <%= game.genre %></span>
                <span class="roblox-meta-pill">Favorites: <%= game.favorites %></span>
            </div>
            <div class="roblox-description"><%= game.description %></div>
        </div>
    </section>
    </div>

    <script>
        // Launch through the same endpoint and delegated handler the rest of the
        // site uses. The old inline handler posted to /v1/launch-client, which does
        // not exist on this server, and hardcoded placeId '2022M' regardless of the
        // game being viewed.
        document.addEventListener('click', async (event) => {
            const trigger = event.target.closest('[data-launch-place-id]');
            if (!trigger) return;

            try {
                const placeId = Number(trigger.getAttribute('data-launch-place-id')) || 1818;
                const response = await fetch('/api/launch-game', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ placeId })
                });

                const data = await response.json();
                if (!response.ok || !data || !data.ok || !data.ticket) {
                    alert((data && data.message) || 'Unable to generate a launch ticket.');
                    return;
                }

                if (data.playUrl) {
                    window.location.href = data.playUrl;
                } else if (data.launchURI) {
                    window.location.href = data.launchURI;
                }
            } catch (error) {
                alert('LuckyBlox failed to launch.');
            }
        });
    </script>
<script src="/legacy-nav.js"></script>
</body>
</html>
