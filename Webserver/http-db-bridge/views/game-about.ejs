<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/roblox.css" />
</head>
<body>
    <div class="roblox-page">
    <header class="roblox-topbar">
      <a class="roblox-brand" href="/" aria-label="LuckyBlox home">
        <img class="roblox-brand-mark" src="/site-icon/luckyblox.png" alt="LuckyBlox" />
        <span>LuckyBlox</span>
      </a>

      <nav class="roblox-nav" aria-label="Main navigation">
        <div class="roblox-nav-links">
          <a href="/">Home</a>
          <a href="/games">Games</a>
        </div>
      </nav>

      <div class="roblox-right">
        <span class="roblox-robux"><%= (user && (user.robux || 0)) || 0 %></span>
        <a class="roblox-icon-button" href="/account" title="Account settings" aria-label="Account settings"><img class="ch-ico" src="/icons/settings.svg" alt="" /></a>
        <a class="roblox-icon-button" href="/friends" title="Friends" aria-label="Friends"><img class="ch-ico" src="/icons/friends.svg" alt="" /></a>
        <a class="roblox-icon-button" href="/profile?userId=<%= user.userId %>" title="Profile" aria-label="Profile"><img class="ch-ico" src="/icons/profile.svg" alt="" /></a>
      </div>
    </header>

    <section class="roblox-game-hero">
      <div class="roblox-game-thumb" aria-label="Game thumbnail">
        <img class="roblox-game-thumb-img" src="<%= gameThumb %>" alt="<%= game.title %> thumbnail" onerror="this.style.display='none';" />
        <button class="roblox-play-button" type="button" data-launch-place-id="<%= placeId %>"><img class="ch-ico" src="/icons/play.svg" alt="" /> Play</button>
      </div>

      <div class="roblox-game-info">
        <div class="roblox-game-head">
          <div class="roblox-game-icon" style="background-image:url('<%= gameIcon %>');" aria-label="Game icon"></div>
          <div>
            <h1 class="roblox-game-title"><%= game.title %></h1>
            <div class="roblox-game-byline">By <strong><%= creatorName %></strong></div>
          </div>
        </div>

        <div class="roblox-game-stats">
          <div class="roblox-game-stat"><span class="roblox-game-stat-value"><%= playing %></span><span class="roblox-game-stat-label">Playing</span></div>
          <div class="roblox-game-stat"><span class="roblox-game-stat-value"><%= favorites %></span><span class="roblox-game-stat-label">Favorites</span></div>
          <div class="roblox-game-stat"><span class="roblox-game-stat-value"><%= likes %></span><span class="roblox-game-stat-label">Likes</span></div>
        </div>

        <div class="roblox-game-actions">
          <button class="roblox-play-button" type="button" data-launch-place-id="<%= placeId %>"><img class="ch-ico" src="/icons/play.svg" alt="" /> Play</button>
          <a class="roblox-secondary-button" href="/games">Back to games</a>
        </div>
      </div>
    </section>

    <section class="roblox-game-body">
      <div class="roblox-panel">
        <div class="roblox-panel-header">About</div>
        <div class="roblox-panel-body">
          <div class="roblox-description"><%= game.description %></div>
          <div class="roblox-game-meta-list">
            <div class="roblox-game-meta-row"><span>Genre</span><strong><%= game.genre %></strong></div>
            <div class="roblox-game-meta-row"><span>Created</span><strong><%= createdAt ? new Date(createdAt).toLocaleDateString() : 'Unknown' %></strong></div>
            <div class="roblox-game-meta-row"><span>Last updated</span><strong><%= updatedAt ? new Date(updatedAt).toLocaleDateString() : 'Unknown' %></strong></div>
            <div class="roblox-game-meta-row"><span>Place ID</span><strong><%= placeId %></strong></div>
          </div>
        </div>
      </div>

      <div class="roblox-panel">
        <div class="roblox-panel-header">Servers</div>
        <div class="roblox-panel-body">
          <% if (playing > 0) { %>
            <div class="roblox-muted"><%= playing %> player<%= playing === 1 ? '' : 's' %> across active servers.</div>
          <% } else { %>
            <div class="roblox-muted">No players online right now. Be the first to play!</div>
          <% } %>
        </div>
      </div>
    </section>
    </div>

    <script>
        // Launch through the same endpoint and delegated handler the rest of the
        // site uses. The old inline handler posted to /v1/launch-client, which does
        // not exist on this server, and hardcoded placeId '2022M' regardless of the
        // game being viewed.
        document.addEventListener('click', async (event) => {
            const trigger = event.target.closest('[data-launch-place-id]');
            if (!trigger) return;

            try {
                const placeId = Number(trigger.getAttribute('data-launch-place-id')) || 1818;
                const response = await fetch('/api/launch-game', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ placeId })
                });

                const data = await response.json();

                // Playing needs an account: send guests to sign in, then back here.
                if (response.status === 401 || (data && data.error === 'sign-in-required')) {
                    const next = encodeURIComponent(window.location.pathname + window.location.search);
                    window.location.href = '/signin?redirect=' + next;
                    return;
                }

                if (!response.ok || !data || !data.ok || !data.ticket) {
                    alert((data && data.message) || 'Unable to generate a launch ticket.');
                    return;
                }

                if (data.playUrl) {
                    window.location.href = data.playUrl;
                } else if (data.launchURI) {
                    window.location.href = data.launchURI;
                }
            } catch (error) {
                alert('LuckyBlox failed to launch.');
            }
        });
    </script>
<script src="/legacy-nav.js"></script>
</body>
</html>
