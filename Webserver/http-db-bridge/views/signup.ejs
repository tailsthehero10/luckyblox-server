<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/refresh-2021.css" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<%# Create account - matching the REAL 2021 Roblox sign-up page. Same rules as the sign-in page (the real site used one
  shared auth stylesheet for both), quoted from D:\DownLoads\Discover - Roblox_files\5eb9680d...b2d42.css:
  .login-container{margin:0 auto;max-width:400px} .login-container .login-header{margin-bottom:18px;text-align:center}
  .login-container .username-form-group{margin-bottom:18px} The real create-account form was, top to bottom: Birthday -
  three side-by-side dropdowns (Month / Day / Year) Username - text field Password - password field Gender - optional
  select [Sign Up] - the green submit terms line - the fine print under the button NOTE: the real 2021 form asked for
  BIRTHDAY FIRST, before the username - that order is kept here because it is what the reference shows. Expects: title,
  errorMessage, username, redirect, csrfToken. %>

  <body class="auth-page<%= (typeof themeOn !== 'undefined' && themeOn) ? ' dark-theme' : '' %>">

    <div class="auth-container">

      <div class="auth-header">
        <a href="/" aria-label="LuckyBlox home">
          <img class="auth-logo" src="/site-icon/luckyblox.png" alt="LuckyBlox" />
        </a>
        <h1 class="auth-title">Sign Up</h1>
        <p class="auth-subtitle">Create a LuckyBlox account</p>
      </div>

      <% if (errorMessage) { %>
        <div class="auth-error" role="alert">
          <%= errorMessage %>
        </div>
        <% } %>

          <form method="POST" action="/signup" id="signupForm" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
            <% if (redirect) { %>
              <input type="hidden" name="redirect" value="<%= redirect %>" />
              <% } %>

                <%# Birthday first, exactly as the real form ordered it. Three dropdowns in a row, not a single date
                  input. %>
                  <div class="auth-field">
                    <label class="auth-label" for="birthMonth">Birthday</label>
                    <div class="auth-birthday">
                      <select class="auth-select" id="birthMonth" name="birthMonth" aria-label="Birth month" required>
                        <option value="">Month</option>
                        <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(function
                          (m, i) { %>
                          <option value="<%= i + 1 %>">
                            <%= m %>
                          </option>
                          <% }); %>
                      </select>
                      <select class="auth-select" id="birthDay" name="birthDay" aria-label="Birth day" required>
                        <option value="">Day</option>
                        <% for (var d=1; d <=31; d++) { %>
                          <option value="<%= d %>">
                            <%= d %>
                          </option>
                          <% } %>
                      </select>
                      <select class="auth-select" id="birthYear" name="birthYear" aria-label="Birth year" required>
                        <option value="">Year</option>
                        <% var thisYear=new Date().getFullYear(); for (var y=thisYear; y>= thisYear - 100; y--) { %>
                          <option value="<%= y %>">
                            <%= y %>
                          </option>
                          <% } %>
                      </select>
                    </div>
                  </div>

                  <div class="auth-field">
                    <label class="auth-label" for="username">Username</label>
                    <input class="auth-input" id="username" name="username" type="text" value="<%= username || '' %>"
                      autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="20" required />
                    <div class="auth-help">3-20 characters. Letters, numbers and underscores.</div>
                  </div>

                  <div class="auth-field">
                    <label class="auth-label" for="password">Password</label>
                    <input class="auth-input" id="password" name="password" type="password" autocomplete="new-password"
                      required />
                    <div class="auth-help">At least 8 characters.</div>
                  </div>

                  <div class="auth-field auth-field--last">
                    <label class="auth-label" for="confirmPassword">Confirm Password</label>
                    <input class="auth-input" id="confirmPassword" name="confirmPassword" type="password"
                      autocomplete="new-password" required />
                  </div>

                  <div class="auth-field">
                    <label class="auth-label" for="gender">Gender <span class="auth-help">(optional)</span></label>
                    <select class="auth-select" id="gender" name="gender">
                      <option value="NotSpecified">Not specified</option>
                      <option value="Male">Male</option>
                      <option value="Female">Female</option>
                    </select>
                  </div>

                  <button class="auth-submit" type="submit" id="signupSubmit">Sign Up</button>

                  <p class="auth-terms">
                    By clicking Sign Up, you are agreeing to the LuckyBlox Terms of Use and
                    Privacy Policy. This is a private, local deployment and is not affiliated
                    with Roblox Corporation.
                  </p>
          </form>

          <div class="auth-signup-option">
            <span class="no-account-text">Already have an account?</span>
            <a class="auth-signup-link"
              href="/signin<%= redirect ? ('?redirect=' + encodeURIComponent(redirect)) : '' %>">Sign In</a>
          </div>

    </div>

    <script>
      // Client-side pre-check only; the server re-validates everything.
      (function () {
        var form = document.getElementById('signupForm');
        var btn = document.getElementById('signupSubmit');
        if (!form) return;

        function mark(el, bad) {
          if (!el) return;
          if (bad) el.classList.add('input-error');
          else el.classList.remove('input-error');
        }

        form.addEventListener('submit', function () {
          var u = document.getElementById('username');
          var p = document.getElementById('password');
          var cp = document.getElementById('confirmPassword');
          var bm = document.getElementById('birthMonth');
          var bd = document.getElementById('birthDay');
          var by = document.getElementById('birthYear');
          var valid = true;

          if (!bm.value || !bd.value || !by.value) {
            mark(bm, true); mark(bd, true); mark(by, true); valid = false;
          } else {
            mark(bm, false); mark(bd, false); mark(by, false);
          }

          var name = u.value.trim();
          if (name.length < 3 || name.length > 20) { mark(u, true); valid = false; }
          else { mark(u, false); }

          if (p.value.length < 8) { mark(p, true); valid = false; }
          else { mark(p, false); }

          if (p.value !== cp.value) { mark(cp, true); valid = false; }
          else { mark(cp, false); }

          if (!valid) return false;

          btn.disabled = true;
          btn.textContent = 'Creating Account...';
          return true;
        });
      }());
    </script>

    <%- include('partials/scripts') %>
  </body>

</html>
