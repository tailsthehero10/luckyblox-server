<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
</head>
<%#
  Profile page, rebuilt against the real 2021 page structure:
  https://web.archive.org/web/20210321200603/https://www.roblox.com/users/1/profile/

  What the real page rendered, top to bottom:

    header        avatar headshot, display name + username, then three counters
                  (Friends / Followers / Following), then Add Friend / Message
    tab bar       "About" and "Creations" - an underlined tab bar, not pills
    About tab     About section (bio + Read More + report link),
                  "Currently Wearing" (avatar figure on the left, an 8-slot
                  grid of equipped item thumbnails on the right),
                  then Collections, Groups, Badges and the Statistics section
    Creations tab a "Games" grid, ~4 tiles per row, each showing the 16:9
                  thumbnail, the name and a votes% / playing count row

  Every number below comes from users.json / places.json. Nothing is invented.
%>
<%
  var s = user.stats || {};
  var fCount = (typeof friendsCount !== 'undefined' && friendsCount) ? friendsCount : (Array.isArray(user.friends) ? user.friends.length : 0);
  var folCount = (typeof followersCount !== 'undefined' && followersCount) ? followersCount : (s.followers || 0);
  var folgCount = (typeof followingCount !== 'undefined' && followingCount) ? followingCount : (s.following || 0);
  var visitTotal = (typeof visitsCount !== 'undefined' && visitsCount) ? visitsCount : (s.gameVisits || 0);
  var wornItems = (typeof wearing !== 'undefined' && wearing) ? wearing : [];
  var activeTab = (typeof tab !== 'undefined' && tab) ? tab : 'about';
  var creations = (typeof publishedGames !== 'undefined' && publishedGames) ? publishedGames : [];
  var badgeList = Array.isArray(user.badges) ? user.badges : [];

  // Avatar sources. resolveProfileAvatar() only fills these when the account is
  // linked to a real Roblox user id and Roblox answered; otherwise they are null
  // and the page draws the local blocky figure from the saved body colours.
  var headshot = (typeof profileAvatar !== 'undefined' && profileAvatar) ? profileAvatar.headshotUrl : null;
  var fullBody = (typeof profileAvatar !== 'undefined' && profileAvatar) ? profileAvatar.fullBodyUrl : null;
  var wornFromApi = (typeof profileAvatar !== 'undefined' && profileAvatar && profileAvatar.equipped && profileAvatar.equipped.length)
    ? profileAvatar.equipped : null;
  if (wornFromApi) wornItems = wornFromApi;
%>
<body>
  <div class="lb-page">
    <%- include('partials/header', {
      user: user,
      currency: currency,
      activeNav: 'profile'
    }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'profile' }) %>

      <main class="lb-main">
        <!-- Profile header: headshot, name, counters, actions -->
        <section class="lb-profile-header">
          <div class="lb-avatar-stage">
            <% if (headshot || fullBody) { %>
              <img class="roblox-avatar-image" src="<%= headshot || fullBody %>" alt="<%= user.username %>"
                   onerror="this.style.display='none';var f=this.parentNode.querySelector('.lb-avatar-figure');if(f)f.style.display='block';" />
              <div style="display:none;"><%= lbAvatarFigure(user, 150) %></div>
            <% } else { %>
              <%= lbAvatarFigure(user, 150) %>
            <% } %>
          </div>

          <div>
            <div class="lb-profile-name">
              <span><%= user.displayName || user.username %></span>
              <% if (adminBadge && adminBadge.label) { %>
                <span class="lb-pill"><%= adminBadge.label %></span>
              <% } %>
            </div>
            <% if ((user.displayName || user.username) !== user.username) { %>
              <div class="lb-faint">@<%= user.username %></div>
            <% } %>

            <ul class="lb-counter-row">
              <li class="lb-counter">
                <span class="lb-counter-value" title="<%= fCount %>"><%= abbreviateCount(fCount) %></span>
                <span class="lb-counter-label">Friends</span>
              </li>
              <li class="lb-counter">
                <span class="lb-counter-value" title="<%= folCount %>"><%= abbreviateCount(folCount) %></span>
                <span class="lb-counter-label">Followers</span>
              </li>
              <li class="lb-counter">
                <span class="lb-counter-value" title="<%= folgCount %>"><%= abbreviateCount(folgCount) %></span>
                <span class="lb-counter-label">Following</span>
              </li>
            </ul>

            <div class="lb-meta-row">
              <span class="lb-pill">Joined <%= formatJoinDate(user.joinDate) %></span>
              <span class="lb-pill">ID <%= user.userId %></span>
              <span class="lb-pill"><%= user.membershipStatus || user.membership || 'None' %></span>
              <span class="lb-pill">
                <img class="ch-ico ch-ico-sm ch-ico--ink" src="/icons/robux.svg" alt="" />
                <%= currency ? currency.robux : (user.robux || 0) %>
              </span>
            </div>

            <div class="lb-action-row">
              <a class="lb-btn lb-btn-secondary" href="/users/<%= user.userId %>/friends">Friends</a>
              <a class="lb-btn lb-btn-secondary" href="/avatar?userId=<%= user.userId %>">Customize Avatar</a>
              <a class="lb-btn lb-btn-secondary" href="/account?userId=<%= user.userId %>">Account</a>
            </div>
          </div>
        </section>

        <!-- Tab bar: About | Creations -->
        <div class="lb-tabs">
          <ul class="lb-tabs-inner" role="tablist">
            <li>
              <a class="lb-tab <%= activeTab === 'about' ? 'is-active' : '' %>"
                 role="tab" href="/users/<%= user.userId %>/profile" id="tab-about">About</a>
            </li>
            <li>
              <a class="lb-tab <%= activeTab === 'creations' ? 'is-active' : '' %>"
                 role="tab" href="/users/<%= user.userId %>/profile?tab=creations" id="tab-creations">Creations</a>
            </li>
          </ul>
        </div>

        <% if (activeTab === 'creations') { %>
        <!-- Creations tab -->
        <section class="lb-panel">
          <div class="lb-panel-header">
            <span>Games</span>
            <span class="lb-faint"><%= creations.length %> public</span>
          </div>
          <div class="lb-panel-body">
            <% if (creations.length) { %>
              <div class="lb-game-grid">
                <% creations.forEach(function (game) { %>
                  <a class="lb-game-card" href="/game/<%= game.placeId %>">
                    <div class="lb-game-card-thumb">
                      <% if (game.coverUrl && /^\/|^https?:\/\//.test(game.coverUrl)) { %>
                        <img src="<%= game.coverUrl %>" alt="<%= game.name %>" loading="lazy"
                             onerror="this.style.display='none';var p=this.parentNode;if(p)p.classList.add('is-placeholder');" />
                      <% } %>
                      <img class="roblox-game-card-placeholder" src="/gameplaceholder/card.png" alt="" loading="lazy" />
                    </div>
                    <div class="lb-game-card-title"><%= game.name %></div>
                    <div class="lb-game-card-sub"><%= game.genre || 'Adventure' %> &middot; <%= Number(game.playerCount) || 0 %> playing</div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="lb-muted">This account has not published any public games yet.</div>
            <% } %>
          </div>
        </section>

        <% } else { %>
        <!-- About tab -->
        <section class="lb-panel">
          <div class="lb-panel-header"><span>About</span></div>
          <div class="lb-panel-body">
            <div class="lb-bio"><%= user.bio || 'This user has not written a description yet.' %></div>
            <div class="lb-meta-row" style="margin-top:12px;">
              <span class="lb-pill">Joined <%= formatJoinDate(user.joinDate) %></span>
              <span class="lb-pill" title="<%= visitTotal %>">Place Visits <%= abbreviateCount(visitTotal) %></span>
            </div>
          </div>
        </section>

        <!-- Currently Wearing: avatar figure + equipped item grid -->
        <section class="lb-panel">
          <div class="lb-panel-header">
            <span>Currently Wearing</span>
            <span class="lb-faint"><%= wornItems.length %> item<%= wornItems.length === 1 ? '' : 's' %></span>
          </div>
          <div class="lb-panel-body">
            <div class="lb-content-grid">
              <div>
                <div class="lb-avatar-stage" style="width:100%;height:260px;">
                  <% if (fullBody) { %>
                    <img class="roblox-avatar-image roblox-avatar-image-large" src="<%= fullBody %>" alt="<%= user.username %> avatar"
                         onerror="this.style.display='none';var f=this.parentNode.querySelector('.lb-avatar-figure');if(f)f.style.display='block';" />
                  <% } else { %>
                    <%= lbAvatarFigure(user, 220) %>
                  <% } %>
                </div>
                <div class="lb-faint" style="text-align:center;margin-top:8px;"><%= user.username %></div>
              </div>

              <div>
                <% if (wornItems.length) { %>
                  <%# The real page showed 8 accoutrement slots per page. %>
                  <% var shown = wornItems.slice(0, 8); %>
                  <div class="lb-wearing-grid">
                    <% shown.forEach(function (item) { %>
                      <div class="lb-wearing-item">
                        <div class="lb-wearing-thumb">
                          <% if (item.thumbnailUrl) { %>
                            <img src="<%= item.thumbnailUrl %>" alt="<%= item.name %>" loading="lazy"
                                 onerror="this.style.display='none';this.parentNode.textContent='<%= String(item.name || '?').slice(0, 1).toUpperCase() %>';" />
                          <% } else { %>
                            <%= String(item.name || '?').slice(0, 1).toUpperCase() %>
                          <% } %>
                        </div>
                        <div class="lb-wearing-name" title="<%= item.name %>"><%= item.name %></div>
                      </div>
                    <% }); %>
                  </div>
                  <% if (wornItems.length > 8) { %>
                    <div class="lb-faint" style="margin-top:10px;">
                      Showing 8 of <%= wornItems.length %> equipped items.
                    </div>
                  <% } %>
                <% } else { %>
                  <div class="lb-muted">Nothing equipped yet &mdash; open the Avatar page to dress this character.</div>
                <% } %>
              </div>
            </div>
          </div>
        </section>

        <!-- Statistics / Currency -->
        <div class="lb-content-grid">
          <section class="lb-panel">
            <div class="lb-panel-header"><span>Statistics</span></div>
            <div class="lb-panel-body">
              <div class="lb-stat-list">
                <span>Friends</span><strong><%= fCount %></strong>
                <span>Followers</span><strong><%= folCount %></strong>
                <span>Following</span><strong><%= folgCount %></strong>
                <span>Games Played</span><strong><%= Number(s.plays) || 0 %></strong>
                <span>Place Visits</span><strong><%= visitTotal %></strong>
                <span>Created</span><strong><%= Number(s.created) || 0 %></strong>
                <span>Badges</span><strong><%= badgeList.length %></strong>
              </div>
            </div>
          </section>

          <section class="lb-panel">
            <div class="lb-panel-header"><span>Currency</span></div>
            <div class="lb-panel-body">
              <div class="lb-stat-list">
                <span>Robux</span><strong><%= currency ? currency.robux : (user.robux || 0) %></strong>
                <span>Coins</span><strong><%= currency ? currency.coins : 0 %></strong>
                <span>Tickets</span><strong><%= currency ? currency.tickets : 0 %></strong>
                <span>Inventory</span><strong><%= Array.isArray(user.inventory) ? user.inventory.length : 0 %> items</strong>
              </div>
            </div>
          </section>
        </div>

        <section class="lb-panel">
          <div class="lb-panel-header">
            <span>Friends</span>
            <span class="lb-faint">
              <%= fCount %>
              <% if (friends && friends.length) { %>(<%= friends.filter(function (f) { return f.online; }).length %> online)<% } %>
            </span>
          </div>
          <div class="lb-panel-body">
            <% if (friends && friends.length) { %>
              <div class="lb-asset-list">
                <% friends.forEach(function (friend) { %>
                  <a class="lb-asset-item" href="<%= friend.profileUrl %>">
                    <div class="lb-asset-icon"><%= String(friend.username || 'F').slice(0, 1).toUpperCase() %></div>
                    <div>
                      <div class="lb-asset-name"><%= friend.username %></div>
                      <div class="lb-asset-type"><%= friend.membership %> &middot; <%= friend.status %></div>
                    </div>
                    <div class="lb-asset-tag"><%= friend.online ? 'Online' : (friend.status === 'away' ? 'Away' : 'Offline') %></div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="lb-muted">No friends yet.</div>
            <% } %>
          </div>
        </section>

        <section class="lb-panel">
          <div class="lb-panel-header"><span>Badges (<%= badgeList.length %>)</span></div>
          <div class="lb-panel-body">
            <% if (badgeList.length) { %>
              <div class="lb-wearing-grid">
                <% badgeList.forEach(function (badge) { %>
                  <div class="lb-wearing-item">
                    <div class="lb-wearing-thumb"><%= String(badge.icon || badge.name || 'B').slice(0, 1).toUpperCase() %></div>
                    <div class="lb-wearing-name" title="<%= badge.description || '' %>"><%= badge.name %></div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="lb-muted">No badges yet.</div>
            <% } %>
          </div>
        </section>
        <% } %>
      </main>
    </div>
  </div>
  <script src="/legacy-nav.js"></script>
</body>
</html>
