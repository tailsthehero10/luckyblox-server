<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title><%= title %></title>
  <style>
    :root {
      --bg: #0b0e14;
      --panel: #141922;
      --edge: #232b39;
      --text: #e8edf6;
      --muted: #8593a8;
      --green: #00b06f;
      --blue: #4c9aff;
      --amber: #ffb020;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      min-height: 100%;
      background: radial-gradient(1200px 600px at 50% -10%, #172033 0%, var(--bg) 60%);
      color: var(--text);
      font-family: "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
      overflow-x: hidden;
    }

    /* Everything is inside this shell. There is deliberately no navigation,
       no header links, and no way to reach the rest of the site from here. */
    .preview-shell {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 32px 20px 48px;
      gap: 26px;
      text-align: center;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-size: 0.95rem;
      color: var(--muted);
    }

    .brand-mark {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      background: linear-gradient(135deg, #3d7dff 0%, #1f4fd8 100%);
      color: #fff;
      font-size: 1rem;
      letter-spacing: 0;
      box-shadow: 0 8px 22px rgba(61, 125, 255, 0.35);
    }

    .preview-card {
      width: min(720px, 100%);
      background: linear-gradient(180deg, rgba(20, 25, 34, 0.92) 0%, rgba(16, 20, 28, 0.92) 100%);
      border: 1px solid var(--edge);
      border-radius: 20px;
      padding: 40px 34px 34px;
      box-shadow: 0 30px 70px rgba(0, 0, 0, 0.55);
      position: relative;
      overflow: hidden;
    }

    .preview-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        repeating-linear-gradient(90deg, rgba(255,255,255,0.02) 0 1px, transparent 1px 34px),
        repeating-linear-gradient(0deg, rgba(255,255,255,0.02) 0 1px, transparent 1px 34px);
      pointer-events: none;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      border: 1px solid rgba(0, 176, 111, 0.4);
      background: rgba(0, 176, 111, 0.12);
      color: #6ee7b7;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      position: relative;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 0 rgba(0, 176, 111, 0.7);
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(0, 176, 111, 0.7); }
      70%  { box-shadow: 0 0 0 9px rgba(0, 176, 111, 0); }
      100% { box-shadow: 0 0 0 0 rgba(0, 176, 111, 0); }
    }

    h1 {
      margin: 20px 0 10px;
      font-size: clamp(1.9rem, 5vw, 2.9rem);
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1.1;
      position: relative;
    }

    .lead {
      margin: 0 auto;
      max-width: 46ch;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.65;
      position: relative;
    }

    /* Live status grid — pulls real values from the server, no fake numbers. */
    .status-grid {
      margin-top: 30px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 12px;
      position: relative;
    }

    .status-tile {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--edge);
      border-radius: 12px;
      padding: 14px 12px;
    }

    .status-label {
      display: block;
      font-size: 0.66rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 6px;
    }

    .status-value {
      font-size: 1.12rem;
      font-weight: 800;
      color: var(--text);
    }

    .status-value.good { color: #6ee7b7; }
    .status-value.warn { color: var(--amber); }

    /* Teaser marquee that hints at progress without revealing the actual work. */
    .teaser {
      margin-top: 26px;
      position: relative;
      overflow: hidden;
      border: 1px solid var(--edge);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.02);
      padding: 12px 0;
    }

    .teaser-track {
      display: inline-flex;
      gap: 40px;
      white-space: nowrap;
      animation: scroll 26s linear infinite;
      font-size: 0.86rem;
      color: var(--muted);
      font-weight: 600;
    }

    .teaser-track span { opacity: 0.85; }

    @keyframes scroll {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    .teaser::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgba(20,25,34,1) 0%, transparent 12%, transparent 88%, rgba(20,25,34,1) 100%);
      pointer-events: none;
    }

    .footer-note {
      margin-top: 26px;
      font-size: 0.78rem;
      color: var(--muted);
      position: relative;
      line-height: 1.7;
    }

    .footer-note code {
      background: rgba(255, 255, 255, 0.06);
      padding: 2px 7px;
      border-radius: 5px;
      font-size: 0.75rem;
      color: var(--blue);
    }

    @media (prefers-reduced-motion: reduce) {
      .teaser-track { animation: none; }
      .pulse-dot { animation: none; }
    }
  </style>
</head>
<body>
  <main class="preview-shell">
    <div class="brand">
      <span class="brand-mark">R</span>
      <span>LuckyBlox</span>
    </div>

    <section class="preview-card">
      <span class="badge"><span class="pulse-dot"></span> Live preview</span>

      <h1>The server is running.</h1>
      <p class="lead">
        LuckyBlox is being built in the open. This is a live, read-only preview of
        the running server &mdash; it shows that the site is up without revealing
        the features still in progress.
      </p>

      <div class="status-grid">
        <div class="status-tile">
          <span class="status-label">Server</span>
          <span class="status-value good" id="statusState">Checking…</span>
        </div>
        <div class="status-tile">
          <span class="status-label">Online players</span>
          <span class="status-value" id="statusPlayers">–</span>
        </div>
        <div class="status-tile">
          <span class="status-label">Experiences</span>
          <span class="status-value" id="statusGames">–</span>
        </div>
        <div class="status-tile">
          <span class="status-label">Build stage</span>
          <span class="status-value warn" id="statusStage"><%= stage %></span>
        </div>
      </div>

      <div class="teaser" aria-hidden="true">
        <div class="teaser-track">
          <% teasers.concat(teasers).forEach((item) => { %>
            <span><%= item %></span>
          <% }) %>
        </div>
      </div>

      <p class="footer-note">
        Public site access is disabled until the build is finished.<br />
        Preview expires automatically when <code>LUCKYBLOX_PREVIEW_MODE</code> is turned off.
      </p>
    </section>
  </main>

  <script>
    // Poll the real status endpoint. If it fails we just show "offline" —
    // nothing here fabricates a number.
    (function () {
      var stateEl = document.getElementById('statusState');
      var playersEl = document.getElementById('statusPlayers');
      var gamesEl = document.getElementById('statusGames');

      function refresh() {
        fetch('/api/preview-status', { headers: { Accept: 'application/json' } })
          .then(function (r) { return r.ok ? r.json() : Promise.reject(new Error('bad status')); })
          .then(function (data) {
            stateEl.textContent = data.ok ? 'Online' : 'Degraded';
            stateEl.className = 'status-value ' + (data.ok ? 'good' : 'warn');
            playersEl.textContent = typeof data.players === 'number' ? data.players : '–';
            gamesEl.textContent = typeof data.games === 'number' ? data.games : '–';
          })
          .catch(function () {
            stateEl.textContent = 'Offline';
            stateEl.className = 'status-value warn';
          });
      }

      refresh();
      setInterval(refresh, 15000);
    })();
  </script>
</body>
</html>