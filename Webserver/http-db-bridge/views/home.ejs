<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/refresh-2021.css" />
  <link rel="stylesheet" href="/css/roblox-ui.css" />
  <%# games.css carries the game-carousel layout (.games-list-row, .game-item,
      .games-list-column) that this page renders via partials/games-carousel. It
      was not linked here, so every rule in it was absent and the rows fell back to
      unstyled block flow: 36 tiles stacked vertically down a 3,156px-tall column
      instead of scrolling sideways. The page LOOKED like a list, not an error. %>
  <link rel="stylesheet" href="/css/games.css" />
</head>
<%#
  Home / Discover. The real 2021 home page was a sidebar plus a grid of game
  cards under section headings ("Popular", "Top Rated", "Recommended").
  https://web.archive.org/web/20210605202558/https://www.roblox.com/
%>
<%
  var homeGames = Array.isArray(games) ? games : [];
%>
<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'home' }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'home' }) %>

      <main class="lb-main">
        <%#
          Friends, as a horizontal row at the TOP of the page.

          The 2021 home page opened with the friend list across the top - it is the
          first thing a signed-in player sees, and it was previously buried in a
          panel beside the account card at the bottom, where a long page pushed it
          off-screen. A horizontal strip reads as "who is online" at a glance.
        %>
        <% if (friends && friends.length) { %>
        <section class="lb-friends-strip">
          <div class="lb-friends-strip-head">
            <span class="lb-friends-strip-title">Friends</span>
            <span class="lb-friends-strip-count"><%= friends.length %></span>
          </div>
          <div class="lb-friends-strip-row">
            <% friends.forEach(function (friend) { %>
              <a class="lb-friend-chip<%= friend.online ? ' is-online' : '' %>"
                 href="<%= friend.profileUrl %>" title="<%= friend.username %>">
                <span class="lb-friend-chip-avatar">
                  <% if (friend.headshotUrl) { %>
                    <img src="<%= friend.headshotUrl %>" alt="" loading="lazy"
                         onerror="this.style.display='none';" />
                  <% } else { %>
                    <%= String(friend.username || 'F').slice(0, 1).toUpperCase() %>
                  <% } %>
                </span>
                <span class="lb-friend-chip-name"><%= friend.username %></span>
                <span class="lb-friend-chip-dot" aria-hidden="true"></span>
              </a>
            <% }); %>
          </div>
        </section>
        <% } %>

        <section class="lb-hero">
          <!--
            The featured game's artwork, as a SQUARE card (1:1), matching the game
            cards and the game page - one artwork shape everywhere.

            It is a real <img> rather than a background-image so the shared loading
            spinner can cover it while it loads.

            The placeholder art is a SIBLING under the real art, not an either/or
            branch: the real art is layered on top and, if it 404s, it hides itself
            and the placeholder underneath is revealed. An either/or branch would
            only cover a game with NO icon at all and would leave a game with a
            broken icon URL showing an empty grey box.

            NOTE: the block is marked is-loading on the server so the spinner is up
            during the first paint, which means something MUST take it off again.
            It is cleared by the small script at the end of this page (see
            lb-hero-art handling), NOT by legacy-nav.js - that only decorates images
            it finds itself, so a pre-marked block would spin forever.
          -->
          <div class="lb-hero-art lb-loading-block is-loading" id="heroArtBlock"
               style="--lb-loader-size:40px;">
            <% if (featuredGame.icon && /^\/|^https?:\/\//.test(featuredGame.icon)) { %>
              <img class="lb-hero-art-img lb-hero-art-top" id="heroArt"
                   src="<%= featuredGame.icon %>"
                   alt="<%= featuredGame.title %>" loading="lazy"
                   onerror="this.style.display='none';var b=document.getElementById('heroArtBlock');if(b)b.classList.remove('is-loading');" />
            <% } %>
            <img class="lb-hero-art-img lb-hero-art-base" src="/gameplaceholder/card.png"
                 alt="<%= featuredGame.title %>" id="heroArtBase" />
          </div>
          <div>
            <div class="lb-eyebrow">Featured Experience</div>
            <div class="lb-title-block">
              <h1><%= featuredGame.title %></h1>
              <button class="lb-btn lb-btn-primary lb-play-icon-only" type="button"
                      data-launch-place-id="<%= featuredGame.placeId %>"
                      aria-label="Play <%= featuredGame.title %>" title="Play">
                <img class="ch-ico" src="/icons/play.svg" alt="" />
              </button>
            </div>
            <div class="lb-meta-row">
              <span class="lb-pill">By <%= featuredGame.developer %></span>
              <span class="lb-pill"><%= Number(featuredGame.playerCount) || 0 %> playing</span>
              <span class="lb-pill"><%= featuredGame.genre %></span>
              <span class="lb-pill"><%= Number(featuredGame.favorites) || 0 %> favorites</span>
            </div>
            <div class="lb-description"><%= featuredGame.description %></div>
            <div class="lb-action-row">
              <a class="lb-btn lb-btn-secondary" href="/game/<%= featuredGame.placeId %>">About this experience</a>
            </div>
          </div>
        </section>

        <%#
          The game rows, built from the REAL 2013 markup and CSS
          (Web-2013 CCS+JS\2013CSS\CSS\Pages\Games\Games.css).

          Each row is a horizontal strip of 192x144 tiles, exactly as the real
          Discover page was - the same partial the /games page uses, so the two
          pages can never drift apart.

          A row renders nothing when it has no games, rather than leaving an
          empty frame with a title.
        %>
        <div class="games-lists-container">
<% homeSections.forEach(function (section) { %>
          <%- include('partials/games-carousel', { section: section, games: section.games }) %>
<% }); %>
        </div>

        <% if (!homeSections.length) { %>
        <section class="lb-panel">
          <div class="lb-panel-body">
            <div class="lb-muted">No experiences have been published yet.</div>
          </div>
        </section>
        <% } %>

        <div class="lb-content-grid">
          <section class="lb-panel">
            <div class="lb-panel-header"><span>Account</span></div>
            <div class="lb-panel-body">
<% if (user) { %>
              <div class="lb-stat-list">
                <span>Username</span><strong><%= user.username %></strong>
                <span>Membership</span><strong><%= user.membershipStatus || user.membership || 'None' %></strong>
                <span>Robux</span><strong><%= currency ? currency.robux : (user.robux || 0) %></strong>
                <span>Friends</span><strong><%= Array.isArray(user.friends) ? user.friends.length : 0 %></strong>
              </div>
              <div class="lb-action-row">
                <a class="lb-btn lb-btn-secondary" href="/users/<%= user.userId %>/profile">View Profile</a>
                <a class="lb-btn lb-btn-secondary" href="/develop">Create</a>
              </div>
<% } else { %>
              <%# A guest. Show a sign-in prompt rather than somebody else's account. %>
              <div class="lb-muted">Sign in to see your account, friends and creations.</div>
              <div class="lb-action-row">
                <a class="lb-btn lb-btn-primary" href="/signin">Log In</a>
                <a class="lb-btn lb-btn-secondary" href="/signup">Sign Up</a>
              </div>
<% } %>
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>

  <%# The shared scripts load HERE, above the inline launch handler, because that
      handler calls window.LBLoading. Loading them at the very bottom of the page
      (after the inline script) would leave LBLoading undefined at the moment the
      handler is defined. %>
  <%- include('partials/scripts') %>
  <script>
    async function launchGame(placeId) {
      var loading = window.LBLoading;
      if (loading) loading.show('Starting LuckyBlox\u2026');
      try {
        const response = await fetch('/api/launch-game', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ placeId })
        });

        const payload = await response.json();

        // Playing needs an account: send guests to sign in, then back here.
        if (response.status === 401 || (payload && payload.error === 'sign-in-required')) {
          const next = encodeURIComponent(window.location.pathname + window.location.search);
          window.location.href = '/signin?redirect=' + next;
          return null;
        }

        if (!response.ok || !payload.ok || !payload.ticket) {
          throw new Error(payload && payload.message ? payload.message : 'Unable to generate launch ticket.');
        }

        // The local client was launched automatically when it is installed.
        if (payload.nativeLaunch && payload.nativeLaunch.status === 'launched') {
          return payload;
        }

        // This request reaches the website server, which cannot start a process
        // on the visitor's computer. Hand the signed ticket to the local player
        // protocol instead of navigating back to the site's /play or /games page.
        if (payload.launchURI && /^luckyblox-player:/i.test(payload.launchURI)) {
          window.location.href = payload.launchURI;
          return payload;
        }

        // Not installed: offer the custom installer rather than sending the
        // visitor to a website page that cannot launch the desktop process.
        if (payload.client && !payload.client.installed && payload.client.downloadUrl) {
          if (window.confirm('The LuckyBlox client is not installed.\n\nDownload it now?')) {
            window.location.href = payload.client.downloadUrl;
            return payload;
          }
        }

        alert('LuckyBlox could not open the desktop client. Install or repair the client, then try Play again.');
        return payload;
      } catch (error) {
        console.error('Launch failure:', error);
        alert('LuckyBlox failed to launch the game.');
        return null;
      } finally {
        // Every exit path - success, sign-in redirect, download prompt, even the
        // throw above - clears the veil here, so the page can never be left stuck
        // behind the spinner. A navigation replaces the page anyway, and the
        // bfcache restore is handled in loading.js.
        if (loading) loading.hideAll();
      }
    }

    document.addEventListener('click', async (event) => {
      const trigger = event.target.closest('[data-launch-place-id]');
      if (!trigger) return;

      // A card's play button sits INSIDE the card's <a>, so without this the
      // browser would follow the link to the game page instead of starting the
      // game. Stopping propagation here keeps the click on the grid and launches
      // in place, which is what the button appears to promise.
      if (trigger.getAttribute('data-launch-from-card') === '1') {
        event.preventDefault();
        event.stopPropagation();
      }

      const placeId = Number(trigger.getAttribute('data-launch-place-id')) || 1818;
      await launchGame(placeId);
    });

    // --- Featured hero artwork ------------------------------------------------
    // The block is rendered is-loading so the spinner is up during the first
    // paint. Something has to take it off, and this is that something: the image
    // is lazy, so waiting for it is the correct signal, and a cached image that
    // will never fire `load` is handled by the `complete` check.
    (function () {
      var block = document.getElementById('heroArtBlock');
      if (!block) return;

      var clear = function () { block.classList.remove('is-loading'); };
      var imgs = block.querySelectorAll('img');
      var remaining = imgs.length;

      if (remaining === 0) {
        clear();
        return;
      }

      imgs.forEach(function (img) {
        var settle = function () {
          remaining -= 1;
          if (remaining <= 0) clear();
        };
        if (img.complete) {
          settle();
          return;
        }
        img.addEventListener('load', settle, { once: true });
        img.addEventListener('error', settle, { once: true });
      });
    }());
  </script>
</body>
</html>
