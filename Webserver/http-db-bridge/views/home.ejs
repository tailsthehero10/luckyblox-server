<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
</head>
<%#
  Home / Discover. The real 2021 home page was a sidebar plus a grid of game
  cards under section headings ("Popular", "Top Rated", "Recommended").
  https://web.archive.org/web/20210605202558/https://www.roblox.com/
%>
<%
  var homeGames = Array.isArray(games) ? games : [];
%>
<body>
  <div class="lb-page">
    <%- include('partials/header', { user: user, currency: currency, activeNav: 'home' }) %>

    <div class="lb-shell">
      <%- include('partials/sidebar', { user: user, activeNav: 'home' }) %>

      <main class="lb-main">
        <section class="lb-hero">
          <!--
            The featured game's artwork, as a SQUARE card (1:1), matching the game
            cards and the game page - one artwork shape everywhere.

            It is a real <img> rather than a background-image so the shared loading
            spinner (decorateLoadingImages in legacy-nav.js) can cover it while it
            loads.

            The placeholder art is a SIBLING under the real art, not an either/or
            branch: the real art is layered on top and, if it 404s, it hides itself
            and the placeholder underneath is revealed. An either/or branch would
            only cover a game with NO icon at all and would leave a game with a
            broken icon URL showing an empty grey box.
          -->
          <div class="lb-hero-art lb-loading-block is-loading" style="--lb-loader-size:40px;">
            <% if (featuredGame.icon && /^\/|^https?:\/\//.test(featuredGame.icon)) { %>
              <img class="lb-hero-art-img lb-hero-art-top" src="<%= featuredGame.icon %>"
                   alt="<%= featuredGame.title %>" loading="lazy"
                   onerror="this.style.display='none';" />
            <% } %>
            <img class="lb-hero-art-img lb-hero-art-base" src="/gameplaceholder/card.png"
                 alt="<%= featuredGame.title %>" loading="lazy" />
          </div>
          <div>
            <div class="lb-eyebrow">Featured Experience</div>
            <div class="lb-title-block">
              <h1><%= featuredGame.title %></h1>
              <button class="lb-btn lb-btn-primary" type="button" data-launch-place-id="<%= featuredGame.placeId %>">
                <img class="ch-ico" src="/icons/play.svg" alt="" /> Play
              </button>
            </div>
            <div class="lb-meta-row">
              <span class="lb-pill">By <%= featuredGame.developer %></span>
              <span class="lb-pill"><%= Number(featuredGame.playerCount) || 0 %> playing</span>
              <span class="lb-pill"><%= featuredGame.genre %></span>
              <span class="lb-pill"><%= Number(featuredGame.favorites) || 0 %> favorites</span>
            </div>
            <div class="lb-description"><%= featuredGame.description %></div>
            <div class="lb-action-row">
              <a class="lb-btn lb-btn-secondary" href="/game/<%= featuredGame.placeId %>">About this experience</a>
            </div>
          </div>
        </section>

        <section class="lb-panel">
          <div class="lb-panel-header">
            <span>Popular</span>
            <span class="lb-faint"><%= homeGames.length %> experience<%= homeGames.length === 1 ? '' : 's' %></span>
          </div>
          <div class="lb-panel-body">
            <% if (homeGames.length) { %>
              <div class="lb-game-grid">
                <% homeGames.forEach(function (game) { %>
                  <a class="lb-game-card" href="/game/<%= game.placeId %>">
                    <!--
                      A SQUARE card (1:1), matching the game page and the featured
                      hero: game artwork is always a square icon, so it is never
                      shown as a wide banner.

                      The game's own art is layered ON TOP of the placeholder card,
                      so a game with no icon shows real art and a game whose icon
                      URL 404s reveals the placeholder instead of an empty box. The
                      onerror also marks the frame .is-placeholder, which hides the
                      broken image outright.

                      These are lazy images, so the shared loading block
                      (decorateLoadingImages in legacy-nav.js) covers the tile while
                      it loads. The size is raised from the 28px default because a
                      card tile is a large, empty surface and a small glyph in the
                      middle of it reads as a broken image.
                    -->
                    <div class="lb-game-card-thumb" style="--lb-loader-size:44px;">
                      <% if (game.icon && /^\/|^https?:\/\//.test(game.icon) && game.icon.indexOf('unsplash') === -1) { %>
                        <img src="<%= game.icon %>" alt="<%= game.title %>" loading="lazy"
                             onerror="this.style.display='none';var p=this.parentNode;if(p)p.classList.add('is-placeholder');" />
                      <% } %>
                      <img class="roblox-game-card-placeholder" src="/gameplaceholder/card.png" alt="" loading="lazy" />
                    </div>
                    <div class="lb-game-card-title"><%= game.title %></div>
                    <div class="lb-game-card-sub"><%= game.genre %> &middot; <%= Number(game.playerCount) || 0 %> playing</div>
                  </a>
                <% }); %>
              </div>
            <% } else { %>
              <div class="lb-muted">No experiences have been published yet.</div>
            <% } %>
          </div>
        </section>

        <div class="lb-content-grid">
          <section class="lb-panel">
            <div class="lb-panel-header"><span>Friends</span></div>
            <div class="lb-panel-body">
              <% if (friends && friends.length) { %>
                <div class="lb-asset-list">
                  <% friends.forEach(function (friend) { %>
                    <a class="lb-asset-item" href="<%= friend.profileUrl %>">
                      <div class="lb-asset-icon"><%= String(friend.username || 'F').slice(0, 1).toUpperCase() %></div>
                      <div>
                        <div class="lb-asset-name"><%= friend.username %></div>
                        <div class="lb-asset-type"><%= friend.status %></div>
                      </div>
                      <div class="lb-asset-tag"><%= friend.online ? 'Online' : 'Offline' %></div>
                    </a>
                  <% }); %>
                </div>
              <% } else { %>
                <div class="lb-muted">No friends yet.</div>
              <% } %>
            </div>
          </section>

          <section class="lb-panel">
            <div class="lb-panel-header"><span>Account</span></div>
            <div class="lb-panel-body">
              <div class="lb-stat-list">
                <span>Username</span><strong><%= user.username %></strong>
                <span>Membership</span><strong><%= user.membershipStatus || user.membership || 'None' %></strong>
                <span>Robux</span><strong><%= currency ? currency.robux : (user.robux || 0) %></strong>
                <span>Friends</span><strong><%= Array.isArray(user.friends) ? user.friends.length : 0 %></strong>
              </div>
              <div class="lb-action-row">
                <a class="lb-btn lb-btn-secondary" href="/users/<%= user.userId %>/profile">View Profile</a>
                <a class="lb-btn lb-btn-secondary" href="/develop">Create</a>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>
  </div>

  <%# The shared scripts load HERE, above the inline launch handler, because that
      handler calls window.LBLoading. Loading them at the very bottom of the page
      (after the inline script) would leave LBLoading undefined at the moment the
      handler is defined. %>
  <%- include('partials/scripts') %>
  <script>
    async function launchGame(placeId) {
      var loading = window.LBLoading;
      if (loading) loading.show('Starting LuckyBlox\u2026');
      try {
        const response = await fetch('/api/launch-game', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ placeId })
        });

        const payload = await response.json();

        // Playing needs an account: send guests to sign in, then back here.
        if (response.status === 401 || (payload && payload.error === 'sign-in-required')) {
          const next = encodeURIComponent(window.location.pathname + window.location.search);
          window.location.href = '/signin?redirect=' + next;
          return null;
        }

        if (!response.ok || !payload.ok || !payload.ticket) {
          throw new Error(payload && payload.message ? payload.message : 'Unable to generate launch ticket.');
        }

        // The local client was launched automatically when it is installed.
        if (payload.nativeLaunch && payload.nativeLaunch.status === 'launched') {
          return payload;
        }

        // Not installed: offer the custom installer before falling back.
        if (payload.client && !payload.client.installed && payload.client.downloadUrl) {
          if (window.confirm('The LuckyBlox client is not installed.\n\nDownload it now?')) {
            window.location.href = payload.client.downloadUrl;
            return payload;
          }
        }

        if (payload.playUrl) {
          window.location.href = payload.playUrl;
        } else if (payload.launchURI) {
          window.location.href = payload.launchURI;
        }

        return payload;
      } catch (error) {
        console.error('Launch failure:', error);
        alert('LuckyBlox failed to launch the game.');
        return null;
      } finally {
        // Every exit path - success, sign-in redirect, download prompt, even the
        // throw above - clears the veil here, so the page can never be left stuck
        // behind the spinner. A navigation replaces the page anyway, and the
        // bfcache restore is handled in loading.js.
        if (loading) loading.hideAll();
      }
    }

    document.addEventListener('click', async (event) => {
      const trigger = event.target.closest('[data-launch-place-id]');
      if (!trigger) return;

      const placeId = Number(trigger.getAttribute('data-launch-place-id')) || 1818;
      await launchGame(placeId);
    });
  </script>
</body>
</html>
