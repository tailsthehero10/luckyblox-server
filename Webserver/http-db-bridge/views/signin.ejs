<!DOCTYPE html>
<html lang="en" class="<%= themeClass || '' %>">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    <%= title %>
  </title>
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="stylesheet" href="/css/roblox.css" />
  <link rel="stylesheet" href="/css/refresh-2021.css" />
  <link rel="stylesheet" href="/css/auth.css" />
</head>
<%# Sign in - matching the REAL 2021 Roblox login page. Rules copied from the real 2021 stylesheet shipped with the
  saved pages (D:\DownLoads\Discover - Roblox_files\5eb9680d...b2d42.css): .login-container{margin:0
  auto;max-width:400px} .login-container .login-header{margin-bottom:18px;text-align:center} .login-container
  .username-form-group{margin-bottom:18px} .login-container .password-form-group{margin-bottom:0} .login-container
  .login-button{margin:6px 0 12px} .login-container .forgot-credentials-link{font-size:16px;font-weight:300;
  margin-top:12px} .login-container .signup-option{margin:24px 0} .login-container .no-account-text{font-weight:400}
  .login-container .signup-link{margin-left:6px} .login-container .play-as-guest,.play-as-guest-divider{margin:12px 0}
  So the page is a NARROW 400px centred column on white: a centred header, two stacked fields, a green submit, a
  plain "Forgot Password or Username" link, then the sign-up line. That is the whole page. This replaced a blurred photo
  hero with a gradient card and 16px radii, which was far more modernized than anything Roblox shipped in 2021. Expects:
  title, errorMessage, hintMessage, redirect, username, csrfToken. %>

  <body class="auth-page<%= (typeof themeOn !== 'undefined' && themeOn) ? ' dark-theme' : '' %>">

    <div class="auth-container">

      <div class="auth-header">
        <a href="/" aria-label="LuckyBlox home">
          <img class="auth-logo" src="/site-icon/luckyblox.png" alt="LuckyBlox" />
        </a>
        <h1 class="auth-title">Sign In</h1>
      </div>

      <% if (errorMessage) { %>
        <div class="auth-error" role="alert">
          <%= errorMessage %>
        </div>
        <% } %>
          <% if (hintMessage) { %>
            <div class="auth-success" role="status">
              <%= hintMessage %>
            </div>
            <% } %>

              <form method="POST" action="/signin" id="signinForm" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken || '' %>" />
                <% if (redirect) { %>
                  <input type="hidden" name="redirect" value="<%= redirect %>" />
                  <% } %>

                    <div class="auth-field">
                      <label class="auth-label" for="username">Username</label>
                      <input class="auth-input" id="username" name="username" type="text" value="<%= username || '' %>"
                        autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="20" required />
                    </div>

                    <div class="auth-field auth-field--last">
                      <label class="auth-label" for="password">Password</label>
                      <input class="auth-input" id="password" name="password" type="password"
                        autocomplete="current-password" required />
                    </div>

                    <button class="auth-submit" type="submit" id="signinSubmit">Sign In</button>

                    <a class="auth-forgot" href="/signin?reset=1">Forgot Password or Username?</a>
              </form>

              <div class="auth-signup-option">
                <span class="no-account-text">Don't have an account?</span>
                <a class="auth-signup-link"
                  href="/signup<%= redirect ? ('?redirect=' + encodeURIComponent(redirect)) : '' %>">Sign Up</a>
              </div>

              <div class="auth-divider">
                <span class="auth-divider-text">or</span>
              </div>

              <div class="auth-guest">
                Play without an account.
                <a class="auth-guest-button" href="/games">Browse as guest</a>
              </div>

    </div>

    <script>
      // Client-side pre-check only. The server re-validates everything; this just
      // avoids a round trip for an obviously empty field and gives the inline red
      // border the real form used.
      (function () {
        var form = document.getElementById('signinForm');
        var btn = document.getElementById('signinSubmit');
        if (!form) return;

        form.addEventListener('submit', function () {
          var u = document.getElementById('username');
          var p = document.getElementById('password');
          var valid = true;

          if (!u.value.trim()) { u.classList.add('input-error'); valid = false; }
          else { u.classList.remove('input-error'); }

          if (!p.value) { p.classList.add('input-error'); valid = false; }
          else { p.classList.remove('input-error'); }

          if (!valid) return false;

          btn.disabled = true;
          btn.textContent = 'Signing In...';
          return true;
        });
      }());
    </script>

    <%- include('partials/scripts') %>
  </body>

</html>
