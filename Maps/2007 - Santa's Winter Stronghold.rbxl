		<Item class="Script">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">ChristmasInsurrection</string>
				<string name="Source">print(&quot;Christmas Insurrection v. 1.00&quot;)&#13;&#10;&#13;&#10;&#13;&#10;-- If you need lua help, check out http://lua-users.org/wiki/&#13;&#10;-- and also see the Roblox Wiki &quot;Scripting&quot; entry&#13;&#10;&#13;&#10;&#13;&#10;-- You can tweak the things below to change how the game plays&#13;&#10;&#13;&#10;--------------------- GAME VARIABLES ------------------------&#13;&#10;local game_length = 60 * 8 -- this is total game time in seconds.&#13;&#10;--------------------------------------------------------------------&#13;&#10;&#13;&#10;local STARTING = 0&#13;&#10;local GOING = 1&#13;&#10;local ENDED = 2&#13;&#10;local state = STARTING&#13;&#10;&#13;&#10;local WaitingPosition = Vector3.new(235, 10.2, 235) -- position players spawn at before the game starts&#13;&#10;local SantaSpawn = Vector3.new(-171, 227, -189) -- position that santa spawns at&#13;&#10;local ElfSpawn = Vector3.new(-188, 103, 198) -- position that elves spawn&#13;&#10;&#13;&#10;-- Setup some things here&#13;&#10;local seed = tick()&#13;&#10;math.randomseed(seed) --- init random number generator&#13;&#10;print(&quot;Seed &quot;, seed)&#13;&#10;&#13;&#10;local connection = nil&#13;&#10;local num_gifts = 0&#13;&#10;local regen = game.Workspace.RegenGroup:clone()&#13;&#10;&#13;&#10;message = nil&#13;&#10;function showMessage(text)&#13;&#10;&#9;-- This function flashes a message to all players&#13;&#10;&#9;-- Clear the message with hideMessage()&#13;&#10;&#13;&#10;&#9;hideMessage() -- Never show more than one message at a time&#13;&#10;&#9;if message == nil then message = Instance.new(&quot;Message&quot;) end -- only make a message if we don&apos;t have a message object lying around&#13;&#10;&#9;message.Text = text&#13;&#10;&#9;message.Parent = game.Workspace&#13;&#10;end&#13;&#10;&#13;&#10;function hideMessage()&#13;&#10;&#9;if message == nil then return end&#13;&#10;&#9;message.Parent = nil&#13;&#10;end&#13;&#10;&#13;&#10;function ShowMessageToPlayer(player, text)&#13;&#10;&#9;RemovePlayerMessages(player)&#13;&#10;&#9;local msg = Instance.new(&quot;Message&quot;)&#13;&#10;&#9;msg.Text = text&#13;&#10;&#9;msg.Parent = player&#13;&#10;end&#13;&#10;&#13;&#10;function RemovePlayerMessages(player)&#13;&#10;&#9;local c = player:children()&#13;&#10;&#9;for i = 1, #c do&#13;&#10;&#9;&#9;if c[i].className == &quot;Message&quot; then c[i].Parent = nil end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;-- go through the level and do a recursive search for models named &quot;Present&quot;.&#13;&#10;-- for each of those, make the box a random color and attach the GiftScript&#13;&#10;function findPresents(instance)&#13;&#10;&#9;local kids = instance:children()&#13;&#10;&#9;for i = 1, #kids do&#13;&#10;&#9;&#9;if kids[i].className == &quot;Model&quot; and kids[i].Name == &quot;Present&quot; then&#13;&#10;&#9;&#9;&#9;kids[i].Box.BrickColor = BrickColor.random()&#13;&#10;&#9;&#9;&#9;local s = game.Workspace.GiftScript:clone()&#13;&#10;&#9;&#9;&#9;s.Disabled = false&#13;&#10;&#9;&#9;&#9;s.Parent = kids[i].Box&#9;&#13;&#10;&#9;&#9;&#9;num_gifts = num_gifts + 1&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;-- depth-first search&#13;&#10;&#9;&#9;findPresents(kids[i])&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function clearPlayerInfo()&#13;&#10;&#9;-- resets gift and points&#13;&#10;&#9;-- the Whaleboard adds these tags, we just look for them here and reset them&#13;&#10;&#9;local players = game.Players:children()&#13;&#10;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;if (players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil) and (players[i].leaderstats.Gifts ~= nil) then players[i].leaderstats.Gifts.Value = 0 end&#13;&#10;&#9;&#9;if (players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil) and (players[i].leaderstats.Points ~= nil) then players[i].leaderstats.Points.Value = 0 end&#13;&#10;&#9;end&#9;&#13;&#10;end&#13;&#10;&#13;&#10;function getWinnerInfo()&#13;&#10;&#9;-- returns a string that we display to everyone about who the winner is&#13;&#10;&#13;&#10;&#9;-- in case of tie, no one wins. if someone wants to code something better, be my guest.&#13;&#10;&#9;local highscore = 0&#13;&#10;&#9;local winner = &quot;No one&quot;&#13;&#10;&#9;local tie = false&#13;&#10;&#13;&#10;&#9;local players = game.Players:children()&#13;&#10;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;local pscore = -1&#13;&#10;&#9;&#9;if players[i]:findFirstChild(&quot;leaderstats&quot;) ~= nil then &#13;&#10;&#9;&#9;&#9;if players[i].leaderstats.Points ~= nil then &#13;&#10;&#9;&#9;&#9;&#9;pscore = players[i].leaderstats.Points.Value &#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if pscore == highscore then&#13;&#10;&#9;&#9;&#9;tie = true&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if pscore &gt; highscore then &#13;&#10;&#9;&#9;&#9;-- new highscore&#13;&#10;&#9;&#9;&#9;highscore = pscore&#13;&#10;&#9;&#9;&#9;winner = players[i].Name&#13;&#10;&#9;&#9;&#9;tie = false&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;&#9;&#13;&#10;&#9;if tie == true then return &quot;There was a tie. How boring.&quot; end&#13;&#10;&#9;&#13;&#10;&#9;local text = string.format(&quot;%s %s %d %s&quot;, winner, &quot;wins with&quot;, highscore, &quot;points!&quot;)&#13;&#10;&#9;return text&#13;&#10;end&#13;&#10;&#13;&#10;function RemoveAllWeapons(player)&#13;&#10;&#9;&#9;-- wipe all weapons&#13;&#10;&#9;if player:findFirstChild(&quot;PlayerHopper&quot;) == nil then return end&#13;&#10;&#13;&#10;&#9;local weapons = player.PlayerHopper:children()&#13;&#10;&#9;for i = 1, #weapons do&#13;&#10;&#9;&#9;weapons[i].Parent = nil&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function GiveWeapons(player)&#13;&#10;&#9;local role = getRole(player)&#13;&#10;&#9;-- give common weapons&#13;&#10;&#9;game.Hopper.Wall:clone().Parent = player.PlayerHopper&#13;&#10;&#9;game.Hopper.Snowball:clone().Parent = player.PlayerHopper&#13;&#10;&#9;game.Hopper.TimeBomb:clone().Parent = player.PlayerHopper&#13;&#10;&#9;game.Hopper.Slingshot:clone().Parent = player.PlayerHopper&#13;&#10;&#13;&#10;&#9;if role == &quot;Elf&quot; then&#13;&#10;&#9;&#9;-- give Elf weapons&#13;&#10;&#9;&#9;game.Hopper.Rocket:clone().Parent = player.PlayerHopper&#13;&#10;&#9;else&#13;&#10;&#9;&#9;-- give Santa weapons&#13;&#10;&#9;&#9;game.Hopper.Multirocket:clone().Parent = player.PlayerHopper&#13;&#10;&#9;&#9;game.Hopper.JetBoots:clone().Parent = player.PlayerHopper&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function AssignRole(player, role)&#13;&#10;&#9;-- role is a string: either &quot;Elf&quot; or &quot;Santa&quot;&#13;&#10;&#9;if player == nil then return end&#13;&#10;&#13;&#10;&#9;-- delete role tag if we see one&#13;&#10;&#9;local role_tag = player:findFirstChild(&quot;Role&quot;)&#13;&#10;&#9;if role_tag ~= nil then role_tag.Parent = nil end&#13;&#10;&#13;&#10;&#9;role_tag = Instance.new(&quot;StringValue&quot;)&#13;&#10;&#9;role_tag.Name = &quot;Role&quot;&#13;&#10;&#9;role_tag.Value = role&#13;&#10;&#9;role_tag.Parent = player&#13;&#10;&#13;&#10;&#9;RemoveAllWeapons(player)&#13;&#10;&#13;&#10;&#13;&#10;&#9;print(&quot;Assigned role: &quot;, role)&#13;&#10;end&#13;&#10;&#13;&#10;function getRole(player)&#13;&#10;&#9;if player:findFirstChild(&quot;Role&quot;) ~= nil then&#13;&#10;&#9;&#9;return player.Role.Value&#13;&#10;&#9;end&#13;&#10;&#9;return nil&#13;&#10;end&#13;&#10;&#13;&#10;function getSantaPlayer()&#13;&#10;&#9;-- returns the player that is santa or nil if there is no santa&#13;&#10;&#9;local players = game.Players:children()&#13;&#10;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;if getRole(players[i]) == &quot;Santa&quot; then return players[i] end&#13;&#10;&#9;end&#13;&#10;&#9;return nil&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function PickPlayerToBeSanta()&#13;&#10;&#9;if game.Players.numPlayers == 0 then return nil end&#13;&#10;&#13;&#10;&#9;local players = game.Players:children()&#13;&#10;&#9;return players[math.random(1, #players)]&#13;&#10;end&#13;&#10;&#13;&#10;function KillPlayer(player)&#13;&#10;&#9;-- safe way to kill a player&#13;&#10;&#9;local done = false&#13;&#10;&#9;while done == false do&#13;&#10;&#9;&#9;local char = player.Character&#13;&#10;&#9;&#9;if char ~= nil then &#13;&#10;&#9;&#9;&#9;local humanoid = char:findFirstChild(&quot;Humanoid&quot;)&#13;&#10;&#9;&#9;&#9;if humanoid ~= nil then &#13;&#10;&#9;&#9;&#9;&#9;humanoid.Health = 0&#13;&#10;&#9;&#9;&#9;&#9;done = true&#13;&#10;&#9;&#9;&#9;&#9;print(&quot;found humanoid&quot;)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;&#9;wait(2) -- do not hog cpu&#13;&#10;&#9;end&#13;&#10;&#9;&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function PlayGame()&#13;&#10;&#9;-- this game plays on a loop until the level is killed&#13;&#10;&#13;&#10;&#9;local time_left = 0&#13;&#10;&#9;local start_time = 0&#13;&#10;&#9;local next_warning_time = 0&#13;&#10;&#13;&#10;&#9;while true do&#13;&#10;&#9;&#9;-- this game can be in one of 3 states&#13;&#10;&#9;&#9;if state == STARTING then&#13;&#10;&#9;&#9;&#9;-- When the game is starting, we want to spawn a couple of whales, so things&#13;&#10;&#9;&#9;&#9;-- are going to be laggy. To hide this setup lag, I show some start up info&#13;&#10;&#9;&#9;&#9;showMessage(&quot;Welcome to Christmas Insurrection version 1.00&quot;)&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;&#9;hideMessage()&#13;&#10;&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- Reset all game stuff&#13;&#10;&#9;&#9;&#9;findPresents(game.Workspace) -- setup present scripts&#13;&#10;&#9;&#9;&#9;time_left = game_length&#13;&#10;&#9;&#9;&#9;clearPlayerInfo()&#13;&#10;&#13;&#10;&#9;&#9;&#9;local players = game.Players:children()&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- set all players to elves&#13;&#10;&#9;&#9;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;&#9;&#9;AssignRole(players[i], &quot;Elf&quot;)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- pick a santa&#13;&#10;&#9;&#9;&#9;local p = PickPlayerToBeSanta()&#13;&#10;&#9;&#9;&#9;AssignRole(p, &quot;Santa&quot;)&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- show role instructions&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;local santa_msgs = {&quot;You are SANTA CLAUSE&quot;, &quot;Your treacherous elves are revolting!&quot;, &quot;They are trying to steal your presents!&quot;, &quot;It&apos;s time to teach them a lesson!&quot;}&#13;&#10;&#9;&#9;&#9;local elf_msgs = { &quot;You are an ELF in Santa&apos;s Workshop&quot;,&quot;You slave away making toys 364 days a year&quot;,&quot;You&apos;ve had ENOUGH!&quot;,&quot;Collect as many presents as you can, but avoid Santa!&quot;}&#13;&#10;&#13;&#10;&#9;&#9;&#9;for n = 1,4 do&#13;&#10;&#9;&#9;&#9;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;&#9;&#9;&#9;if getRole(players[i]) == &quot;Santa&quot; then&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;ShowMessageToPlayer(players[i],santa_msgs[n])&#13;&#10;&#9;&#9;&#9;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#9;ShowMessageToPlayer(players[i],santa_msgs[n])&#13;&#10;&#9;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#13;&#10;&#9;&#9;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;&#9;&#9;RemovePlayerMessages(players[i])&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;&#9;local text = string.format(&quot;%s %d %s&quot;, &quot;This game will last&quot;, game_length / 60, &quot;minutes&quot;)&#13;&#10;&#9;&#9;&#9;showMessage(text)&#13;&#10;&#9;&#9;&#9;wait(3)&#13;&#10;&#9;&#9;&#9;showMessage(&quot;3&quot;)&#13;&#10;&#9;&#9;&#9;wait(1)&#13;&#10;&#9;&#9;&#9;showMessage(&quot;2&quot;)&#13;&#10;&#9;&#9;&#9;wait(1)&#13;&#10;&#9;&#9;&#9;showMessage(&quot;1&quot;)&#13;&#10;&#9;&#9;&#9;wait(1)&#13;&#10;&#9;&#9;&#9;showMessage(&quot;GO&quot;)&#13;&#10;&#9;&#9;&#9;wait(1)&#13;&#10;&#9;&#9;&#9;hideMessage()&#13;&#10;&#13;&#10;&#9;&#9;&#9;start_time = tick() -- record system clock at start time&#13;&#10;&#9;&#9;&#9;next_warning_time = start_time + 60&#13;&#10;&#13;&#10;&#9;&#9;&#9;state = GOING&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- kill all players to make them respawn; give them weapons&#13;&#10;&#9;&#9;&#9;local players = game.Players:children()&#13;&#10;&#9;&#9;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;&#9;&#9;if getRole(players[i]) ~= &quot;Santa&quot; and getRole(players[i]) ~= &quot;Elf&quot; then AssignRole(players[i], &quot;Elf&quot;) end -- this catches the case where someone joined in the last 20 seconds ;-)&#13;&#10;&#9;&#9;&#9;&#9;KillPlayer(players[i])&#13;&#10;&#9;&#9;&#9;&#9;GiveWeapons(players[i])&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if state == GOING then&#13;&#10;&#9;&#9;&#9;-- when the game is going, we look for several things&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- 2. we check to see if it is time to flash a countdown message&#13;&#10;&#9;&#9;&#9;-- 3. we check to see if the game should be over&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- every minute show time left&#13;&#10;&#9;&#9;&#9;if tick() &gt; next_warning_time then&#13;&#10;&#9;&#9;&#9;&#9;local text = string.format(&quot;%d %s&quot;, time_left, &quot;seconds left!&quot;)&#13;&#10;&#9;&#9;&#9;&#9;showMessage(text)&#13;&#10;&#9;&#9;&#9;&#9;wait(4)&#13;&#10;&#9;&#9;&#9;&#9;hideMessage()&#13;&#10;&#9;&#9;&#9;&#9;next_warning_time = tick() + 60&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;if time_left &lt; 0 then&#13;&#10;&#9;&#9;&#9;&#9;state = ENDED&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;&#9;time_left = (start_time + game_length) - tick()&#13;&#10;&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;if state == ENDED then&#13;&#10;&#9;&#9;&#9;-- kill all players to make them respawn; take their weapons&#13;&#10;&#9;&#9;&#9;local players = game.Players:children()&#13;&#10;&#9;&#9;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;&#9;&#9;KillPlayer(players[i])&#13;&#10;&#9;&#9;&#9;&#9;RemoveAllWeapons(players[i])&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;showMessage(&quot;GAME OVER!!!&quot;)&#13;&#10;&#9;&#9;&#9;wait(5)&#13;&#10;&#9;&#9;&#9;showMessage(getWinnerInfo())&#13;&#10;&#9;&#9;&#9;wait(8)&#13;&#10;&#9;&#9;&#9;showMessage(&quot;A new game will begin soon... Regenerating.&quot;)&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;-- regen&#13;&#10;&#9;&#9;&#9;local level = game.Workspace.RegenGroup&#13;&#10;&#9;&#9;&#9;level:remove()&#13;&#10;&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#13;&#10;&#9;&#9;&#9;level = regen:clone()&#13;&#10;&#9;&#9;&#9;level.Parent = game.Workspace&#13;&#10;&#9;&#9;&#9;level:makeJoints()&#13;&#10;&#13;&#10;&#9;&#9;&#9;hideMessage()&#13;&#10;&#13;&#10;&#9;&#9;&#9;wait(2)&#13;&#10;&#13;&#10;&#9;&#9;&#9;state = STARTING&#13;&#10;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;wait(2) -- don&apos;t hog the CPU&#13;&#10;&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;-----------------------------------------------------------------------&#13;&#10;&#13;&#10;&#13;&#10;function onPlayerEntered(newPlayer)&#13;&#10;&#13;&#10;&#9;AssignRole(newPlayer, &quot;Elf&quot;)&#13;&#10;&#9;if state ~= GOING then&#13;&#10;&#9;&#9;RemoveAllWeapons(newPlayer)&#13;&#10;&#9;&#9;--KillPlayer(newPlayer)&#13;&#10;&#9;else&#13;&#10;&#9;&#9;GiveWeapons(newPlayer)&#13;&#10;&#9;end&#13;&#10;&#9;-- start to listen for new humanoid&#13;&#10;&#9;connection = newPlayer.Changed:connect(function(property) onPlayerPropChanged(property, newPlayer) end )&#13;&#10;&#9;onPlayerRespawn(newPlayer)&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;function elfMorph(player)&#13;&#10;&#13;&#10;&#9;print(&quot;MORPH&quot;)&#13;&#10;&#13;&#10;&#9;-- disconnect to avoid infinite loop&#13;&#10;&#9;--if connection ~= nil then connection:disconnect() end&#13;&#10;&#13;&#10;&#9;local char = player.Character&#13;&#10;&#13;&#10;&#9;-- recolor body&#13;&#10;&#9;local head = char:findFirstChild(&quot;Head&quot;)&#13;&#10;&#9;local torso = char:findFirstChild(&quot;Torso&quot;) &#13;&#10;&#9;local left_arm = char:findFirstChild(&quot;Left Arm&quot;) &#13;&#10;&#9;local right_arm = char:findFirstChild(&quot;Right Arm&quot;) &#13;&#10;&#9;local left_leg = char:findFirstChild(&quot;Left Leg&quot;) &#13;&#10;&#9;local right_leg = char:findFirstChild(&quot;Right Leg&quot;) &#13;&#10;&#13;&#10;&#9;if head ~= nil then head.BrickColor = BrickColor.new(24) end&#13;&#10;&#9;if torso ~= nil then torso.BrickColor = BrickColor.new(37) end&#13;&#10;&#9;if left_arm ~= nil then left_arm.BrickColor = BrickColor.new(24) end&#13;&#10;&#9;if right_arm ~= nil then right_arm.BrickColor = BrickColor.new(24) end&#13;&#10;&#9;if left_leg ~= nil then left_leg.BrickColor = BrickColor.new(119) end&#13;&#10;&#9;if right_leg ~= nil then right_leg.BrickColor = BrickColor.new(119) end&#10;&#13;&#10;&#13;&#10;&#9;-- reconnect&#13;&#10;&#9;-- start to listen for new humanoid&#13;&#10;&#9;--connection = player.Changed:connect(function(property) onPlayerPropChanged(property, player) end )&#13;&#10;end&#13;&#10;&#13;&#10;function santaMorph(player)&#13;&#10;&#13;&#10;&#9;print(&quot;MORPH SANTA&quot;)&#13;&#10;&#13;&#10;&#9;-- disconnect to avoid infinite loop&#13;&#10;&#9;--if connection ~= nil then connection:disconnect() end&#13;&#10;&#13;&#10;&#9;local char = player.Character&#13;&#10;&#13;&#10;&#13;&#10;&#9;local head = char:findFirstChild(&quot;Head&quot;)&#13;&#10;&#9;local torso = char:findFirstChild(&quot;Torso&quot;) &#13;&#10;&#9;local left_arm = char:findFirstChild(&quot;Left Arm&quot;) &#13;&#10;&#9;local right_arm = char:findFirstChild(&quot;Right Arm&quot;) &#13;&#10;&#9;local left_leg = char:findFirstChild(&quot;Left Leg&quot;) &#13;&#10;&#9;local right_leg = char:findFirstChild(&quot;Right Leg&quot;) &#13;&#10;&#13;&#10;&#9;if head ~= nil then head.BrickColor = BrickColor.new(24) end&#13;&#10;&#9;if torso ~= nil then torso.BrickColor = BrickColor.new(26) end&#13;&#10;&#9;if left_arm ~= nil then left_arm.BrickColor = BrickColor.new(21) end&#13;&#10;&#9;if right_arm ~= nil then right_arm.BrickColor = BrickColor.new(21) end&#13;&#10;&#9;if left_leg ~= nil then left_leg.BrickColor = BrickColor.new(21) end&#13;&#10;&#9;if right_leg ~= nil then right_leg.BrickColor = BrickColor.new(21) end&#13;&#10;&#13;&#10;&#13;&#10;&#9;-- reconnect&#13;&#10;&#9;-- start to listen for new humanoid&#13;&#10;&#9;--connection = player.Changed:connect(function(property) onPlayerPropChanged(property, player) end )&#13;&#10;end&#13;&#10;&#13;&#10;function onPlayerPropChanged(property, player)&#13;&#10;&#9;if property == &quot;Character&quot; and player.Character ~= nil then&#13;&#10;&#9;&#9;onPlayerRespawn(player)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function onPlayerRespawn(player)&#13;&#10;&#9;&#13;&#10;print(&quot;on RESPAWN&quot;)&#13;&#10;&#9;-- only interested in events where the player gets a new character&#13;&#10;       if player.Character == nil then return end&#13;&#10;&#13;&#10;&#9;if getRole(player) == &quot;Elf&quot; then elfMorph(player) end&#13;&#10;&#9;if getRole(player) == &quot;Santa&quot; then santaMorph(player) end&#13;&#10;&#13;&#10;&#9;local x = 0&#13;&#10;&#9;local y = 0&#13;&#10;&#9;local z = 0&#13;&#10;&#13;&#10;&#9;x = WaitingPosition.x + math.random(-5, 5)&#13;&#10;&#9;y = WaitingPosition.y + math.random(5,8)&#13;&#10;&#9;z = WaitingPosition.z + math.random(-5,5)&#13;&#10;&#9;if getRole(player) == &quot;Santa&quot; and state == GOING then&#13;&#10;&#9;&#9;&#9;x = SantaSpawn.x + math.random(-5, 5)&#13;&#10;&#9;&#9;&#9;y = SantaSpawn.y + math.random(5,8)&#13;&#10;&#9;&#9;&#9;z = SantaSpawn.z + math.random(-5,5)&#13;&#10;&#9;end&#13;&#10;&#9;if getRole(player) == &quot;Elf&quot; and state == GOING then&#13;&#10;&#9;&#9;&#9;x = ElfSpawn.x + math.random(-15, 15)&#13;&#10;&#9;&#9;&#9;y = ElfSpawn.y + math.random(5,20)&#13;&#10;&#9;&#9;&#9;z = ElfSpawn.z + math.random(-15,15)&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;--local char = nil&#13;&#10;&#9;--while true do&#13;&#10;&#9;&#9;local char = player.Character.Torso&#13;&#10;&#9;--&#9;if char ~= nil then break end&#13;&#10;&#9;--&#9;wait(2)&#13;&#10;&#9;--&#9;print(&quot;LLL&quot;)&#13;&#10;&#9;--end&#13;&#10;&#9;local cf = char.CFrame&#13;&#10;&#13;&#10;&#9;local lx = 0&#13;&#10;&#9;local ly = y&#13;&#10;&#9;local lz = 0&#13;&#10;&#13;&#10;&#9;char.CFrame = CFrame.new(Vector3.new(x,y,z), Vector3.new(lx,ly,lz))&#13;&#10;&#9;print(&quot;Moved player&quot;)&#13;&#10;&#13;&#10;&#9;--player.Character:move(Vector3.new(x,y,z))&#13;&#10;&#13;&#10;end&#13;&#10;----------------------------------------------------------------------------------------&#13;&#10;game.Players.ChildAdded:connect(onPlayerEntered)&#13;&#10;&#13;&#10;PlayGame()&#13;&#10;&#13;&#10;&#13;&#10;</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Script">
			<Properties>
				<bool name="Disabled">true</bool>
				<string name="Name">GiftScript</string>
				<string name="Source">&#13;&#10;&#13;&#10;function getPlayer(humanoid)&#13;&#10;&#9;-- find the owning player of a humanoid. this is a hack and i don&apos;t know why i need it, game.Players.LocalPlayer didn&apos;t work&#13;&#10;&#9;local players = game.Players:children()&#13;&#10;&#9;for i = 1, #players do&#13;&#10;&#9;&#9;if players[i].Character.Humanoid == humanoid then return players[i] end&#13;&#10;&#9;end&#13;&#10;&#9;return nil&#13;&#10;end&#13;&#10;&#13;&#10;function getRole(player)&#13;&#10;&#9;if player:findFirstChild(&quot;Role&quot;) ~= nil then&#13;&#10;&#9;&#9;return player.Role.Value&#13;&#10;&#9;end&#13;&#10;&#9;return nil&#13;&#10;end&#13;&#10;&#13;&#10;function addGift(humanoid)&#13;&#10;&#13;&#10;&#13;&#10;&#9;local player = getPlayer(humanoid)&#13;&#10;&#13;&#10;&#9;-- Touching only happens client-side&#13;&#10;&#9;if player == nil then return end&#13;&#10;&#13;&#10;&#9;&#13;&#10;&#13;&#10;&#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;if stats == nil then return end&#13;&#10;&#13;&#10;&#9;local gifts_tag = stats:findFirstChild(&quot;Gifts&quot;)&#13;&#10;&#9;local points_tag = stats:findFirstChild(&quot;Points&quot;)&#13;&#10;&#13;&#10;&#9;if gifts_tag ~= nil then gifts_tag.Value = gifts_tag.Value + 1 end&#13;&#10;&#13;&#10;&#9;if points_tag ~= nil then points_tag.Value = points_tag.Value + 1 end&#13;&#10;&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;function onTouched(part)&#13;&#10;&#9;local parent = part.Parent&#13;&#10;&#9;if parent~=nil then&#13;&#10;&#9;&#9;local humanoid = parent:findFirstChild(&quot;Humanoid&quot;, false)&#13;&#10;&#9;&#9;if humanoid ~= nil then&#13;&#10;&#9;&#9;&#9;local p = getPlayer(humanoid)&#13;&#10;&#9;&#9;&#9;if p ~= nil and getRole(p) == &quot;Elf&quot; then&#13;&#10;&#9;&#9;&#9;&#9;addGift(humanoid)&#13;&#10;&#9;&#9;&#9;&#9;script.Parent.Parent.Parent = nil&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;script.Parent.Touched:connect(onTouched)&#13;&#10;</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
