		<Item class="Script">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">ChristmasBoard</string>
				<string name="Source">print(&quot;Leaderboard script version 2.00 loaded&quot;)&#13;&#10;&#13;&#10;&#13;&#10;function onPlayerEntered(newPlayer)&#13;&#10;&#13;&#10;&#13;&#10;&#9;local stats = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;stats.Name = &quot;leaderstats&quot;&#13;&#10;&#13;&#10;&#9;local gifts = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;gifts.Name = &quot;Gifts&quot;&#13;&#10;&#9;gifts.Value = 0&#13;&#10;&#13;&#10;&#9;local points = Instance.new(&quot;IntValue&quot;)&#13;&#10;&#9;points.Name = &quot;Points&quot;&#13;&#10;&#9;points.Value = 0&#13;&#10;&#13;&#10;&#9;gifts.Parent = stats&#13;&#10;&#9;points.Parent = stats&#13;&#10;&#13;&#10;&#9;-- VERY UGLY HACK&#13;&#10;&#9;-- Will this leak threads?&#13;&#10;&#9;-- Is the problem even what I think it is (player arrived before character)?&#13;&#10;&#9;while true do&#13;&#10;&#9;&#9;if newPlayer.Character ~= nil then break end&#13;&#10;&#9;&#9;wait(5)&#13;&#10;&#9;end&#13;&#10;&#13;&#10;&#9;local humanoid = newPlayer.Character.Humanoid&#13;&#10;&#13;&#10;&#9;humanoid.Died:connect(function() onHumanoidDied(humanoid, newPlayer) end )&#13;&#10;&#13;&#10;&#9;-- start to listen for new humanoid&#13;&#10;&#9;newPlayer.Changed:connect(function(property) onPlayerRespawn(property, newPlayer) end )&#13;&#10;&#13;&#10;&#13;&#10;&#9;stats.Parent = newPlayer&#13;&#10;&#13;&#10;end&#13;&#10;&#13;&#10;function onHumanoidDied(humanoid, player)&#13;&#10;&#9;local stats = player:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;if stats ~= nil then&#13;&#10;&#9;&#9;--local deaths = stats:findFirstChild(&quot;Deaths&quot;)&#13;&#10;&#9;&#9;--deaths.Value = deaths.Value + 1&#13;&#10;&#9;&#9;handleKillCount(humanoid, player)&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function onPlayerRespawn(property, player)&#13;&#10;&#9;-- need to connect to new humanoid&#13;&#10;&#9;&#13;&#10;&#9;if property == &quot;Character&quot; and player.Character ~= nil then&#13;&#10;&#9;&#9;local humanoid = player.Character.Humanoid&#13;&#10;&#9;&#9;&#9;local p = player&#13;&#10;&#9;&#9;&#9;local h = humanoid&#13;&#10;&#9;&#9;&#9;humanoid.Died:connect(function() onHumanoidDied(h, p) end )&#13;&#10;&#9;end&#13;&#10;end&#13;&#10;&#13;&#10;function getRole(player)&#13;&#10;&#9;if player:findFirstChild(&quot;Role&quot;) ~= nil then&#13;&#10;&#9;&#9;return player.Role.Value&#13;&#10;&#9;end&#13;&#10;&#9;return nil&#13;&#10;end&#13;&#10;&#13;&#10;function handleKillCount(humanoid, player)&#13;&#10;&#9;-- todo, killing self results in negative points.&#13;&#10;&#9;&#13;&#10;&#9;-- check for kill tag on humanoid - may be more than one - todo: deal with this&#13;&#10;&#9;local tag = humanoid:findFirstChild(&quot;creator&quot;)&#13;&#10;&#13;&#10;&#9;-- find player with name on tag&#13;&#10;&#9;if tag ~= nil then&#13;&#10;&#9;&#9;&#13;&#10;&#9;&#9;local killer = tag.Value&#13;&#10;&#9;&#9;if killer.Parent ~= nil then&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#13;&#10;&#9;&#9;&#9;-- test if killer still in game, maybe not a big deal&#13;&#10;&#9;&#9;&#9;local stats = killer:findFirstChild(&quot;leaderstats&quot;)&#13;&#10;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;if stats ~= nil and getRole(killer) == &quot;Santa&quot;  then&#13;&#10;&#9;&#9;&#9;&#9;local points = stats:findFirstChild(&quot;Points&quot;) -- Santa gets 1 pt for wasting an elf&#13;&#10;&#9;&#9;&#9;&#9;if killer ~= player then&#13;&#10;&#9;&#9;&#9;&#9;&#9;stats.Points.Value = stats.Points.Value + 1&#13;&#10;&#9;&#9;&#9;&#9;else&#13;&#10;&#9;&#9;&#9;&#9;&#9;stats.Points.Value = stats.Points.Value - 5 -- santa loses 5 pts for killing himself (idiot)&#13;&#10;&#9;&#9;&#9;&#9;&#9;&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#13;&#10;&#9;&#9;&#9;if stats ~= nil and getRole(killer) == &quot;Elf&quot;  then&#13;&#10;&#9;&#9;&#9;&#9;local points = stats:findFirstChild(&quot;Points&quot;) -- Santa gets 1 pt for wasting an elf&#13;&#10;&#9;&#9;&#9;&#9;if killer ~= player then&#13;&#10;&#9;&#9;&#9;&#9;&#9;stats.Points.Value = stats.Points.Value + 3 -- elves get 3 pts for wasting santa&#13;&#10;&#9;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;&#9;end&#13;&#10;&#9;&#9;end&#13;&#10;&#9;end &#13;&#10;&#9;&#13;&#10;end&#13;&#10;&#13;&#10;game.Players.ChildAdded:connect(onPlayerEntered)</string>
				<bool name="archivable">true</bool>
			</Properties>
		</Item>
		<Item class="Model">
			<Properties>
				<token name="Controller">0</token>
				<bool name="ControllerFlagShown">true</bool>
				<CoordinateFrame name="ModelInPrimary">
					<X>0</X>
					<Y>0</Y>
					<Z>0</Z>
