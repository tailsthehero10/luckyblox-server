					<Content name="LinkedSource"><null></null></Content>
					<string name="Name">Script</string>
					<ProtectedString name="Source">local state = false 

function act() 
state = not state 
if state then 
&#9;local h = Instance.new(&quot;Message&quot;)
&#9;h.Parent = game.Workspace
&#9;h.Text = &quot;Intruder Alert!&quot;
&#9;wait(1)
&#9;h.Text = &quot;I Repeat!&quot;
&#9;wait(1)
&#9;h.Text = &quot;Intruder Alert!&quot;
&#9;wait(1)
&#9;h:Remove() --Remove this part if you want the message to stay on your screen. It&apos;s recommended you don&apos;t delete this part
end 
end 

script.Parent.ClickDetector.MouseClick:connect(act) 

--Created by Bob</ProtectedString>
