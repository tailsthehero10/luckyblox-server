							<string name="Name">Script</string>
							<ProtectedString name="Source">door = script.Parent.Parent.Door
function onClicked()
if door.open.Value == false then
door.open.Value = true
door.CFrame = CFrame.new(door.Position + Vector3.new(0,0,0.1))
wait(0.01)
