					<Item class="LocalScript" referent="RBX5144">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Local Gui</string>
							<ProtectedString name="Source">drinksleft = 3
Bin = script.Parent


function onButton1Down(mouse)
if Bin.Drink.Transparency == 1 then 
m = Instance.new(&quot;Hint&quot;) 
m.Text = &quot;Your cup is empty!&quot;
m.Parent = Bin.Parent
wait(1)
m:remove()
return end
Bin.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 2
wait()
Bin.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 2
wait()
Bin.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 2
wait()
Bin.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 2
wait()
Bin.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 2
wait()
Bin.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 2
wait()
Bin.Parent.Torso:findFirstChild(&quot;Right Shoulder&quot;).DesiredAngle = 2
wait()
drinksleft = drinksleft - 1
if drinksleft == 0 then
Bin.Drink.Transparency = 1
Bin.Drink.Reflectance = 0
drinksleft = 3
Bin.Name = &quot;[empty]&quot;
end
end

function onSelected(mouse)
&#9;mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end
Bin.Equipped:connect(onSelected)

</ProtectedString>
						</Properties>
					</Item>
					<Item class="Script" referent="RBX5145">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">WeldScript</string>
							<ProtectedString name="Source">local w2 = Instance.new(&quot;Weld&quot;)
w2.Parent = script.Parent.Handle
w2.Part0 = script.Parent.Handle
w2.Part1 = script.Parent.Drink
w2.C1 = CFrame.fromEulerAnglesXYZ(0, 0, 0) * CFrame.new(0, -0.7, 0)</ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="Script" referent="RBX5146">
					<Properties>
						<bool name="Disabled">false</bool>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">PresentScript</string>
						<ProtectedString name="Source">local debounce = false

function getPlayer(humanoid) 
local players = game.Players:children() 
for i = 1, #players do 
if players[i].Character.Humanoid == humanoid then return players[i] end 
end 
return nil 
end 

function onTouch(part) 

local human = part.Parent:findFirstChild(&quot;Humanoid&quot;) 
if (human ~= nil) and debounce == false then

debounce = true

local player = getPlayer(human) 

if (player == nil) then return end 
tool = script.Parent:findFirstChild(&quot;[empty]&quot;)
tool:clone().Parent = player.Backpack

wait(5)
debounce = false
end
end


script.Parent.Touched:connect(onTouch) 
</ProtectedString>
					</Properties>
				</Item>
