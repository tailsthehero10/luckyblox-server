					<Item class="Script" referent="RBX5243">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">Script</string>
							<ProtectedString name="Source">function onTouch(hit)
if hit.Parent.className == &quot;Tool&quot; and hit.Parent.Drink ~= nil then
if hit.Parent.Drink.Transparency == 1 then
script.Parent.Transparency = 0
hit.Parent.Name = script.Parent.Name
hit.Parent.Drink.Transparency = 0
hit.Parent.Drink.BrickColor = script.Parent.BrickColor
wait(0.5)
script.Parent.Transparency = 1
else
wait(0.5)
h = Instance.new(&quot;Hint&quot;)
h.Text = &quot;Your cup is full!&quot;
h.Parent = hit.Parent.Parent
wait(1.5)
h:remove()
end
end
end

script.Parent.Touched:connect(onTouch)
</ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
