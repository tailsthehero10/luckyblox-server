human.Sit = false
end end end end end
 
if string.sub(msg,1,5) == &quot;jail/&quot; then
local player = findplayer(string.sub(msg,6),speaker)
if player ~= 0 then
for i = 1,#player do
if player[i].Character ~= nil then
local torso = player[i].Character:FindFirstChild(&quot;Torso&quot;)
if torso ~= nil then
