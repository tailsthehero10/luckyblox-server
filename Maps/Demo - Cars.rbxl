end end end end end
 
if string.sub(msg,1,11) == &quot;unsparkles/&quot; then
local player = findplayer(string.sub(msg,12),speaker)
if player ~= 0 then
for i = 1,#player do
if player[i].Character ~= nil then
local torso = player[i].Character:FindFirstChild(&quot;Torso&quot;)
if torso ~= nil then
