		<Item class="Script">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">RegenerateFlyParts</string>
				<string name="Source">&#13;&#10;model = game.Workspace.FlyParts&#13;&#10;messageText = &quot;Regenerating the Secret Parts...&quot;&#13;&#10;&#13;&#10;message = Instance.new(&quot;Message&quot;)&#13;&#10;message.Text = messageText&#13;&#10;backup = model:clone()&#13;&#10;&#13;&#10;while true do&#13;&#10;&#9;wait( 1000 *(1 - math.random()*0.5))&#13;&#10;&#13;&#10;&#9;message.Parent = game.Workspace&#13;&#10;&#9;model:remove()&#13;&#10;&#13;&#10;&#9;wait(4)&#13;&#10;&#13;&#10;&#9;model = backup:clone()&#13;&#10;&#9;model.Parent = game.Workspace&#13;&#10;&#9;model:makeJoints()&#13;&#10;&#9;message.Parent = nil&#13;&#10;end&#13;&#10;</string>
			</Properties>
		</Item>
